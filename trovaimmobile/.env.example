# Segreto per firmare i cookie di sessione e i link di riconferma (obbligatorio in produzione)
AUTH_SECRET=cambia-questo-con-una-stringa-lunga-e-casuale

# URL pubblico dell'app (usato nei link delle email e del feed iCal)
APP_URL=http://localhost:3000

# Percorso del database SQLite (default: .data/trovaimmobile.db)
# DATABASE_PATH=.data/trovaimmobile.db

# Geocoding: "nominatim" (default, OpenStreetMap) oppure "mock" (offline, solo sviluppo/test)
GEOCODER=nominatim
# Identificativo richiesto dalla policy di Nominatim: usa un contatto reale
NOMINATIM_USER_AGENT=TrovaImmobile/0.1 (contatto@example.it)
# NOMINATIM_URL=https://nominatim.openstreetmap.org

# Storage immagini: "local" (default, cartella .data/uploads) oppure "s3"
STORAGE_DRIVER=local
# S3_BUCKET=
# S3_REGION=eu-south-1
# S3_ENDPOINT=            # per provider S3-compatibili (MinIO, R2, Scaleway...)
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_PUBLIC_BASE_URL=     # base URL pubblica da cui servire le immagini

# Promemoria: segreto per chiamare /api/cron/reminders (es. da uno scheduler)
CRON_SECRET=cambia-anche-questo
