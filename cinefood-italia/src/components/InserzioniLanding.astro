---
/** Pagina "Inserzioni" per i ristoratori. Una sola implementazione per IT ed EN. */
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import { SITE } from "../config/site";
import { path, type Lang } from "../i18n/ui";

interface Props { lang?: Lang }
const { lang = "it" } = Astro.props;
const en = lang === "en";

// Numeri reali, calcolati dai contenuti (nessuna cifra scritta a mano, nessuna stima di visite).
const locali = await getCollection("restaurants");
const blog = (await getCollection("blog")).filter((b) => !b.data.bozza && (en ? b.data.lang === "en" : b.data.lang !== "en"));
const nLocali = locali.length;
const nCitta = new Set(locali.map((l) => l.data.citta)).size;
const nRegioni = new Set(locali.map((l) => l.data.regione)).size;
const nFilm = new Set(locali.flatMap((l) => l.data.film.map((f) => f.film.id))).size;
const nArticoli = blog.length;

const mail = (subject: string, body: string) =>
  `mailto:${SITE.email}?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(body)}`;

const t = en
  ? {
      title: "Advertising for venues",
      description: `Feature your venue on ${SITE.name}: free listing, featured spot and partner plans for restaurants, bars and cafés linked to Italian films and TV series.`,
      badge: "For restaurant, bar and café owners",
      h1: "Make your venue shine",
      lead: `${SITE.name} is the guide to Italian venues seen in films and TV series. If yours is one of them, or is tied to a film, here is how to put it in the spotlight for the people who search for exactly this.`,
      cta: "Request information",
      ctaSub: "We reply by email. No obligation.",
      stats: [[nLocali, "venues listed"], [nCitta, "cities"], [nFilm, "films and series"], [nArticoli, "articles on the blog"]],
      whyH: "Why list your venue here",
      why: [
        ["People who are already looking", "Our readers search for where a scene was shot and where to eat like in a film. They arrive with an intent to travel and eat."],
        ["Italian and English", "Every venue page, film page and article is available in both languages, so you also reach visitors planning a trip from abroad."],
        ["A page that tells your story", "Your listing links your venue to the film or series, with the scene, address, price range, map and website."],
        ["Trust, not noise", "We only publish links to films backed by a verifiable source, and we say clearly whether a venue was filmed there or only tied to the film."],
      ],
      plansH: "Plans",
      plansLead: "Start free. Pay only if you want more visibility.",
      plans: [
        { nome: "Basic", prezzo: "Free", tag: "", ideal: "To be on the guide", voci: ["Venue page in the directory", "Photo and description", "Link to the film or series and the scene", "Presence on the map and in the lists by city and type", "Address, price range, website"], subj: "Basic listing" },
        { nome: "Featured", prezzo: "On request", tag: "Most requested", ideal: "To stand out", voci: ["Everything in Basic", "“Featured” badge", "Priority position on the homepage", "Direct booking link on your page", "Highlighted in lists and on the map"], subj: "Featured" },
        { nome: "Partner", prezzo: "On request", tag: "", ideal: "To tell your story", voci: ["Everything in Featured", "Dedicated article on the blog", "Sharing on our social channels", "Periodic visit report for your page"], subj: "Partner" },
      ],
      whereH: "Where your venue appears",
      where: ["Your venue page, with photo, scene and map", "The page of the film or series it is linked to", "City and venue-type pages", "The interactive map of venues", "Our search and the PDF guide (where included)", "Blog articles on the film or the area"],
      howH: "How it works",
      how: [
        ["Write to us", "Tell us your venue and the film or series you are linked to."],
        ["We check", "We look for a reliable source for the link. If it is not verifiable we say so, and we do not publish it."],
        ["Your page goes online", "We publish the page in Italian and English, with the right label: real set or tied to the film."],
        ["Choose more visibility", "If you want, we add the Featured or Partner plan."],
      ],
      transH: "Transparency",
      trans: "Sponsored placements are always labelled as such. A plan never changes how we verify the link between a venue and a film: a venue without a verifiable source is not published, whatever the plan.",
      faqH: "Frequently asked questions",
      faq: [
        ["How much does it cost?", "The Basic listing is free. Featured and Partner are on request: write to us and we quote based on what you need."],
        ["Does my venue have to appear in a film?", "It has to be linked to one. If it was really filmed there, it is a “real set”. If it is near the set or tied to the phenomenon the film portrays, it is “tied to the film” and we say so clearly."],
        ["Can I update my details?", "Yes. Write to us for changes to hours, website, booking link or photos, and we update the page."],
        ["Is the film link guaranteed?", "No. We publish a link only when we find a reliable source, and the page shows the date of the last check."],
        ["How do I get started?", "Click “Request information”: your email app opens with a ready message. Add your venue, city and film."],
      ],
      endH: "Ready to be seen?",
      endP: "Write to us: we reply by email with the details and the next steps.",
      addH: "Is your venue not in the guide yet?",
      add: "Suggest it with the form",
      note: "Plans and conditions on request. Sponsored placements are labelled as such.",
      bodyIntro: "Hello, I would like more information about",
      bodyFields: "Venue name:\nCity:\nFilm or series it is linked to:\nPhone (optional):\n",
      subjectBase: "Advertising request",
    }
  : {
      title: "Inserzioni per i locali",
      description: `Metti in evidenza il tuo locale su ${SITE.name}: scheda gratuita, evidenza e piani partner per ristoranti, bar e caffè legati a film e serie TV italiani.`,
      badge: "Per ristoratori, baristi e gestori di caffè",
      h1: "Fai brillare il tuo locale",
      lead: `${SITE.name} è la guida ai locali italiani visti nei film e nelle serie TV. Se il tuo è uno di questi, o è legato a un film, ecco come metterlo in luce davanti a chi cerca proprio questo.`,
      cta: "Richiedi informazioni",
      ctaSub: "Rispondiamo via email. Nessun impegno.",
      stats: [[nLocali, "locali in guida"], [nCitta, "città"], [nFilm, "film e serie"], [nArticoli, "articoli sul blog"]],
      whyH: "Perché essere qui",
      why: [
        ["Persone che stanno già cercando", "I nostri lettori cercano dove è stata girata una scena e dove mangiare come nei film. Arrivano con l'intenzione di viaggiare e mangiare."],
        ["Italiano e inglese", "Ogni scheda locale, pagina film e articolo è disponibile in entrambe le lingue: raggiungi anche chi organizza un viaggio dall'estero."],
        ["Una pagina che racconta la tua storia", "La tua scheda collega il locale al film o alla serie, con scena, indirizzo, fascia di prezzo, mappa e sito."],
        ["Fiducia, non rumore", "Pubblichiamo solo legami con i film supportati da una fonte verificabile e diciamo chiaramente se il locale è stato girato lì o è solo legato al film."],
      ],
      plansH: "I piani",
      plansLead: "Parti gratis. Paghi solo se vuoi più visibilità.",
      plans: [
        { nome: "Base", prezzo: "Gratis", tag: "", ideal: "Per essere in guida", voci: ["Scheda del locale nella directory", "Foto e descrizione", "Collegamento al film o alla serie e alla scena", "Presenza sulla mappa e negli elenchi per città e tipo", "Indirizzo, fascia di prezzo, sito"], subj: "Scheda Base" },
        { nome: "In evidenza", prezzo: "Su richiesta", tag: "Più richiesto", ideal: "Per distinguersi", voci: ["Tutto del piano Base", "Badge “In evidenza”", "Posizione prioritaria in home", "Link diretto alla prenotazione sulla tua pagina", "Risalto negli elenchi e sulla mappa"], subj: "In evidenza" },
        { nome: "Partner", prezzo: "Su richiesta", tag: "", ideal: "Per raccontarsi", voci: ["Tutto del piano In evidenza", "Articolo dedicato sul blog", "Condivisione sui nostri canali social", "Report periodico delle visite alla tua pagina"], subj: "Partner" },
      ],
      whereH: "Dove compare il tuo locale",
      where: ["La scheda del locale, con foto, scena e mappa", "La pagina del film o della serie collegata", "Le pagine per città e per tipo di locale", "La mappa interattiva dei locali", "La ricerca del sito e la guida PDF (dove inclusi)", "Gli articoli del blog sul film o sulla zona"],
      howH: "Come funziona",
      how: [
        ["Scrivici", "Dicci il tuo locale e il film o la serie a cui è legato."],
        ["Verifichiamo", "Cerchiamo una fonte affidabile per il legame. Se non è verificabile lo diciamo e non lo pubblichiamo."],
        ["La tua scheda va online", "Pubblichiamo la pagina in italiano e in inglese, con l'etichetta giusta: set reale o legato al film."],
        ["Scegli più visibilità", "Se vuoi, aggiungiamo il piano In evidenza o Partner."],
      ],
      transH: "Trasparenza",
      trans: "Le inserzioni sono sempre segnalate come tali. Un piano non cambia il modo in cui verifichiamo il legame tra un locale e un film: un locale senza fonte verificabile non viene pubblicato, qualunque sia il piano.",
      faqH: "Domande frequenti",
      faq: [
        ["Quanto costa?", "La scheda Base è gratuita. In evidenza e Partner sono su richiesta: scrivici e ti facciamo un preventivo in base a ciò che ti serve."],
        ["Il mio locale deve comparire in un film?", "Deve essere legato a un film. Se ci è stato girato davvero è un «set reale». Se è vicino al set o legato al fenomeno raccontato è «legato al film» e lo diciamo chiaramente."],
        ["Posso aggiornare i miei dati?", "Sì. Scrivici per modifiche a orari, sito, link di prenotazione o foto e aggiorniamo la scheda."],
        ["Il legame con il film è garantito?", "No. Lo pubblichiamo solo quando troviamo una fonte affidabile, e la scheda riporta la data dell'ultimo controllo."],
        ["Come comincio?", "Clicca «Richiedi informazioni»: si apre la tua email con un messaggio già pronto. Aggiungi locale, città e film."],
      ],
      endH: "Pronto a farti vedere?",
      endP: "Scrivici: ti rispondiamo via email con i dettagli e i prossimi passi.",
      addH: "Il tuo locale non è ancora in guida?",
      add: "Segnalalo con il modulo",
      note: "Piani e condizioni su richiesta. Le inserzioni sono segnalate come tali.",
      bodyIntro: "Buongiorno, vorrei maggiori informazioni su",
      bodyFields: "Nome del locale:\nCittà:\nFilm o serie a cui è legato:\nTelefono (facoltativo):\n",
      subjectBase: "Richiesta inserzione",
    };

const link = (plan?: string) =>
  mail(plan ? `${t.subjectBase}: ${plan}` : t.subjectBase, `${t.bodyIntro} ${plan ? plan : (en ? "advertising on " : "le inserzioni su ") + SITE.name}.\n\n${t.bodyFields}`);

const btn = "inline-flex items-center justify-center gap-2 rounded-full bg-[#16a34a] px-7 py-3.5 text-base font-bold text-white shadow-lg shadow-[#16a34a]/35 ring-1 ring-white/20 transition hover:-translate-y-0.5 hover:bg-[#22c55e] hover:shadow-xl hover:shadow-[#22c55e]/40 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#22c55e]";
const btnSm = "inline-flex w-full items-center justify-center gap-2 rounded-full bg-[#16a34a] px-5 py-2.5 text-sm font-bold text-white shadow-md shadow-[#16a34a]/30 transition hover:-translate-y-0.5 hover:bg-[#22c55e] focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#22c55e]";
const mailIcon = `<svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="m3 7 9 6 9-6"/></svg>`;
---

<BaseLayout lang={lang} title={t.title} description={t.description}>
  <section class="mx-auto max-w-5xl px-4 py-12">
    <div class="text-center">
      <span class="inline-block rounded-full bg-gold-400/15 px-3 py-1 text-xs font-semibold text-gold-600 dark:text-gold-400">{t.badge}</span>
      <h1 class="mt-3 font-display text-4xl font-extrabold sm:text-5xl">{t.h1}</h1>
      <p class="mx-auto mt-4 max-w-2xl text-lg text-ink-700 dark:text-cream-200">{t.lead}</p>
      <div class="mt-7 flex flex-col items-center gap-2">
        <a href={link()} class={btn}><Fragment set:html={mailIcon} />{t.cta}</a>
        <span class="text-xs text-ink-500 dark:text-ink-400">{t.ctaSub}</span>
      </div>
    </div>

    <div class="mt-12 grid grid-cols-2 gap-4 sm:grid-cols-4">
      {t.stats.map(([n, l]) => (
        <div class="rounded-2xl bg-cream-100 p-5 text-center dark:bg-noir-900">
          <p class="font-display text-3xl font-extrabold text-gold-600 dark:text-gold-400">{n}</p>
          <p class="text-sm text-ink-600 dark:text-ink-400">{l}</p>
        </div>
      ))}
    </div>

    <div class="mt-14">
      <h2 class="font-display text-2xl font-bold">{t.whyH}</h2>
      <div class="mt-5 grid gap-4 sm:grid-cols-2">
        {t.why.map(([h, p]) => (
          <div class="rounded-2xl border border-ink-500/10 bg-white p-5 dark:border-noir-700 dark:bg-noir-900">
            <p class="font-display text-lg font-bold">{h}</p>
            <p class="mt-1 text-sm text-ink-600 dark:text-cream-200">{p}</p>
          </div>
        ))}
      </div>
    </div>

    <div class="mt-14" id="piani">
      <h2 class="font-display text-2xl font-bold">{t.plansH}</h2>
      <p class="mt-1 text-ink-600 dark:text-ink-300">{t.plansLead}</p>
      <div class="mt-6 grid gap-6 md:grid-cols-3">
        {t.plans.map((p) => (
          <div class:list={["flex flex-col rounded-3xl border bg-white p-6 dark:bg-noir-900", p.tag ? "border-gold-500/50 ring-2 ring-gold-500/30" : "border-ink-500/10 dark:border-noir-700"]}>
            {p.tag ? <span class="mb-2 inline-block w-fit rounded-full bg-gold-500 px-3 py-0.5 text-xs font-semibold text-noir-950">{p.tag}</span> : <span class="mb-2 inline-block h-[22px]"></span>}
            <h3 class="font-display text-xl font-bold">{p.nome}</h3>
            <p class="text-xs font-semibold uppercase tracking-wide text-ink-500 dark:text-ink-400">{p.ideal}</p>
            <p class="mt-2 font-display text-2xl font-extrabold text-gold-600 dark:text-gold-400">{p.prezzo}</p>
            <ul class="mt-4 flex-1 space-y-2 text-sm text-ink-700 dark:text-cream-200">
              {p.voci.map((v) => <li class="flex gap-2"><span class="text-[#16a34a]">✓</span><span>{v}</span></li>)}
            </ul>
            <a href={link(p.subj)} class:list={[btnSm, "mt-6"]}><Fragment set:html={mailIcon} />{t.cta}</a>
          </div>
        ))}
      </div>
    </div>

    <div class="mt-14 grid gap-8 md:grid-cols-2">
      <div>
        <h2 class="font-display text-2xl font-bold">{t.whereH}</h2>
        <ul class="mt-4 space-y-2 text-ink-700 dark:text-cream-200">
          {t.where.map((v) => <li class="flex gap-2"><span class="mt-0.5 text-gold-500">●</span><span>{v}</span></li>)}
        </ul>
      </div>
      <div>
        <h2 class="font-display text-2xl font-bold">{t.howH}</h2>
        <ol class="mt-4 space-y-3">
          {t.how.map(([h, p], i) => (
            <li class="flex gap-3">
              <span class="flex h-7 w-7 shrink-0 items-center justify-center rounded-full bg-gold-500 text-sm font-bold text-noir-950">{i + 1}</span>
              <span class="text-ink-700 dark:text-cream-200"><strong>{h}.</strong> {p}</span>
            </li>
          ))}
        </ol>
      </div>
    </div>

    <div class="mt-14 rounded-3xl border border-gold-500/30 bg-gold-400/10 p-6">
      <h2 class="font-display text-xl font-bold">{t.transH}</h2>
      <p class="mt-2 text-ink-700 dark:text-cream-200">{t.trans}</p>
    </div>

    <div class="mt-14">
      <h2 class="font-display text-2xl font-bold">{t.faqH}</h2>
      <div class="mt-4 divide-y divide-ink-500/10 dark:divide-noir-700">
        {t.faq.map(([d, r]) => (
          <details class="group py-3">
            <summary class="cursor-pointer list-none font-semibold marker:content-none"><span class="text-gold-600 dark:text-gold-400">▸ </span>{d}</summary>
            <p class="mt-2 text-ink-600 dark:text-ink-300">{r}</p>
          </details>
        ))}
      </div>
    </div>

    <div class="mt-14 rounded-[2rem] bg-noir-900 px-6 py-12 text-center">
      <h2 class="font-display text-3xl font-bold text-white">{t.endH}</h2>
      <p class="mx-auto mt-2 max-w-xl text-cream-200">{t.endP}</p>
      <div class="mt-6"><a href={link()} class={btn}><Fragment set:html={mailIcon} />{t.cta}</a></div>
      <p class="mt-4 text-sm text-cream-200">{t.addH} <a class="font-semibold text-gold-400 underline" href={path("/aggiungi-locale", lang)}>{t.add}</a></p>
    </div>

    <p class="mt-8 text-center text-xs text-ink-500 dark:text-ink-400">{t.note}</p>
  </section>
</BaseLayout>
