---
/**
 * Logo del sito: marchio disegnato (ciak + forchetta) + nome in font display.
 * Il marchio usa i colori del brand; il nome eredita il colore del testo.
 */
import { SITE } from "../config/site";
interface Props {
  /** Dimensione del marchio in px. */
  size?: number;
}
const { size = 34 } = Astro.props;
---

<span class="inline-flex items-center gap-2.5">
  <svg
    width={size}
    height={size}
    viewBox="0 0 64 64"
    fill="none"
    aria-hidden="true"
    class="shrink-0"
  >
    <rect width="64" height="64" rx="15" fill="#191920" />
    <!-- corpo del ciak -->
    <rect x="12" y="30" width="40" height="22" rx="3" fill="#f5c451" />
    <!-- asta superiore inclinata con strisce -->
    <g transform="rotate(-10 12 24)">
      <rect x="12" y="16" width="40" height="11" rx="2" fill="#f5c451" />
      <path d="M18 16 23 27 M27 16 32 27 M36 16 41 27 M45 16 50 27" stroke="#191920" stroke-width="3" />
    </g>
    <!-- forchetta stilizzata -->
    <g stroke="#191920" stroke-width="2.6" stroke-linecap="round">
      <path d="M26 36 v10" /><path d="M30 36 v10" /><path d="M34 36 v10" />
    </g>
  </svg>
  <span class="font-display text-xl font-extrabold leading-none tracking-tight">{SITE.name}</span>
</span>
