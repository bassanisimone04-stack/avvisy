---
/** Card di una città, con foto di sfondo e numero di locali. */
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import { path, type Lang } from "../i18n/ui";

interface Props {
  nome: string;
  slug: string;
  immagine: ImageMetadata;
  count: number;
  lang?: Lang;
}
const { nome, slug, immagine, count, lang = "it" } = Astro.props;
const label =
  lang === "en"
    ? `${count} ${count === 1 ? "venue" : "venues"}`
    : `${count} ${count === 1 ? "locale" : "locali"}`;
---

<a
  href={path(`/${slug}`, lang)}
  class="group relative block overflow-hidden rounded-3xl shadow-sm transition-all duration-300 hover:-translate-y-1 hover:shadow-xl"
>
  <Image
    src={immagine}
    alt={`${nome}`}
    width={500}
    height={375}
    densities={[1, 2]}
    quality={85}
    loading="lazy"
    class="aspect-[4/3] w-full object-cover transition-transform duration-500 group-hover:scale-110"
  />
  <div class="absolute inset-0 overlay-bottom"></div>
  <div class="absolute inset-x-0 bottom-0 p-4">
    <h3 class="font-display text-2xl font-bold text-white">{nome}</h3>
    <p class="text-sm text-cream-200">{label}</p>
  </div>
</a>
