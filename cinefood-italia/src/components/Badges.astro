---
/**
 * Piccoli "badge" riutilizzabili. Passa una sola prop tra:
 * `tipo`, `prezzo`, `stato`, `categoria`, `evidenza`. `lang` per la lingua.
 */
import { statoLabel, categoriaLabel, tipoLabel } from "../lib/utils";
import { useT, type Lang } from "../i18n/ui";
import Icon from "./Icon.astro";

interface Props {
  tipo?: string;
  prezzo?: string;
  stato?: string;
  categoria?: string;
  evidenza?: boolean;
  lang?: Lang;
  /** Se il badge è sovrapposto a una foto: usa sfondi pieni e leggibili. */
  onImage?: boolean;
}
const { tipo, prezzo, stato, categoria, evidenza, lang = "it", onImage = false } = Astro.props;
const t = useT(lang);

const statoColor: Record<string, string> = {
  aperto: "bg-green-500/15 text-green-700 dark:text-green-300",
  chiuso: "bg-red-500/15 text-red-700 dark:text-red-300",
  "temporaneamente-chiuso": "bg-amber-500/15 text-amber-700 dark:text-amber-300",
};

const base =
  "inline-flex items-center gap-1 rounded-full px-2.5 py-0.5 text-xs font-medium";
---

{
  evidenza && (
    <span class={`${base} bg-gold-500 font-semibold text-noir-950`}><Icon name="star" class="h-3.5 w-3.5" /> {t("badge.evidenza")}</span>
  )
}
{
  categoria && (
    <span
      class:list={[
        base,
        "font-semibold",
        categoria === "set-reale"
          ? onImage
            ? "bg-noir-950/85 text-gold-300 shadow-sm backdrop-blur-sm"
            : "bg-gold-500/15 text-gold-700 dark:text-gold-300"
          : categoria === "legato-al-film"
            ? onImage
              ? "bg-noir-950/85 text-cream-200 shadow-sm backdrop-blur-sm"
              : "bg-ink-500/15 text-ink-700 dark:text-ink-300"
          : onImage
            ? "bg-noir-950/85 text-purple-200 shadow-sm backdrop-blur-sm"
            : "bg-purple-500/15 text-purple-700 dark:text-purple-300",
      ]}
    >
      {categoria === "set-reale" ? <Icon name="film" class="h-3.5 w-3.5" /> : categoria === "legato-al-film" ? <Icon name="pin" class="h-3.5 w-3.5" /> : <Icon name="sparkle" class="h-3.5 w-3.5" />} {categoriaLabel(categoria, lang)}
    </span>
  )
}
{
  tipo && (
    <span class={`${base} bg-ink-500/15 capitalize text-ink-700 dark:text-ink-300`}>
      {tipoLabel(tipo, lang)}
    </span>
  )
}
{
  prezzo && (
    <span class={`${base} bg-gold-500/10 font-semibold text-gold-700 dark:text-gold-300`}>
      {prezzo}
    </span>
  )
}
{
  stato && (
    <span class:list={[base, statoColor[stato] ?? "bg-ink-500/15 text-ink-700"]}>
      {statoLabel(stato, lang)}
    </span>
  )
}
