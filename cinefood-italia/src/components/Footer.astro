---
/** Piè di pagina con newsletter, link utili e social. `lang` per la lingua. */
import { SITE } from "../config/site";
import Newsletter from "./Newsletter.astro";
import { useT, path, type Lang } from "../i18n/ui";

interface Props {
  lang?: Lang;
}
const { lang = "it" } = Astro.props;
const t = useT(lang);
const anno = new Date().getFullYear();
const social = Object.entries(SITE.social).filter(([, url]) => url);

const nav = [
  { label: t("nav.locali"), href: path("/locali", lang) },
  { label: t("nav.film"), href: path("/film", lang) },
  { label: t("nav.mappa"), href: path("/mappa", lang) },
  { label: t("nav.blog"), href: path("/blog", lang) },
  { label: t("nav.inserzioni"), href: path("/inserzioni", lang) },
];
---

<footer class="mt-20 border-t border-ink-500/10 bg-cream-100 dark:border-noir-800 dark:bg-noir-900">
  <div class="border-b border-ink-500/10 dark:border-noir-800">
    <div class="mx-auto flex max-w-6xl flex-col items-start gap-4 px-4 py-10 md:flex-row md:items-center md:justify-between">
      <div>
        <h2 class="font-display text-2xl font-bold">{t("footer.newsTitolo")}</h2>
        <p class="mt-1 text-sm text-ink-600 dark:text-ink-400">{t("footer.newsSub")}</p>
      </div>
      <Newsletter lang={lang} />
    </div>
  </div>

  <div class="mx-auto grid max-w-6xl gap-8 px-4 py-12 sm:grid-cols-2 md:grid-cols-4">
    <div class="sm:col-span-2 md:col-span-1">
      <p class="flex items-center gap-2 font-display text-xl font-extrabold">
        <span aria-hidden="true">🎬</span>{SITE.name}
      </p>
      <p class="mt-2 text-sm text-ink-600 dark:text-ink-400">{t("brand.tagline")}.</p>
    </div>

    <div>
      <h3 class="text-sm font-semibold">{t("footer.naviga")}</h3>
      <ul class="mt-3 space-y-2 text-sm text-ink-600 dark:text-ink-400">
        {nav.map((link) => (
          <li><a class="hover:text-gold-600 dark:hover:text-gold-400" href={link.href}>{link.label}</a></li>
        ))}
      </ul>
    </div>

    <div>
      <h3 class="text-sm font-semibold">{t("footer.info")}</h3>
      <ul class="mt-3 space-y-2 text-sm text-ink-600 dark:text-ink-400">
        <li><a class="hover:text-gold-600 dark:hover:text-gold-400" href={path("/chi-siamo", lang)}>{t("nav.chiSiamo")}</a></li>
        <li><a class="hover:text-gold-600 dark:hover:text-gold-400" href={path("/aggiungi-locale", lang)}>{t("nav.aggiungiLungo")}</a></li>
        <li><a class="hover:text-gold-600 dark:hover:text-gold-400" href={path("/inserzioni", lang)}>{t("nav.inserzioni")}</a></li>
      </ul>
    </div>

    <div>
      <h3 class="text-sm font-semibold">{t("footer.contatti")}</h3>
      <ul class="mt-3 space-y-2 text-sm text-ink-600 dark:text-ink-400">
        <li><a class="hover:text-gold-600 dark:hover:text-gold-400" href={`mailto:${SITE.email}`}>{SITE.email}</a></li>
        {
          social.length > 0 && (
            <li class="flex gap-3 pt-1">
              {social.map(([nome, url]) => (
                <a class="capitalize hover:text-gold-600 dark:hover:text-gold-400" href={url} rel="noopener" target="_blank">{nome}</a>
              ))}
            </li>
          )
        }
      </ul>
    </div>
  </div>

  <div class="border-t border-ink-500/10 px-4 py-4 dark:border-noir-800">
    <p class="mx-auto max-w-6xl text-center text-xs text-ink-500 dark:text-ink-400">
      © {anno} {SITE.name}. {t("footer.legale")}
    </p>
  </div>
</footer>
