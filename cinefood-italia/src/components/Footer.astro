---
/** Piè di pagina del sito con link utili e social. */
import { SITE, NAV_LINKS } from "../config/site";

const anno = new Date().getFullYear();
const social = Object.entries(SITE.social).filter(([, url]) => url);
---

<footer class="mt-16 border-t border-ink-100 bg-white">
  <div class="mx-auto grid max-w-6xl gap-8 px-4 py-10 sm:grid-cols-2 md:grid-cols-4">
    <div class="sm:col-span-2 md:col-span-1">
      <p class="flex items-center gap-2 text-lg font-extrabold">
        <span aria-hidden="true">🎬</span>{SITE.name}
      </p>
      <p class="mt-2 text-sm text-ink-700">{SITE.tagline}.</p>
    </div>

    <div>
      <h2 class="text-sm font-semibold text-ink-900">Naviga</h2>
      <ul class="mt-3 space-y-2 text-sm text-ink-700">
        {
          NAV_LINKS.map((link) => (
            <li>
              <a class="hover:text-brand-600" href={link.href}>
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
    </div>

    <div>
      <h2 class="text-sm font-semibold text-ink-900">Informazioni</h2>
      <ul class="mt-3 space-y-2 text-sm text-ink-700">
        <li><a class="hover:text-brand-600" href="/chi-siamo">Chi siamo</a></li>
        <li><a class="hover:text-brand-600" href="/aggiungi-locale">Aggiungi il tuo locale</a></li>
        <li><a class="hover:text-brand-600" href="/inserzioni">Inserzioni e pubblicità</a></li>
      </ul>
    </div>

    <div>
      <h2 class="text-sm font-semibold text-ink-900">Contatti</h2>
      <ul class="mt-3 space-y-2 text-sm text-ink-700">
        <li>
          <a class="hover:text-brand-600" href={`mailto:${SITE.email}`}>{SITE.email}</a>
        </li>
        {
          social.length > 0 && (
            <li class="flex gap-3 pt-1">
              {social.map(([nome, url]) => (
                <a class="capitalize hover:text-brand-600" href={url} rel="noopener" target="_blank">
                  {nome}
                </a>
              ))}
            </li>
          )
        }
      </ul>
    </div>
  </div>

  <div class="border-t border-ink-100 px-4 py-4">
    <p class="mx-auto max-w-6xl text-center text-xs text-ink-700">
      © {anno} {SITE.name}. I dati dei locali sono a scopo dimostrativo e vanno
      verificati. I titoli di film e serie appartengono ai rispettivi aventi diritto.
    </p>
  </div>
</footer>
