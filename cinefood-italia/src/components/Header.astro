---
/** Intestazione: logo, navigazione, selettore lingua, toggle tema, menu mobile. */
import { SITE } from "../config/site";
import ThemeToggle from "./ThemeToggle.astro";
import LanguageSwitcher from "./LanguageSwitcher.astro";
import { useT, path, type Lang } from "../i18n/ui";

interface Props {
  lang?: Lang;
}
const { lang = "it" } = Astro.props;
const t = useT(lang);

const nav = [
  { label: t("nav.locali"), href: path("/locali", lang) },
  { label: t("nav.film"), href: path("/film", lang) },
  { label: t("nav.mappa"), href: path("/mappa", lang) },
  { label: t("nav.blog"), href: path("/blog", lang) },
  { label: t("nav.inserzioni"), href: path("/inserzioni", lang) },
];
const p = Astro.url.pathname;
const isActive = (href: string) => p === href || p === href + "/";
---

<header
  class="sticky top-0 z-40 border-b border-ink-500/10 bg-cream-50/85 backdrop-blur-md dark:border-noir-800 dark:bg-noir-950/80"
>
  <nav
    class="mx-auto flex max-w-6xl items-center justify-between gap-3 px-4 py-3"
    aria-label="Menu"
  >
    <a href={path("/", lang)} class="flex items-center gap-2 font-display text-xl font-extrabold">
      <span aria-hidden="true" class="text-2xl">🎬</span>
      <span>{SITE.name}</span>
    </a>

    <ul class="hidden items-center gap-7 md:flex">
      {
        nav.map((link) => (
          <li>
            <a
              href={link.href}
              class:list={[
                "text-sm font-medium transition-colors hover:text-gold-600 dark:hover:text-gold-400",
                isActive(link.href)
                  ? "text-gold-600 dark:text-gold-400"
                  : "text-ink-700 dark:text-cream-200",
              ]}
            >
              {link.label}
            </a>
          </li>
        ))
      }
    </ul>

    <div class="flex items-center gap-1.5">
      <LanguageSwitcher />
      <ThemeToggle />
      <a
        href={path("/aggiungi-locale", lang)}
        class="hidden rounded-full bg-gold-500 px-4 py-2 text-sm font-semibold text-noir-950 transition-colors hover:bg-gold-400 lg:inline-block"
      >
        {t("nav.aggiungi")}
      </a>
      <button
        id="menu-toggle"
        type="button"
        class="inline-flex items-center justify-center rounded-md p-2 text-ink-700 dark:text-cream-200 md:hidden"
        aria-label={t("a11y.menu")}
        aria-expanded="false"
        aria-controls="mobile-menu"
      >
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <line x1="3" y1="6" x2="21" y2="6"></line>
          <line x1="3" y1="12" x2="21" y2="12"></line>
          <line x1="3" y1="18" x2="21" y2="18"></line>
        </svg>
      </button>
    </div>
  </nav>

  <ul id="mobile-menu" class="hidden border-t border-ink-500/10 px-4 py-2 dark:border-noir-800 md:hidden">
    {
      nav.map((link) => (
        <li>
          <a
            href={link.href}
            class:list={[
              "block rounded-md px-2 py-2 text-sm font-medium",
              isActive(link.href) ? "text-gold-600 dark:text-gold-400" : "text-ink-700 dark:text-cream-200",
            ]}
          >
            {link.label}
          </a>
        </li>
      ))
    }
    <li>
      <a href={path("/aggiungi-locale", lang)} class="mt-1 block rounded-md bg-gold-500 px-2 py-2 text-center text-sm font-semibold text-noir-950">
        {t("nav.aggiungiLungo")}
      </a>
    </li>
  </ul>
</header>

<script>
  const toggle = document.getElementById("menu-toggle");
  const menu = document.getElementById("mobile-menu");
  toggle?.addEventListener("click", () => {
    const hidden = menu?.classList.toggle("hidden");
    toggle.setAttribute("aria-expanded", String(hidden === false));
  });
</script>
