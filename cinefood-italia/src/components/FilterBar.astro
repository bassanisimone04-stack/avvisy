---
/**
 * Barra di ricerca e filtri lato client (nessun ricaricamento di pagina).
 * Filtra le schede per testo, città, film, tipo e fascia di prezzo.
 *
 * Funziona insieme all'elenco di schede della pagina /locali: ogni scheda
 * deve stare dentro un elemento con classe ".locale-card" e i relativi
 * attributi data-* (vedi src/pages/locali/index.astro).
 */
import { FASCE_PREZZO } from "../content.config";

interface Props {
  citta: string[];
  tipi: string[];
  film: { titolo: string; slug: string }[];
}

const { citta, tipi, film } = Astro.props;
---

<form
  id="filtri"
  class="grid grid-cols-1 gap-3 rounded-2xl border border-ink-100 bg-white p-4 shadow-sm sm:grid-cols-2 lg:grid-cols-5"
  role="search"
  aria-label="Filtra i locali"
>
  <!-- Ricerca testuale -->
  <div class="sm:col-span-2 lg:col-span-5">
    <label for="f-cerca" class="sr-only">Cerca</label>
    <input
      id="f-cerca"
      type="search"
      placeholder="Cerca per nome, città o film…"
      autocomplete="off"
      class="w-full rounded-xl border border-ink-100 px-4 py-2.5 text-sm focus:border-brand-500"
    />
  </div>

  <!-- Città -->
  <div>
    <label for="f-citta" class="mb-1 block text-xs font-medium text-ink-700">Città</label>
    <select id="f-citta" class="w-full rounded-xl border border-ink-100 px-3 py-2 text-sm">
      <option value="">Tutte</option>
      {citta.map((c) => <option value={c}>{c}</option>)}
    </select>
  </div>

  <!-- Film -->
  <div>
    <label for="f-film" class="mb-1 block text-xs font-medium text-ink-700">Film / Serie</label>
    <select id="f-film" class="w-full rounded-xl border border-ink-100 px-3 py-2 text-sm">
      <option value="">Tutti</option>
      {film.map((f) => <option value={f.slug}>{f.titolo}</option>)}
    </select>
  </div>

  <!-- Tipo -->
  <div>
    <label for="f-tipo" class="mb-1 block text-xs font-medium text-ink-700">Tipo</label>
    <select id="f-tipo" class="w-full rounded-xl border border-ink-100 px-3 py-2 text-sm capitalize">
      <option value="">Tutti</option>
      {tipi.map((t) => <option value={t}>{t}</option>)}
    </select>
  </div>

  <!-- Prezzo -->
  <div>
    <label for="f-prezzo" class="mb-1 block text-xs font-medium text-ink-700">Prezzo</label>
    <select id="f-prezzo" class="w-full rounded-xl border border-ink-100 px-3 py-2 text-sm">
      <option value="">Tutti</option>
      {FASCE_PREZZO.map((p) => <option value={p}>{p}</option>)}
    </select>
  </div>

  <!-- Reset -->
  <div class="flex items-end">
    <button
      id="f-reset"
      type="reset"
      class="w-full rounded-xl border border-ink-100 px-3 py-2 text-sm font-medium text-ink-700 hover:bg-ink-50"
    >
      Azzera filtri
    </button>
  </div>
</form>

<!-- Contatore risultati -->
<p id="risultati-conteggio" class="mt-3 text-sm text-ink-700" aria-live="polite"></p>

<script>
  // Logica di filtro lato client. Legge gli attributi data-* delle schede.
  const form = document.getElementById("filtri") as HTMLFormElement | null;
  const griglia = document.getElementById("griglia-locali");
  const conteggio = document.getElementById("risultati-conteggio");
  const vuoto = document.getElementById("nessun-risultato");

  if (form && griglia) {
    const cards = Array.from(
      griglia.querySelectorAll<HTMLElement>(".locale-card")
    );

    const $ = (id: string) =>
      document.getElementById(id) as HTMLInputElement | HTMLSelectElement | null;

    function applica() {
      const cerca = ($("f-cerca")?.value || "").trim().toLowerCase();
      const citta = $("f-citta")?.value || "";
      const film = $("f-film")?.value || "";
      const tipo = $("f-tipo")?.value || "";
      const prezzo = $("f-prezzo")?.value || "";

      let visibili = 0;
      for (const card of cards) {
        const d = card.dataset;
        const testo = d.testo || "";
        const okCerca = !cerca || testo.includes(cerca);
        const okCitta = !citta || d.citta === citta;
        const okFilm = !film || (d.film || "").split("|").includes(film);
        const okTipo = !tipo || d.tipo === tipo;
        const okPrezzo = !prezzo || d.prezzo === prezzo;

        const mostra = okCerca && okCitta && okFilm && okTipo && okPrezzo;
        card.hidden = !mostra;
        if (mostra) visibili++;
      }

      if (conteggio) {
        conteggio.textContent =
          visibili === cards.length
            ? `${cards.length} locali`
            : `${visibili} locali su ${cards.length}`;
      }
      if (vuoto) vuoto.hidden = visibili !== 0;
    }

    form.addEventListener("input", applica);
    form.addEventListener("reset", () => setTimeout(applica, 0));

    // Se l'URL contiene ?film=... o ?citta=... applica il filtro iniziale.
    const params = new URLSearchParams(location.search);
    const preFilm = params.get("film");
    const preCitta = params.get("citta");
    const preTipo = params.get("tipo");
    const preCerca = params.get("cerca");
    if (preCerca && $("f-cerca")) ($("f-cerca") as HTMLInputElement).value = preCerca;
    if (preFilm && $("f-film")) ($("f-film") as HTMLSelectElement).value = preFilm;
    if (preCitta && $("f-citta")) ($("f-citta") as HTMLSelectElement).value = preCitta;
    if (preTipo && $("f-tipo")) ($("f-tipo") as HTMLSelectElement).value = preTipo;

    applica();
  }
</script>
