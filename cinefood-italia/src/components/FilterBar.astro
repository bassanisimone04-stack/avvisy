---
/** Barra di ricerca e filtri lato client. `lang` per la lingua. */
import { FASCE_PREZZO, CATEGORIE } from "../content.config";
import { categoriaLabel, tipoLabel } from "../lib/utils";
import { useT, type Lang } from "../i18n/ui";

interface Props {
  citta: string[];
  tipi: string[];
  film: { titolo: string; slug: string }[];
  lang?: Lang;
}
const { citta, tipi, film, lang = "it" } = Astro.props;
const t = useT(lang);

const selectClass =
  "w-full rounded-xl border border-ink-500/20 bg-white px-3 py-2 text-sm dark:border-noir-600 dark:bg-noir-800 dark:text-cream-100";
---

<form
  id="filtri"
  class="grid grid-cols-1 gap-3 rounded-3xl border border-ink-500/10 bg-white p-4 shadow-sm dark:border-noir-700 dark:bg-noir-900 sm:grid-cols-2 lg:grid-cols-6"
  role="search"
  aria-label={t("locali.titolo")}
>
  <div class="sm:col-span-2 lg:col-span-6">
    <label for="f-cerca" class="sr-only">{t("hero.cerca")}</label>
    <input
      id="f-cerca"
      type="search"
      placeholder={t("filtri.cercaPh")}
      autocomplete="off"
      class="w-full rounded-xl border border-ink-500/20 bg-white px-4 py-2.5 text-sm focus:border-gold-500 dark:border-noir-600 dark:bg-noir-800 dark:text-cream-100"
    />
  </div>

  <div>
    <label for="f-citta" class="mb-1 block text-xs font-medium text-ink-600 dark:text-ink-400">{t("filtri.citta")}</label>
    <select id="f-citta" class={selectClass}>
      <option value="">{t("filtri.tutte")}</option>
      {citta.map((c) => <option value={c}>{c}</option>)}
    </select>
  </div>

  <div>
    <label for="f-film" class="mb-1 block text-xs font-medium text-ink-600 dark:text-ink-400">{t("filtri.film")}</label>
    <select id="f-film" class={selectClass}>
      <option value="">{t("filtri.tutti")}</option>
      {film.map((f) => <option value={f.slug}>{f.titolo}</option>)}
    </select>
  </div>

  <div>
    <label for="f-tipo" class="mb-1 block text-xs font-medium text-ink-600 dark:text-ink-400">{t("filtri.tipo")}</label>
    <select id="f-tipo" class={`${selectClass} capitalize`}>
      <option value="">{t("filtri.tutti")}</option>
      {tipi.map((tp) => <option value={tp}>{tipoLabel(tp, lang)}</option>)}
    </select>
  </div>

  <div>
    <label for="f-categoria" class="mb-1 block text-xs font-medium text-ink-600 dark:text-ink-400">{t("filtri.categoria")}</label>
    <select id="f-categoria" class={selectClass}>
      <option value="">{t("filtri.tutte")}</option>
      {CATEGORIE.map((c) => <option value={c}>{categoriaLabel(c, lang)}</option>)}
    </select>
  </div>

  <div>
    <label for="f-prezzo" class="mb-1 block text-xs font-medium text-ink-600 dark:text-ink-400">{t("filtri.prezzo")}</label>
    <select id="f-prezzo" class={selectClass}>
      <option value="">{t("filtri.tutti")}</option>
      {FASCE_PREZZO.map((p) => <option value={p}>{p}</option>)}
    </select>
  </div>

  <div class="flex items-end">
    <button
      id="f-reset"
      type="reset"
      class="w-full rounded-xl border border-ink-500/20 px-3 py-2 text-sm font-medium text-ink-600 hover:bg-cream-100 dark:border-noir-600 dark:text-ink-400 dark:hover:bg-noir-800"
    >
      {t("filtri.azzera")}
    </button>
  </div>
</form>

<p
  id="risultati-conteggio"
  class="mt-3 text-sm text-ink-500 dark:text-ink-400"
  aria-live="polite"
  data-word={t("conta.uno")}
  data-of={t("conta.su")}
  data-more={lang === "en" ? "Show more" : "Mostra altri"}
></p>

<script>
  const form = document.getElementById("filtri") as HTMLFormElement | null;
  const griglia = document.getElementById("griglia-locali");
  const conteggio = document.getElementById("risultati-conteggio");
  const vuoto = document.getElementById("nessun-risultato");
  const WORD = conteggio?.dataset.word || "locali";
  const OF = conteggio?.dataset.of || "su";
  const MORE = conteggio?.dataset.more || "Mostra altri";
  const PAGINA = 24; // schede mostrate per volta: le altre restano nell'HTML (per Google) ma nascoste, quindi le loro immagini non si scaricano

  if (form && griglia) {
    const cards = Array.from(griglia.querySelectorAll<HTMLElement>(".locale-card"));
    const $ = (id: string) =>
      document.getElementById(id) as HTMLInputElement | HTMLSelectElement | null;

    let limite = PAGINA;
    const btnMore = document.createElement("button");
    btnMore.type = "button";
    btnMore.hidden = true;
    btnMore.className = "mx-auto mt-8 block rounded-full border border-ink-500/20 bg-white px-6 py-3 text-sm font-semibold shadow-sm transition-all hover:-translate-y-0.5 hover:border-gold-500 dark:border-noir-600 dark:bg-noir-900";
    griglia.insertAdjacentElement("afterend", btnMore);
    btnMore.addEventListener("click", () => { limite += PAGINA; applica(); });

    function applica() {
      const cerca = ($("f-cerca")?.value || "").trim().toLowerCase();
      const citta = $("f-citta")?.value || "";
      const film = $("f-film")?.value || "";
      const tipo = $("f-tipo")?.value || "";
      const categoria = $("f-categoria")?.value || "";
      const prezzo = $("f-prezzo")?.value || "";

      let visibili = 0;
      for (const card of cards) {
        const d = card.dataset;
        const ok =
          (!cerca || (d.testo || "").includes(cerca)) &&
          (!citta || d.citta === citta) &&
          (!film || (d.film || "").split("|").includes(film)) &&
          (!tipo || d.tipo === tipo) &&
          (!categoria || d.categoria === categoria) &&
          (!prezzo || d.prezzo === prezzo);
        if (ok) visibili++;
        card.hidden = !ok || visibili > limite;
      }
      btnMore.hidden = visibili <= limite;
      btnMore.textContent = `${MORE} (${visibili - limite})`;

      if (conteggio)
        conteggio.textContent =
          visibili === cards.length
            ? `${cards.length} ${WORD}`
            : `${visibili} ${WORD} ${OF} ${cards.length}`;
      if (vuoto) vuoto.hidden = visibili !== 0;
    }

    form.addEventListener("input", () => { limite = PAGINA; applica(); });
    form.addEventListener("reset", () => { limite = PAGINA; setTimeout(applica, 0); });

    const params = new URLSearchParams(location.search);
    const set = (id: string, key: string) => {
      const v = params.get(key);
      const el = $(id);
      if (v && el) (el as HTMLInputElement).value = v;
    };
    set("f-cerca", "cerca");
    set("f-film", "film");
    set("f-citta", "citta");
    set("f-tipo", "tipo");
    set("f-categoria", "categoria");
    applica();
  }
</script>
