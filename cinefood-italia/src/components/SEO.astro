---
/**
 * Componente SEO: meta tag, Open Graph, canonical, hreflang e JSON-LD.
 */
import { SITE } from "../config/site";
import { type Lang, stripLang, path } from "../i18n/ui";

interface Props {
  title?: string;
  description?: string;
  image?: string;
  type?: "website" | "article";
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
  lang?: Lang;
}

const {
  title,
  description,
  image,
  type = "website",
  jsonLd,
  lang = "it",
} = Astro.props;

const defaultDesc =
  lang === "en"
    ? "The guide to Italian restaurants, bars and cafés seen in films and TV series. Discover the real locations and book your table among the stars."
    : SITE.description;
const desc = description ?? defaultDesc;

const fullTitle = title ? `${title} · ${SITE.name}` : `${SITE.name} — ${SITE.tagline}`;
const canonical = new URL(Astro.url.pathname, Astro.site ?? SITE.url).href;
// Versioni alternative nelle due lingue (hreflang) per la SEO internazionale.
const basePath = stripLang(Astro.url.pathname);
const itHref = new URL(path(basePath, "it"), Astro.site ?? SITE.url).href;
const enHref = new URL(path(basePath, "en"), Astro.site ?? SITE.url).href;
const ogImage = image
  ? new URL(image, Astro.site ?? SITE.url).href
  : new URL("/og-default.jpg", Astro.site ?? SITE.url).href;
---

<title>{fullTitle}</title>
<meta name="description" content={desc} />
<link rel="canonical" href={canonical} />
<link rel="alternate" hreflang="it" href={itHref} />
<link rel="alternate" hreflang="en" href={enHref} />
<link rel="alternate" hreflang="x-default" href={itHref} />

<!-- Indicizzazione: consenti anteprime ricche (immagini/testo) nei risultati. -->
<meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
{SITE.googleSiteVerification && (
  <meta name="google-site-verification" content={SITE.googleSiteVerification} />
)}

<!-- Feed RSS (per lettori di feed e discovery). -->
<link rel="alternate" type="application/rss+xml" title={`${SITE.name} — Blog`} href={new URL(lang === "en" ? "/en/rss.xml" : "/rss.xml", Astro.site ?? SITE.url).href} />

<meta property="og:site_name" content={SITE.name} />
<meta property="og:title" content={fullTitle} />
<meta property="og:description" content={desc} />
<meta property="og:type" content={type} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={ogImage} />
<meta property="og:image:alt" content={fullTitle} />
<meta property="og:locale" content={lang === "en" ? "en_GB" : "it_IT"} />
<meta property="og:locale:alternate" content={lang === "en" ? "it_IT" : "en_GB"} />

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={fullTitle} />
<meta name="twitter:description" content={desc} />
<meta name="twitter:image" content={ogImage} />
<meta name="twitter:image:alt" content={fullTitle} />

{
  jsonLd && (
    <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  )
}
