---
/** Pagina di vendita de "La Guida CineFood Italia" (PDF). Una sola implementazione per IT ed EN. */
import { getCollection } from "astro:content";
import { Image } from "astro:assets";
import BaseLayout from "../layouts/BaseLayout.astro";
import { SITE } from "../config/site";
import { path, type Lang } from "../i18n/ui";
import { tCitta } from "../i18n/content-en";
import copertinaIt from "../assets/placeholder/guida-cover-preview.jpg";
import copertinaEn from "../assets/placeholder/guida-cover-preview-en.jpg";

interface Props {
  lang?: Lang;
}
const { lang = "it" } = Astro.props;
const en = lang === "en";
const copertina = en ? copertinaEn : copertinaIt;

// Numeri sempre allineati ai contenuti del sito (niente cifre scritte a mano).
const locali = await getCollection("restaurants");
const nLocali = locali.length;
const nSet = locali.filter((l) => l.data.categoria === "set-reale").length;
const nLegati = locali.filter((l) => l.data.categoria === "legato-al-film").length;
const nChiusi = locali.filter((l) => l.data.stato === "chiuso").length;
const nFilm = new Set(locali.flatMap((l) => l.data.film.map((f) => f.film.id))).size;
const nRegioni = new Set(locali.map((l) => l.data.regione)).size;
const assaggio = locali.filter((l) => l.data.inEvidenza && l.data.categoria === "set-reale").slice(0, 6);

const aree = en
  ? ["Rome and Lazio", "Naples and the coast", "Sicily", "Northern Italy"]
  : ["Roma e Lazio", "Napoli e la costa", "Sicilia", "Nord Italia"];

const t = en
  ? {
      title: "The CineFood Italia Guide (PDF)",
      description: `Downloadable PDF with ${nLocali} real venues linked to ${nFilm} Italian films and TV series, in ${nRegioni} regions, with routes by area and an index by film.`,
      badge: "Downloadable PDF · English and Italian",
      h1: "The CineFood Italia Guide",
      tagline: "Where your favourite characters ate",
      intro: `Take the directory on your trip: <strong>${nLocali} real venues</strong> across Italy linked to <strong>${nFilm} films and TV series</strong>, with the address, the price range and the exact scene. Works offline, on your phone or printed.`,
      buy: "Buy and download now →",
      soon: "🔜 Coming soon",
      secure: "Secure payment, instant download. Edition November 2026.",
      s1: "Real venues", s2: "Films & series", s3: "Regions",
      insideH: "What's inside",
      inside: [
        `${nLocali} venue entries: address, price range, the film or series, the scene and a link to the map`,
        `Each entry tells you whether it is a <strong>real set</strong> (${nSet}) or <strong>linked to the film</strong> but not filmed there (${nLegati})`,
        `4 route-by-area sections: ${aree.join(", ")}, with venues grouped by city`,
        `Index by film and series to find your favourite title in seconds`,
        `The date of the last check on every entry${nChiusi > 0 ? `; ${nChiusi} closed venues are marked as such, so you won't look for them` : ""}`,
        `Italian and English editions in the same package: one PDF readable on phone, tablet or printable`,
      ],
      whoH: "Who it's for",
      who: [
        ["Film and series fans", "You want to sit at the same table as your favourite scene."],
        ["Travellers", "You're planning a trip and want places with a story, not just reviews."],
        ["Foodies", "You like trattorias, cafés and pizzerias with a story behind the menu."],
      ],
      howH: "How we keep it truthful",
      how: "A venue appears in the guide only if its link to the film is backed by a verifiable source: the venue's own site, a film commission or production materials, or recognised press. When sources contradict each other, we drop the pairing. We tell you plainly what was shot there and what is only linked to the film. Hours and prices change, so check before you go: every entry shows its last check date.",
      tasteH: "Free preview",
      taste: "Every entry in the guide is also on the site. Here are a few, to see the level of detail:",
      faqH: "Frequently asked questions",
      faq: [
        ["How do I get the guide after purchase?", "The download starts right after payment, directly from the checkout page, and you also get an email with a link to re-download it anytime."],
        ["In which language is it?", "The package includes the Italian and the English edition."],
        ["What devices can I read it on?", "It's a standard PDF: opens on phone, tablet, computer, or can be printed. No app required."],
        ["Are the addresses up to date?", `They are the same ${nLocali} venues of the site's directory, each with its last check date (the most recent edition is November 2026). Hours and availability may still change: check before you travel.`],
        ["Is it different from the website?", "The site stays free. The guide gathers everything in one PDF, organised for planning a trip and usable offline."],
      ],
      cta: "Ready for the trip?",
      note: "Guide for information and tourism purposes, not sponsored by the venues mentioned. Always check hours and availability before you go. Cover image generated with artificial intelligence.",
      imgAlt: "The CineFood Italia Guide cover: a director's chair and a checked-tablecloth table lit by a film projector",
      allVenues: "Browse all venues",
    }
  : {
      title: "La Guida CineFood Italia (PDF)",
      description: `Guida PDF con ${nLocali} locali reali legati a ${nFilm} film e serie TV italiani, in ${nRegioni} regioni, con percorsi per area e indice per film.`,
      badge: "PDF scaricabile · italiano e inglese",
      h1: "La Guida CineFood Italia",
      tagline: "Dove hanno mangiato i tuoi personaggi preferiti",
      intro: `Porta la directory in viaggio: <strong>${nLocali} locali reali</strong> d'Italia legati a <strong>${nFilm} film e serie TV</strong>, con indirizzo, fascia di prezzo e la scena esatta. Si legge anche offline, sul telefono o stampata.`,
      buy: "Acquista e scarica ora →",
      soon: "🔜 Disponibile a breve",
      secure: "Pagamento sicuro, download immediato. Edizione novembre 2026.",
      s1: "Locali reali", s2: "Film e serie", s3: "Regioni",
      insideH: "Cosa trovi dentro",
      inside: [
        `${nLocali} schede di locali: indirizzo, fascia di prezzo, film o serie, scena e link alla mappa`,
        `Ogni scheda ti dice se è un <strong>set reale</strong> (${nSet}) o un locale <strong>legato al film</strong> ma non girato lì (${nLegati})`,
        `4 percorsi per area: ${aree.join(", ")}, con i locali raggruppati per città`,
        `Indice per film e serie per trovare subito il titolo che ti interessa`,
        `La data dell'ultimo controllo su ogni scheda${nChiusi > 0 ? `; ${nChiusi} locali chiusi sono segnalati come tali, così non li cerchi` : ""}`,
        `Edizione italiana e inglese nello stesso pacchetto: PDF leggibile su telefono, tablet o stampabile`,
      ],
      whoH: "Per chi è",
      who: [
        ["Chi ama film e serie", "Vuoi sederti allo stesso tavolo della tua scena preferita."],
        ["Chi viaggia", "Stai organizzando un viaggio e cerchi posti con una storia, non solo recensioni."],
        ["Chi ama mangiare bene", "Ti piacciono trattorie, caffè e pizzerie con una storia dietro il menu."],
      ],
      howH: "Come teniamo le informazioni vere",
      how: "Un locale entra nella guida solo se l'abbinamento con il film è supportato da una fonte verificabile: sito del locale, film commission o materiali di produzione, stampa riconosciuta. Quando le fonti si contraddicono, scartiamo l'abbinamento. Ti diciamo chiaramente cosa è stato girato lì e cosa è solo legato al film. Orari e prezzi cambiano: controlla prima di partire, ogni scheda indica la data dell'ultimo controllo.",
      tasteH: "Assaggio gratuito",
      taste: "Ogni scheda della guida è anche sul sito. Eccone alcune, per vedere il livello di dettaglio:",
      faqH: "Domande frequenti",
      faq: [
        ["Come ricevo la guida dopo l'acquisto?", "Il download parte subito dopo il pagamento, direttamente dalla pagina di checkout, e ricevi anche un'email con il link per riscaricarla quando vuoi."],
        ["In che lingua è?", "Nel pacchetto ci sono l'edizione italiana e quella inglese."],
        ["Su quali dispositivi posso leggerla?", "È un PDF standard: si apre su telefono, tablet, computer o si può stampare. Nessuna app richiesta."],
        ["Gli indirizzi sono aggiornati?", `Sono gli stessi ${nLocali} locali della directory del sito, ognuno con la data dell'ultimo controllo (l'edizione più recente è novembre 2026). Orari e disponibilità possono comunque cambiare: verifica prima di partire.`],
        ["È diversa dal sito?", "Il sito resta gratuito. La guida mette tutto in un solo PDF, organizzato per pianificare un viaggio e consultabile offline."],
      ],
      cta: "Pronto per il viaggio?",
      note: "Guida a scopo informativo e turistico, non sponsorizzata dai locali citati. Verifica sempre orari e disponibilità prima di partire. Immagine di copertina generata con intelligenza artificiale.",
      imgAlt: "Copertina della Guida CineFood Italia: una sedia da regista e un tavolo con tovaglia a quadretti illuminati da un proiettore",
      allVenues: "Sfoglia tutti i locali",
    };

const prezzo = SITE.guida.prezzo;
const checkout = SITE.guida.checkoutUrl;
const jsonLd = checkout
  ? {
      "@context": "https://schema.org",
      "@type": "Product",
      name: t.title,
      description: t.description,
      brand: { "@type": "Brand", name: SITE.name },
      offers: {
        "@type": "Offer",
        url: checkout,
        price: prezzo.replace(/[^0-9.]/g, ""),
        priceCurrency: prezzo.includes("$") ? "USD" : "EUR",
        availability: "https://schema.org/InStock",
      },
    }
  : undefined;
---

<BaseLayout lang={lang} title={t.title} description={t.description} jsonLd={jsonLd}>
  <section class="mx-auto max-w-5xl px-4 py-12">
    <div class="grid gap-10 md:grid-cols-2 md:items-center">
      <div>
        <span class="inline-block rounded-full bg-gold-400/15 px-3 py-1 text-xs font-semibold text-gold-600 dark:text-gold-400">{t.badge}</span>
        <h1 class="mt-3 font-display text-4xl font-extrabold leading-tight sm:text-5xl">{t.h1}</h1>
        <p class="mt-2 font-display text-xl italic text-gold-600 dark:text-gold-400">{t.tagline}</p>
        <p class="mt-4 text-lg text-ink-700 dark:text-cream-200" set:html={t.intro} />
        <p class="mt-4 font-display text-3xl font-extrabold text-gold-600 dark:text-gold-400">{prezzo}</p>
        {
          checkout ? (
            <a href={checkout} target="_blank" rel="sponsored noopener" class="mt-4 inline-flex items-center gap-2 rounded-full bg-gold-500 px-6 py-3 text-base font-semibold text-noir-950 shadow-lg transition-transform hover:scale-[1.03] hover:bg-gold-400">
              {t.buy}
            </a>
          ) : (
            <p class="mt-4 inline-flex items-center gap-2 rounded-full border border-ink-500/25 px-6 py-3 text-base font-semibold text-ink-500 dark:border-noir-600 dark:text-ink-400">{t.soon}</p>
          )
        }
        <p class="mt-3 text-xs text-ink-500 dark:text-ink-400">{t.secure}</p>
      </div>
      <Image src={copertina} alt={t.imgAlt} width={600} height={800} class="mx-auto w-full max-w-xs rounded-2xl shadow-2xl" />
    </div>

    <div class="mt-14 grid gap-6 sm:grid-cols-3">
      {[[nLocali, t.s1], [nFilm, t.s2], [nRegioni, t.s3]].map(([n, l]) => (
        <div class="rounded-2xl bg-cream-100 p-5 text-center dark:bg-noir-900">
          <p class="font-display text-3xl font-extrabold text-gold-600 dark:text-gold-400">{n}</p>
          <p class="text-sm text-ink-600 dark:text-ink-400">{l}</p>
        </div>
      ))}
    </div>

    <div class="mt-14">
      <h2 class="font-display text-2xl font-bold">{t.insideH}</h2>
      <ul class="mt-4 space-y-3">
        {t.inside.map((v) => (
          <li class="flex gap-3 text-ink-700 dark:text-cream-200">
            <span class="mt-0.5 text-gold-500">✓</span>
            <span set:html={v} />
          </li>
        ))}
      </ul>
    </div>

    <div class="mt-14">
      <h2 class="font-display text-2xl font-bold">{t.whoH}</h2>
      <div class="mt-4 grid gap-4 sm:grid-cols-3">
        {t.who.map(([h, p]) => (
          <div class="rounded-2xl border border-ink-500/10 bg-cream-100 p-5 dark:border-noir-700 dark:bg-noir-900">
            <p class="font-display text-lg font-bold">{h}</p>
            <p class="mt-1 text-sm text-ink-600 dark:text-cream-200">{p}</p>
          </div>
        ))}
      </div>
    </div>

    <div class="mt-14">
      <h2 class="font-display text-2xl font-bold">{t.howH}</h2>
      <p class="mt-3 text-ink-700 dark:text-cream-200">{t.how}</p>
    </div>

    {assaggio.length > 0 && (
      <div class="mt-14">
        <h2 class="font-display text-2xl font-bold">{t.tasteH}</h2>
        <p class="mt-3 text-ink-700 dark:text-cream-200">{t.taste}</p>
        <ul class="mt-4 grid gap-2 sm:grid-cols-2">
          {assaggio.map((l) => (
            <li>
              <a href={path(`/locale/${l.id}`, lang)} class="block rounded-xl border border-ink-500/10 px-4 py-2 transition-colors hover:bg-cream-100 dark:border-noir-700 dark:hover:bg-noir-900">
                <span class="font-semibold">{l.data.nome}</span>
                <span class="text-sm text-ink-500 dark:text-ink-400"> · {tCitta(l.data.citta, lang)}</span>
              </a>
            </li>
          ))}
        </ul>
        <p class="mt-3"><a href={path("/locali", lang)} class="text-sm font-semibold text-gold-600 underline dark:text-gold-400">{t.allVenues} →</a></p>
      </div>
    )}

    <div class="mt-14">
      <h2 class="font-display text-2xl font-bold">{t.faqH}</h2>
      <div class="mt-4 divide-y divide-ink-500/10 dark:divide-noir-700">
        {t.faq.map(([d, r]) => (
          <details class="group py-3">
            <summary class="cursor-pointer list-none font-semibold marker:content-none">
              <span class="text-gold-600 dark:text-gold-400">▸ </span>{d}
            </summary>
            <p class="mt-2 text-ink-600 dark:text-ink-300">{r}</p>
          </details>
        ))}
      </div>
    </div>

    <div class="mt-14 rounded-[2rem] bg-noir-900 px-6 py-10 text-center">
      <h2 class="font-display text-2xl font-bold text-white">{t.cta}</h2>
      <p class="mt-2 font-display text-3xl font-extrabold text-gold-400">{prezzo}</p>
      {checkout && (
        <a href={checkout} target="_blank" rel="sponsored noopener" class="mt-4 inline-flex rounded-full bg-gold-500 px-6 py-3 text-base font-semibold text-noir-950 hover:bg-gold-400">{t.buy}</a>
      )}
    </div>

    <p class="mt-10 text-center text-xs text-ink-500 dark:text-ink-400">{t.note}</p>
  </section>
</BaseLayout>
