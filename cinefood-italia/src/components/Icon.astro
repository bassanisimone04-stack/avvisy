---
/**
 * Icone SVG lineari riutilizzabili (stile "outline", colore ereditato da
 * currentColor). Sostituiscono le emoji per un look più professionale.
 * Uso: <Icon name="pin" class="h-4 w-4" />
 */
interface Props {
  name:
    | "pin"
    | "film"
    | "sparkle"
    | "map"
    | "search"
    | "star"
    | "clock"
    | "check"
    | "utensils"
    | "alert"
    | "arrow-right";
  class?: string;
}
const { name, class: cls = "h-4 w-4" } = Astro.props;

const paths: Record<Props["name"], string> = {
  pin: '<path d="M12 21s-7-6.2-7-11a7 7 0 0 1 14 0c0 4.8-7 11-7 11Z"/><circle cx="12" cy="10" r="2.6"/>',
  film: '<rect x="3" y="4" width="18" height="16" rx="2"/><path d="M7 4v16M17 4v16M3 9h4M3 15h4M17 9h4M17 15h4"/>',
  sparkle:
    '<path d="M12 3l1.9 4.9L19 9.8l-5.1 1.9L12 17l-1.9-5.3L5 9.8l5.1-1.9L12 3Z"/>',
  map: '<path d="M9 4 3 6v14l6-2 6 2 6-2V4l-6 2-6-2Z"/><path d="M9 4v14M15 6v14"/>',
  search: '<circle cx="11" cy="11" r="7"/><path d="M21 21l-4.3-4.3"/>',
  star: '<path d="M12 3.5l2.6 5.3 5.9.9-4.2 4.1 1 5.8-5.3-2.8-5.3 2.8 1-5.8L3.5 9.7l5.9-.9L12 3.5Z"/>',
  clock: '<circle cx="12" cy="12" r="9"/><path d="M12 7v5l3.5 2"/>',
  check: '<path d="M20 6 9 17l-5-5"/>',
  utensils:
    '<path d="M4 3v7a2 2 0 0 0 2 2h0v9M8 3v9M6 3v4M20 3s-2 2-2 5 2 3 2 3v10"/>',
  alert:
    '<path d="M12 3 2 20h20L12 3Z"/><path d="M12 10v4M12 17h.01"/>',
  "arrow-right": '<path d="M5 12h14M13 6l6 6-6 6"/>',
};
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.8"
  stroke-linecap="round"
  stroke-linejoin="round"
  class={cls}
  aria-hidden="true"
  set:html={paths[name]}
/>
