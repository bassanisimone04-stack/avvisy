---
/**
 * Mappa interattiva con Leaflet + OpenStreetMap (gratuita, senza API key).
 * Leaflet viene caricato solo lato client, così le altre pagine restano leggere.
 *
 * Passa una lista di `markers` (segnaposto). Ogni marker ha:
 *   { lat, lng, nome, citta, tipo, url }
 */
export interface MapMarker {
  lat: number;
  lng: number;
  nome: string;
  citta?: string;
  tipo?: string;
  url?: string;
  /** "set-reale" | "legato-al-film" | "a-tema-cinema" (sceglie l'icona del pin). */
  categoria?: string;
  chiuso?: boolean;
}

import { useT, type Lang } from "../i18n/ui";

interface Props {
  markers: MapMarker[];
  /** Altezza CSS della mappa (es. "500px" o "70vh"). */
  height?: string;
  /** Livello di zoom iniziale (più alto = più vicino). */
  zoom?: number;
  lang?: Lang;
}

const { markers, height = "500px", zoom = 6, lang = "it" } = Astro.props;
const t = useT(lang);
---

<div
  id="mappa"
  class="cf-map z-0 w-full overflow-hidden rounded-2xl border border-ink-100"
  style={`height:${height}`}
  data-zoom={zoom}
  data-scopri={`${t("card.scopri")} →`}
>
</div>

<!-- I dati dei segnaposto vengono passati come JSON e letti dallo script. -->
<script is:inline type="application/json" id="mappa-dati" set:html={JSON.stringify(markers)} />

<script>
  import L from "leaflet";
  import "leaflet/dist/leaflet.css";
  import "../styles/mappa-tema.css";
  import { caricaBase, disegnaBase, aggiungiTile, pinIcon } from "../lib/mappa-tema";

  const el = document.getElementById("mappa");
  const datiEl = document.getElementById("mappa-dati");

  if (el && datiEl) {
    type Marker = {
      lat: number; lng: number; nome: string; citta?: string; tipo?: string; url?: string;
      categoria?: string; chiuso?: boolean;
    };
    const esc = (v: string) => v.replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;").replace(/"/g, "&quot;");
    const markers: Marker[] = JSON.parse(datiEl.textContent || "[]");
    const zoom = Number(el.dataset.zoom) || 6;
    const scopri = el.dataset.scopri || "Scopri di più →";

    // Stesso tema della mappa principale. Il dettaglio stradale è quello che serve da vicino.
    const map = L.map(el, { preferCanvas: true, minZoom: 5, maxZoom: 18, scrollWheelZoom: false }).setView([41.9, 12.5], zoom);
    aggiungiTile(L, map);
    // Il file dei confini (sfondo da zoom basso) si scarica solo se qualcuno allontana la mappa.
    let baseCaricata = false;
    const caricaSfondo = () => {
      el.classList.toggle("cf-vicino", map.getZoom() >= 9);
      if (baseCaricata || map.getZoom() >= 9) return;
      baseCaricata = true;
      caricaBase().then((b) => disegnaBase(L, map, b, false)).catch(() => { baseCaricata = false; });
    };
    map.on("zoomend", caricaSfondo);
    caricaSfondo();
    map.on("click", () => map.scrollWheelZoom.enable()); // la rotella zooma solo dopo un clic (non blocca lo scroll della pagina)

    const gruppo = L.featureGroup();
    for (const m of markers) {
      const popup = `<div class="cf-card">
        <h3>${esc(m.nome)}</h3>
        ${m.citta || m.tipo ? `<div class="meta">${esc([m.citta, m.tipo].filter(Boolean).join(" · "))}</div>` : ""}
        ${m.url ? `<a class="go" href="${m.url}">${esc(scopri)}</a>` : ""}</div>`;
      L.marker([m.lat, m.lng], { icon: pinIcon(L, m.categoria || "set-reale", !!m.chiuso), title: m.nome, alt: m.nome })
        .bindPopup(popup, { className: "cf-popup", maxWidth: 280 }).addTo(gruppo);
    }
    gruppo.addTo(map);

    // Inquadra automaticamente tutti i segnaposto (se ce n'è più di uno).
    if (markers.length > 1) {
      map.fitBounds(gruppo.getBounds().pad(0.2));
    } else if (markers.length === 1) {
      map.setView([markers[0].lat, markers[0].lng], Math.max(zoom, 14));
    }
    caricaSfondo();
  }
</script>
