---
/**
 * Mappa interattiva con Leaflet + OpenStreetMap (gratuita, senza API key).
 * Leaflet viene caricato solo lato client, così le altre pagine restano leggere.
 *
 * Passa una lista di `markers` (segnaposto). Ogni marker ha:
 *   { lat, lng, nome, citta, tipo, url }
 */
export interface MapMarker {
  lat: number;
  lng: number;
  nome: string;
  citta?: string;
  tipo?: string;
  url?: string;
  /** Opzionali: usati dai filtri della pagina mappa. */
  categoria?: string;
  regione?: string;
  film?: string[];
  chiuso?: boolean;
}

import { useT, type Lang } from "../i18n/ui";

interface Props {
  markers: MapMarker[];
  /** Altezza CSS della mappa (es. "500px" o "70vh"). */
  height?: string;
  /** Livello di zoom iniziale (più alto = più vicino). */
  zoom?: number;
  lang?: Lang;
}

const { markers, height = "500px", zoom = 6, lang = "it" } = Astro.props;
const t = useT(lang);
---

<div
  id="mappa"
  class="z-0 w-full overflow-hidden rounded-2xl border border-ink-100"
  style={`height:${height}`}
  data-zoom={zoom}
  data-scopri={`${t("card.scopri")} →`}
>
</div>

<!-- I dati dei segnaposto vengono passati come JSON e letti dallo script. -->
<script is:inline type="application/json" id="mappa-dati" set:html={JSON.stringify(markers)} />

<script>
  import L from "leaflet";
  import "leaflet/dist/leaflet.css";

  // Corregge il percorso delle icone dei segnaposto quando si usa un bundler.
  import iconUrl from "leaflet/dist/images/marker-icon.png";
  import iconRetinaUrl from "leaflet/dist/images/marker-icon-2x.png";
  import shadowUrl from "leaflet/dist/images/marker-shadow.png";

  // A seconda del bundler, l'import di un'immagine può restituire una
  // stringa (URL) oppure un oggetto { src }. Gestiamo entrambi i casi.
  const toUrl = (m: string | { src: string }) =>
    typeof m === "string" ? m : m.src;

  L.Icon.Default.mergeOptions({
    iconUrl: toUrl(iconUrl),
    iconRetinaUrl: toUrl(iconRetinaUrl),
    shadowUrl: toUrl(shadowUrl),
  });

  const el = document.getElementById("mappa");
  const datiEl = document.getElementById("mappa-dati");

  if (el && datiEl) {
    type Marker = {
      lat: number;
      lng: number;
      nome: string;
      citta?: string;
      tipo?: string;
      url?: string;
      categoria?: string;
      regione?: string;
      film?: string[];
      chiuso?: boolean;
    };
    const markers: Marker[] = JSON.parse(datiEl.textContent || "[]");
    const zoom = Number(el.dataset.zoom) || 6;
    const scopri = el.dataset.scopri || "Scopri di più →";

    // Centro predefinito: Italia.
    const map = L.map(el).setView([41.9, 12.5], zoom);

    L.tileLayer("https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png", {
      attribution:
        '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a>',
      maxZoom: 19,
    }).addTo(map);

    const gruppo = L.featureGroup();
    const esc = (v: string) =>
      v.replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;");
    const layers = markers.map((m) => {
      const popup = `
        <strong>${esc(m.nome)}</strong>
        ${m.citta ? `<br/><span>${esc(m.citta)}</span>` : ""}
        ${m.tipo ? `<br/><span style="text-transform:capitalize">${esc(m.tipo)}</span>` : ""}
        ${m.film && m.film.length ? `<br/><em>${m.film.map(esc).join(", ")}</em>` : ""}
        ${m.url ? `<br/><a href="${m.url}">${scopri}</a>` : ""}
      `;
      return L.marker([m.lat, m.lng]).bindPopup(popup);
    });
    layers.forEach((l) => l.addTo(gruppo));
    gruppo.addTo(map);

    // Inquadra automaticamente tutti i segnaposto (se ce n'è più di uno).
    const inquadra = () => {
      const n = gruppo.getLayers().length;
      if (n > 1) map.fitBounds(gruppo.getBounds().pad(0.2));
      else if (n === 1) {
        const ll = (gruppo.getLayers()[0] as L.Marker).getLatLng();
        map.setView(ll, Math.max(zoom, 14));
      }
    };
    inquadra();

    // Filtri opzionali (presenti solo nella pagina mappa).
    const selCat = document.getElementById("mf-cat") as HTMLSelectElement | null;
    const selReg = document.getElementById("mf-reg") as HTMLSelectElement | null;
    const chkAperti = document.getElementById("mf-aperti") as HTMLInputElement | null;
    const conteggio = document.getElementById("mf-count");
    const reset = document.getElementById("mf-reset");
    const vuoto = document.getElementById("mf-vuoto");
    const applica = () => {
      const cat = selCat?.value || "";
      const reg = selReg?.value || "";
      const soloAperti = !!chkAperti?.checked;
      let visibili = 0;
      markers.forEach((m, i) => {
        const ok =
          (!cat || m.categoria === cat) &&
          (!reg || m.regione === reg) &&
          (!soloAperti || !m.chiuso);
        if (ok) { gruppo.addLayer(layers[i]); visibili++; }
        else gruppo.removeLayer(layers[i]);
      });
      if (conteggio) conteggio.textContent = String(visibili);
      if (vuoto) vuoto.hidden = visibili > 0;
      if (visibili > 0) inquadra();
    };
    [selCat, selReg, chkAperti].forEach((e) => e?.addEventListener("change", applica));
    reset?.addEventListener("click", () => {
      if (selCat) selCat.value = "";
      if (selReg) selReg.value = "";
      if (chkAperti) chkAperti.checked = false;
      applica();
    });
  }
</script>
