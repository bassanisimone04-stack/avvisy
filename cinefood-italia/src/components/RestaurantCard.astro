---
/**
 * Scheda-anteprima di un locale, usata nelle griglie (home, archivi, elenco).
 * L'immagine è ottimizzata da Astro e caricata in "lazy loading".
 */
import { Image } from "astro:assets";
import Badges from "./Badges.astro";
import type { Restaurant } from "../lib/utils";

interface Props {
  locale: Restaurant;
}

const { locale } = Astro.props;
const d = locale.data;
const url = `/locali/${locale.id}`;
// Elenco compatto dei film (max 2) da mostrare in anteprima.
const filmPreview = d.film.slice(0, 2).map((f) => f.titolo);
---

<article
  class="group flex flex-col overflow-hidden rounded-2xl border border-ink-100 bg-white shadow-sm transition-shadow hover:shadow-md"
>
  <a href={url} class="block overflow-hidden">
    <Image
      src={d.immagine}
      alt={d.immagineAlt || d.nome}
      width={640}
      height={427}
      loading="lazy"
      class="aspect-[3/2] w-full object-cover transition-transform duration-300 group-hover:scale-105"
    />
  </a>

  <div class="flex flex-1 flex-col p-4">
    <div class="mb-2 flex flex-wrap items-center gap-1.5">
      <Badges evidenza={d.inEvidenza} />
      <Badges tipo={d.tipo} />
      <Badges prezzo={d.prezzo} />
    </div>

    <h3 class="text-lg font-bold leading-tight text-ink-900">
      <a href={url} class="hover:text-brand-600">{d.nome}</a>
    </h3>

    <p class="mt-0.5 text-sm text-ink-700">
      📍 {d.citta}, {d.regione}
    </p>

    <p class="mt-2 line-clamp-2 text-sm text-ink-700">{d.descrizione}</p>

    {
      filmPreview.length > 0 && (
        <p class="mt-3 text-xs text-ink-700">
          🎬 <span class="font-medium">{filmPreview.join(" · ")}</span>
          {d.film.length > 2 && <span> +{d.film.length - 2}</span>}
        </p>
      )
    }

    <a
      href={url}
      class="mt-4 inline-block text-sm font-semibold text-brand-600 hover:text-brand-700"
    >
      Scopri di più →
    </a>
  </div>
</article>
