---
/**
 * Barra di ricerca con SUGGERIMENTI ISTANTANEI: mentre scrivi mostra un
 * elenco a tendina di locali, film e città che corrispondono, con link diretto.
 * Con Invio (o il pulsante) va all'elenco completo filtrato.
 */
import { useT, path, type Lang } from "../i18n/ui";
import Icon from "./Icon.astro";

interface Item {
  label: string;
  sub: string;
  url: string;
}
interface Props {
  items: Item[];
  lang?: Lang;
}
const { items, lang = "it" } = Astro.props;
const t = useT(lang);
---

<div class="relative mx-auto w-full max-w-xl">
  <form
    action={path("/locali", lang)}
    method="get"
    role="search"
    class="flex w-full items-center gap-2 rounded-full bg-white/95 p-1.5 shadow-2xl ring-1 ring-black/5 backdrop-blur dark:bg-noir-900/90"
  >
    <span class="pl-3 text-ink-400"><Icon name="search" class="h-5 w-5" /></span>
    <label for="suggest-input" class="sr-only">{t("hero.cerca")}</label>
    <input
      id="suggest-input"
      type="search"
      name="cerca"
      placeholder={t("hero.cercaPh")}
      autocomplete="off"
      aria-expanded="false"
      aria-controls="suggest-list"
      class="min-w-0 flex-1 border-0 bg-transparent py-2.5 text-base text-ink-900 placeholder:text-ink-400 focus:outline-none focus:ring-0 dark:text-cream-100"
    />
    <button type="submit" class="shrink-0 rounded-full bg-gold-500 px-6 py-2.5 font-semibold text-noir-950 transition-colors hover:bg-gold-400">
      {t("hero.cerca")}
    </button>
  </form>

  <ul
    id="suggest-list"
    hidden
    class="absolute left-0 right-0 top-full z-30 mt-2 max-h-80 overflow-auto rounded-2xl border border-ink-500/10 bg-white p-1.5 text-left shadow-2xl dark:border-noir-700 dark:bg-noir-900"
  >
  </ul>
</div>

<script type="application/json" id="suggest-data" set:html={JSON.stringify(items)} is:inline></script>

<script>
  type Item = { label: string; sub: string; url: string };
  const dataEl = document.getElementById("suggest-data");
  const input = document.getElementById("suggest-input") as HTMLInputElement | null;
  const list = document.getElementById("suggest-list");
  if (dataEl && input && list) {
    const items: Item[] = JSON.parse(dataEl.textContent || "[]");
    const norm = (s: string) =>
      s.toLowerCase().normalize("NFD").replace(/[̀-ͯ]/g, "");

    function render() {
      const q = norm(input!.value.trim());
      if (q.length < 2) {
        list!.hidden = true;
        input!.setAttribute("aria-expanded", "false");
        return;
      }
      const hits = items
        .filter((it) => norm(it.label + " " + it.sub).includes(q))
        .slice(0, 6);
      if (hits.length === 0) {
        list!.hidden = true;
        input!.setAttribute("aria-expanded", "false");
        return;
      }
      list!.innerHTML = hits
        .map(
          (it) =>
            `<li><a href="${it.url}" class="flex items-center justify-between gap-3 rounded-xl px-3 py-2 text-sm text-ink-800 hover:bg-cream-100 dark:text-cream-100 dark:hover:bg-noir-800"><span class="font-medium">${it.label}</span><span class="shrink-0 text-xs text-ink-400">${it.sub}</span></a></li>`
        )
        .join("");
      list!.hidden = false;
      input!.setAttribute("aria-expanded", "true");
    }

    input.addEventListener("input", render);
    input.addEventListener("focus", render);
    document.addEventListener("click", (e) => {
      if (!list!.contains(e.target as Node) && e.target !== input) list!.hidden = true;
    });
    input.addEventListener("keydown", (e) => {
      if (e.key === "Escape") list!.hidden = true;
    });
  }
</script>
