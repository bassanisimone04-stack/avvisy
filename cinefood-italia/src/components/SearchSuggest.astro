---
/**
 * Barra di ricerca con SUGGERIMENTI ISTANTANEI: mentre scrivi mostra un
 * elenco a tendina di locali, film e città che corrispondono, con link diretto.
 * Con Invio (o il pulsante) va all'elenco completo filtrato.
 */
import { useT, path, type Lang } from "../i18n/ui";
import Icon from "./Icon.astro";

interface Item {
  label: string;
  sub: string;
  url: string;
}
interface Props {
  items: Item[];
  lang?: Lang;
}
const { items, lang = "it" } = Astro.props;
const t = useT(lang);
const L = lang === "en"
  ? { nessuno: "No quick match for", cercaTutti: "Search all venues", risultati: "results", hint: "Use the arrow keys to move through the suggestions" }
  : { nessuno: "Nessun suggerimento per", cercaTutti: "Cerca in tutti i locali", risultati: "risultati", hint: "Usa le frecce per scorrere i suggerimenti" };
const listaHref = path("/locali", lang);
---

<div class="relative mx-auto w-full max-w-xl">
  <form
    action={path("/locali", lang)}
    method="get"
    role="search"
    class="flex w-full items-center gap-2 rounded-full bg-white/95 p-1.5 shadow-2xl ring-1 ring-black/5 backdrop-blur focus-within:ring-2 focus-within:ring-gold-500 dark:bg-noir-900/90"
  >
    <span class="pl-3 text-ink-400"><Icon name="search" class="h-5 w-5" /></span>
    <label for="suggest-input" class="sr-only">{t("hero.cerca")}</label>
    <input
      id="suggest-input"
      type="search"
      name="cerca"
      placeholder={t("hero.cercaPh")}
      autocomplete="off"
      role="combobox"
      aria-autocomplete="list"
      aria-expanded="false"
      aria-controls="suggest-list"
      class="min-w-0 flex-1 border-0 bg-transparent py-2.5 text-base text-ink-900 placeholder:text-ink-400 focus:outline-none focus:ring-0 focus-visible:outline-none dark:text-cream-100"
    />
    <button type="submit" class="shrink-0 rounded-full bg-gold-500 px-6 py-2.5 font-semibold text-noir-950 transition-colors hover:bg-gold-400">
      {t("hero.cerca")}
    </button>
  </form>

  <ul
    id="suggest-list"
    role="listbox"
    aria-label={L.hint}
    data-nessuno={L.nessuno}
    data-cerca-tutti={L.cercaTutti}
    data-lista={listaHref}
    hidden
    class="absolute left-0 right-0 top-full z-30 mt-2 max-h-80 overflow-auto rounded-2xl border border-ink-500/10 bg-white p-1.5 text-left shadow-2xl dark:border-noir-700 dark:bg-noir-900"
  >
  </ul>
</div>

<script type="application/json" id="suggest-data" set:html={JSON.stringify(items)} is:inline></script>

<script>
  type Item = { label: string; sub: string; url: string };
  const dataEl = document.getElementById("suggest-data");
  const input = document.getElementById("suggest-input") as HTMLInputElement | null;
  const list = document.getElementById("suggest-list");
  if (dataEl && input && list) {
    const items: Item[] = JSON.parse(dataEl.textContent || "[]");
    const norm = (s: string) =>
      s.toLowerCase().normalize("NFD").replace(/[̀-ͯ]/g, "");

    let attivo = -1;
    const links = () => Array.from(list!.querySelectorAll<HTMLAnchorElement>("a[data-opt]"));
    function imposta(i: number) {
      const ls = links();
      attivo = ls.length ? (i + ls.length) % ls.length : -1;
      ls.forEach((a, k) => {
        a.classList.toggle("bg-cream-100", k === attivo);
        a.classList.toggle("dark:bg-noir-800", k === attivo);
        a.setAttribute("aria-selected", String(k === attivo));
      });
      if (attivo >= 0) input!.setAttribute("aria-activedescendant", ls[attivo].id);
      else input!.removeAttribute("aria-activedescendant");
    }
    function chiudi() {
      list!.hidden = true;
      attivo = -1;
      input!.setAttribute("aria-expanded", "false");
      input!.removeAttribute("aria-activedescendant");
    }

    function render() {
      const raw = input!.value.trim();
      const q = norm(raw);
      if (q.length < 2) { chiudi(); return; }
      const hits = items
        .filter((it) => norm(it.label + " " + it.sub).includes(q))
        .slice(0, 6);
      const esc = (s: string) => s.replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/"/g, "&quot;");
      if (hits.length === 0) {
        const href = `${list!.dataset.lista}?cerca=${encodeURIComponent(raw)}`;
        list!.innerHTML = `<li role="presentation"><p class="px-3 py-2 text-sm text-ink-600 dark:text-cream-200">${list!.dataset.nessuno} «${esc(raw)}».</p><a data-opt id="sg-opt-0" role="option" href="${href}" class="block rounded-xl px-3 py-2 text-sm font-semibold text-gold-600 hover:bg-cream-100 dark:text-gold-400 dark:hover:bg-noir-800">${list!.dataset.cercaTutti} →</a></li>`;
        list!.hidden = false;
        input!.setAttribute("aria-expanded", "true");
        attivo = -1;
        return;
      }
      list!.innerHTML = hits
        .map(
          (it, k) =>
            `<li role="presentation"><a data-opt id="sg-opt-${k}" role="option" href="${it.url}" class="flex items-center justify-between gap-3 rounded-xl px-3 py-2 text-sm text-ink-800 hover:bg-cream-100 dark:text-cream-100 dark:hover:bg-noir-800"><span class="font-semibold">${esc(it.label)}</span><span class="text-xs text-ink-500 dark:text-ink-400">${esc(it.sub)}</span></a></li>`
        )
        .join("");
      list!.hidden = false;
      attivo = -1;
      input!.setAttribute("aria-expanded", "true");
    }

    input.addEventListener("input", render);
    input.addEventListener("focus", render);
    document.addEventListener("click", (e) => {
      if (!list!.contains(e.target as Node) && e.target !== input) chiudi();
    });
    input.addEventListener("keydown", (e) => {
      if (e.key === "Escape") { chiudi(); return; }
      if (list!.hidden) return;
      if (e.key === "ArrowDown") { e.preventDefault(); imposta(attivo + 1); }
      else if (e.key === "ArrowUp") { e.preventDefault(); imposta(attivo - 1); }
      else if (e.key === "Enter" && attivo >= 0) { e.preventDefault(); links()[attivo]?.click(); }
    });
  }
</script>
