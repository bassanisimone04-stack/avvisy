---
/** Scheda-anteprima di un locale. `lang` per la lingua. */
import { Image } from "astro:assets";
import { getEntries } from "astro:content";
import Badges from "./Badges.astro";
import Icon from "./Icon.astro";
import type { Restaurant } from "../lib/utils";
import { useT, path, type Lang } from "../i18n/ui";
import { tLocaleDesc, tFilmTitolo, tCitta } from "../i18n/content-en";

interface Props {
  locale: Restaurant;
  lang?: Lang;
}
const { locale, lang = "it" } = Astro.props;
const d = locale.data;
const t = useT(lang);
const url = path(`/locale/${locale.id}`, lang);
const descrizione = tLocaleDesc(locale, lang);
const cittaEn = tCitta(d.citta, lang);

const filmEntries = await getEntries(d.film.map((f) => f.film));
const filmTitoli = filmEntries
  .filter(Boolean)
  .map((f) => tFilmTitolo(f, lang));
---

<article
  class="group flex h-full flex-col overflow-hidden rounded-3xl border border-ink-500/10 bg-white shadow-sm ring-1 ring-transparent transition-all duration-300 hover:-translate-y-1 hover:shadow-xl hover:ring-gold-500/30 dark:border-noir-700 dark:bg-noir-900"
>
  <a href={url} class="relative block overflow-hidden">
    <Image
      src={d.immagine}
      alt={d.immagineAlt || d.nome}
      width={640}
      height={427}
      densities={[1, 2]}
      quality={85}
      loading="lazy"
      class="aspect-[3/2] w-full object-cover transition-transform duration-500 group-hover:scale-105"
    />
    <div class="absolute inset-0 overlay-bottom opacity-70"></div>
    <div class="absolute left-3 top-3 flex flex-wrap gap-1.5">
      <Badges evidenza={d.inEvidenza} lang={lang} onImage />
      <Badges categoria={d.categoria} lang={lang} onImage />
    </div>
  </a>

  <div class="flex flex-1 flex-col p-5">
    <div class="mb-2 flex flex-wrap items-center gap-1.5">
      <Badges tipo={d.tipo} lang={lang} />
      <Badges prezzo={d.prezzo} lang={lang} />
    </div>

    <h3 class="font-display text-xl font-bold leading-tight">
      <a href={url} class="transition-colors hover:text-gold-600 dark:hover:text-gold-400">
        {d.nome}
      </a>
    </h3>
    <p class="mt-1 inline-flex items-center gap-1 text-sm text-ink-500 dark:text-ink-400"><Icon name="pin" class="h-3.5 w-3.5" /> {cittaEn}, {d.regione}</p>
    <p class="mt-2 line-clamp-2 text-sm text-ink-600 dark:text-ink-400">{descrizione}</p>

    {
      filmTitoli.length > 0 && (
        <p class="mt-3 inline-flex items-center gap-1 text-xs text-ink-500 dark:text-ink-400">
          <Icon name="film" class="h-3.5 w-3.5 shrink-0" /> <span class="font-medium text-ink-700 dark:text-cream-200">{filmTitoli.slice(0, 2).join(" · ")}</span>
          {filmTitoli.length > 2 && <span> +{filmTitoli.length - 2}</span>}
        </p>
      )
    }

    <a
      href={url}
      class="mt-4 inline-flex items-center gap-1 text-sm font-semibold text-gold-600 transition-colors hover:text-gold-500 dark:text-gold-400"
    >
      {t("card.scopri")} <span aria-hidden="true">→</span>
    </a>
  </div>
</article>
