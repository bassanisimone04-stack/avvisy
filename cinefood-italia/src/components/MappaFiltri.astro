---
/** Filtri della mappa (categoria, regione, solo aperti). Lo script vive in Map.astro. */
import type { Lang } from "../i18n/ui";
import { tRegione } from "../lib/mappa-content";

interface Props { lang?: Lang; regioni: string[]; totale: number }
const { lang = "it", regioni, totale } = Astro.props;
const L = lang === "en"
  ? { cat: "Category", tutte: "All", reale: "Real filming location", legato: "Film-related", reg: "Region", tutteReg: "All regions", aperti: "Open venues only", reset: "Reset", mostrati: "venues shown", vuoto: "No venue matches these filters." }
  : { cat: "Categoria", tutte: "Tutte", reale: "Location reale", legato: "Legato al film", reg: "Regione", tutteReg: "Tutte le regioni", aperti: "Solo locali aperti", reset: "Azzera", mostrati: "locali mostrati", vuoto: "Nessun locale corrisponde ai filtri." };
const cls = "mt-1 w-full rounded-xl border border-ink-500/20 bg-white px-3 py-2 text-sm dark:border-noir-700 dark:bg-noir-900";
---

<div class="grid gap-4 rounded-2xl border border-ink-500/10 bg-white p-4 sm:grid-cols-2 lg:grid-cols-[1fr_1fr_auto_auto] lg:items-end dark:border-noir-700 dark:bg-noir-900">
  <label class="text-sm font-semibold">{L.cat}
    <select id="mf-cat" class={cls}>
      <option value="">{L.tutte}</option>
      <option value="set-reale">{L.reale}</option>
      <option value="legato-al-film">{L.legato}</option>
    </select>
  </label>
  <label class="text-sm font-semibold">{L.reg}
    <select id="mf-reg" class={cls}>
      <option value="">{L.tutteReg}</option>
      {regioni.map((r) => <option value={r}>{tRegione(r, lang)}</option>)}
    </select>
  </label>
  <label class="flex items-center gap-2 pb-2 text-sm font-semibold">
    <input id="mf-aperti" type="checkbox" class="h-4 w-4 accent-gold-500" /> {L.aperti}
  </label>
  <div class="flex items-center gap-3 pb-1 text-sm">
    <span><strong id="mf-count">{totale}</strong> {L.mostrati}</span>
    <button id="mf-reset" type="button" class="font-semibold text-gold-600 underline dark:text-gold-400">{L.reset}</button>
  </div>
</div>
<p id="mf-vuoto" hidden class="mt-3 text-sm text-ink-500 dark:text-ink-400">{L.vuoto}</p>
