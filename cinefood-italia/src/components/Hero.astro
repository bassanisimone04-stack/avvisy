---
/** Hero a tutto schermo con immagine di sfondo, titolo, ricerca e CTA mappa. */
import { Image } from "astro:assets";
import SearchBar from "./SearchBar.astro";
import SearchSuggest from "./SearchSuggest.astro";
import heroImg from "../assets/placeholder/hero.jpg";
import { useT, path, type Lang } from "../i18n/ui";

interface Props {
  titolo: string;
  sottotitolo: string;
  stats?: { valore: number | string; label: string }[];
  lang?: Lang;
  /** Elenco per i suggerimenti istantanei della ricerca (opzionale). */
  suggestItems?: { label: string; sub: string; url: string }[];
}
const { titolo, sottotitolo, stats = [], lang = "it", suggestItems } = Astro.props;
const t = useT(lang);
---

<section class="relative isolate flex min-h-[88vh] items-center overflow-hidden">
  <Image
    src={heroImg}
    alt=""
    width={1920}
    height={1080}
    loading="eager"
    fetchpriority="high"
    class="hero-zoom absolute inset-0 -z-10 h-full w-full object-cover"
  />
  <div class="absolute inset-0 -z-10 bg-gradient-to-b from-noir-950/25 via-transparent to-noir-950/45"></div>

  <div class="mx-auto w-full max-w-4xl px-4 py-20 text-center [text-shadow:_0_2px_16px_rgba(0,0,0,0.55)]">
    <p class="mb-4 text-sm font-semibold uppercase tracking-[0.3em] text-gold-300">
      🎬 {t("hero.kicker")}
    </p>
    <h1 class="font-display text-5xl font-extrabold leading-[1.05] text-white sm:text-6xl md:text-7xl">
      {titolo}
    </h1>
    <p class="mx-auto mt-5 max-w-2xl text-lg text-cream-100">{sottotitolo}</p>

    <div class="mt-8 flex flex-col items-center gap-4">
      {suggestItems && suggestItems.length > 0 ? (
        <SearchSuggest items={suggestItems} lang={lang} />
      ) : (
        <SearchBar variant="hero" lang={lang} />
      )}
      <a
        href={path("/mappa", lang)}
        class="inline-flex items-center gap-2 rounded-full border border-white/25 px-6 py-2.5 text-sm font-semibold text-white transition-colors hover:bg-white/10"
      >
        🗺️ {t("hero.mappa")}
      </a>
    </div>

    {
      stats.length > 0 && (
        <div class="mt-10 flex flex-wrap justify-center gap-x-10 gap-y-3 text-sm text-cream-200">
          {stats.map((s) => (
            <span>
              <strong class="font-display text-2xl text-gold-400">{s.valore}</strong>{" "}
              {s.label}
            </span>
          ))}
        </div>
      )
    }
  </div>

  <div class="absolute inset-x-0 bottom-0 h-24 bg-gradient-to-t from-cream-50 to-transparent dark:from-noir-950"></div>
</section>
