---
/** FAQ della homepage (IT/EN). I dati strutturati FAQPage si passano via jsonLd nella pagina. */
import type { Lang } from "../i18n/ui";
import { path } from "../i18n/ui";
import { faqHome } from "../lib/home-faq";

interface Props { lang?: Lang; stat: { locali: number; film: number; citta: number } }
const { lang = "it", stat } = Astro.props;
const faq = faqHome(lang, stat);
const T = lang === "en"
  ? { tit: "Frequently asked questions", sub: "How the directory works and how to use it to plan a trip.", cta: "Browse all venues" }
  : { tit: "Domande frequenti", sub: "Come funziona la directory e come usarla per organizzare un viaggio.", cta: "Sfoglia tutti i locali" };
---

<section class="mx-auto max-w-3xl px-4 py-16">
  <h2 class="font-display text-3xl font-bold">{T.tit}</h2>
  <p class="mt-2 text-ink-600 dark:text-ink-400">{T.sub}</p>
  <div class="mt-6 space-y-3">
    {faq.map((f) => (
      <details class="group rounded-2xl border border-ink-500/10 bg-white p-5 dark:border-noir-700 dark:bg-noir-900">
        <summary class="cursor-pointer list-none font-semibold marker:hidden">
          <span class="flex items-center justify-between gap-3">
            {f.domanda}
            <span class="text-gold-500 transition-transform group-open:rotate-45" aria-hidden="true">+</span>
          </span>
        </summary>
        <p class="mt-3 text-ink-700 dark:text-cream-200" set:html={f.risposta} />
      </details>
    ))}
  </div>
  <p class="mt-6">
    <a href={path("/locali", lang)} class="font-semibold text-gold-600 underline dark:text-gold-400">{T.cta} →</a>
  </p>
</section>
