---
/**
 * Layout di base condiviso da tutte le pagine. `lang` per la lingua.
 */
import { SITE } from "../config/site";
import SEO from "../components/SEO.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import Analytics from "../components/Analytics.astro";
import VercelAnalytics from "@vercel/analytics/astro";
import CookieBanner from "../components/CookieBanner.astro";
import { useT, type Lang } from "../i18n/ui";
import "../styles/global.css";
import "@fontsource-variable/inter";
import "@fontsource/playfair-display/600.css";
import "@fontsource/playfair-display/700.css";
import "@fontsource/playfair-display/800.css";

interface Props {
  title?: string;
  description?: string;
  image?: string;
  type?: "website" | "article";
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
  lang?: Lang;
}

const { title, description, image, type, jsonLd, lang = "it" } = Astro.props;
const t = useT(lang);
---

<!doctype html>
<html lang={lang} class="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <script is:inline>
      (function () {
        try {
          var tm = localStorage.getItem("tema");
          if (tm === "light") document.documentElement.classList.remove("dark");
          else document.documentElement.classList.add("dark");
        } catch (e) {
          document.documentElement.classList.add("dark");
        }
      })();
    </script>
    {/* Rilevamento lingua del browser su TUTTE le pagine italiane:
        i visitatori non italiani vengono portati alla stessa pagina in inglese.
        La scelta manuale (clic sulla bandiera) viene sempre rispettata. */}
    <script is:inline>
      (function () {
        try {
          var p = location.pathname;
          if (p === "/en" || p.indexOf("/en/") === 0) return; // già in inglese
          if (localStorage.getItem("cinefood-lang")) return; // scelta salvata
          var l = (navigator.language || "").toLowerCase();
          if (l && l.indexOf("it") !== 0) {
            var dest = (p === "/" ? "/en/" : "/en" + p) + location.search;
            location.replace(dest);
          }
        } catch (e) {}
      })();
    </script>
    <SEO title={title} description={description} image={image} type={type} jsonLd={jsonLd} lang={lang} />
    <Analytics />
    <VercelAnalytics />
  </head>
  <body class="flex min-h-screen flex-col">
    <a
      href="#contenuto"
      class="sr-only focus:not-sr-only focus:absolute focus:left-2 focus:top-2 focus:z-50 focus:rounded focus:bg-white focus:px-3 focus:py-2 focus:text-ink-900"
    >
      {t("a11y.skip")}
    </a>
    <Header lang={lang} />
    <main id="contenuto" class="flex-1">
      <slot />
    </main>
    <Footer lang={lang} />
    <CookieBanner lang={lang} />
  </body>
</html>
