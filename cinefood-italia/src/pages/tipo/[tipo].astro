---
/** Archivio dei locali di un singolo tipo (ristoranti / bar / caffè...). */
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import LocaleCard from "../../components/LocaleCard.astro";
import Breadcrumb from "../../components/Breadcrumb.astro";
import Reveal from "../../components/Reveal.astro";
import { ordinaLocali, tipiUnici, slugify } from "../../lib/utils";

export async function getStaticPaths() {
  const locali = await getCollection("restaurants");
  return tipiUnici(locali).map((tipo) => ({
    params: { tipo: slugify(tipo) },
    props: { tipo, locali: ordinaLocali(locali.filter((l) => l.data.tipo === tipo)) },
  }));
}

const { tipo, locali } = Astro.props;
const plurale: Record<string, string> = {
  ristorante: "Ristoranti", trattoria: "Trattorie", bar: "Bar",
  caffè: "Caffè", pasticceria: "Pasticcerie", pizzeria: "Pizzerie",
};
const titolo = plurale[tipo] ?? tipo;
const crumbs = [{ name: "Home", href: "/" }, { name: "Locali", href: "/locali" }, { name: titolo }];
---

<BaseLayout title={`${titolo} del cinema`} description={`${titolo} nei film e nelle serie TV: ${locali.length} locali con indirizzo, scena e film collegato. Scegli dove mangiare come sullo schermo.`}>
  <section class="mx-auto max-w-6xl px-4 py-10">
    <Breadcrumb items={crumbs} />
    <h1 class="mt-3 font-display text-4xl font-extrabold capitalize">{titolo} al cinema</h1>
    <p class="mt-2 text-ink-600 dark:text-ink-400">{locali.length} locali di questo tipo nella directory.</p>
    <div class="mt-8 grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {locali.map((locale, i) => <Reveal delay={i * 60}><LocaleCard locale={locale} heading="h2" /></Reveal>)}
    </div>
  </section>
</BaseLayout>
