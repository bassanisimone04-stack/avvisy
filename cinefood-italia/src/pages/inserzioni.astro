---
/** Pagina "Inserzioni / Pubblicità" per i ristoratori (monetizzazione). */
import BaseLayout from "../layouts/BaseLayout.astro";
import { SITE } from "../config/site";

const piani = [
  { nome: "Base", prezzo: "Gratis", evidenza: false, voci: ["Scheda del locale nella directory", "Foto e descrizione", "Collegamento ai film", "Presenza sulla mappa"] },
  { nome: "In evidenza", prezzo: "su richiesta", evidenza: true, voci: ["Tutto del piano Base", "Badge “In evidenza”", "Posizione prioritaria in home", "Link diretto alla prenotazione"] },
  { nome: "Partner", prezzo: "su richiesta", evidenza: false, voci: ["Tutto del piano In evidenza", "Articolo dedicato sul blog", "Condivisione sui social", "Report periodico delle visite"] },
];
---

<BaseLayout title="Inserzioni e pubblicità" description={`Metti in evidenza il tuo ristorante su ${SITE.name}. Scopri i piani per i ristoratori.`}>
  <section class="mx-auto max-w-5xl px-4 py-12">
    <div class="text-center">
      <h1 class="font-display text-4xl font-extrabold">Fai brillare il tuo locale</h1>
      <p class="mx-auto mt-3 max-w-2xl text-lg text-ink-700 dark:text-cream-200">Sei un ristoratore? Raggiungi migliaia di appassionati di cinema e cucina. Ecco come mettere in luce il tuo locale su {SITE.name}.</p>
    </div>

    <div class="mt-10 grid gap-6 md:grid-cols-3">
      {
        piani.map((p) => (
          <div class:list={["flex flex-col rounded-3xl border bg-white p-6 dark:bg-noir-900", p.evidenza ? "border-gold-500/50 ring-2 ring-gold-500/30" : "border-ink-500/10 dark:border-noir-700"]}>
            {p.evidenza && <span class="mb-2 inline-block w-fit rounded-full bg-gold-500 px-3 py-0.5 text-xs font-semibold text-noir-950">Più richiesto</span>}
            <h2 class="font-display text-xl font-bold">{p.nome}</h2>
            <p class="mt-1 font-display text-2xl font-extrabold text-gold-600 dark:text-gold-400">{p.prezzo}</p>
            <ul class="mt-4 flex-1 space-y-2 text-sm text-ink-700 dark:text-cream-200">
              {p.voci.map((v) => <li class="flex gap-2"><span class="text-gold-500">✓</span><span>{v}</span></li>)}
            </ul>
            <a href={`mailto:${SITE.email}?subject=Inserzione%20${encodeURIComponent(p.nome)}`} class:list={["mt-6 rounded-full px-5 py-2.5 text-center text-sm font-semibold", p.evidenza ? "bg-gold-500 text-noir-950 hover:bg-gold-400" : "border border-ink-500/25 hover:bg-cream-100 dark:border-noir-600 dark:hover:bg-noir-800"]}>Richiedi informazioni</a>
          </div>
        ))
      }
    </div>

    <div class="mt-10 rounded-3xl border border-ink-500/10 bg-white p-6 text-center dark:border-noir-700 dark:bg-noir-900">
      <h2 class="font-display text-xl font-bold">Hai domande?</h2>
      <p class="mt-2 text-ink-700 dark:text-cream-200">Scrivici a <a class="font-semibold text-gold-600 hover:underline dark:text-gold-400" href={`mailto:${SITE.email}`}>{SITE.email}</a> e troviamo la soluzione adatta al tuo locale.</p>
    </div>
    <p class="mt-6 text-center text-xs text-ink-500 dark:text-ink-400">I prezzi e i piani mostrati sono di esempio e vanno personalizzati.</p>
  </section>
</BaseLayout>
