---
/** Pagina "Inserzioni / Pubblicità" per i ristoratori (monetizzazione). */
import BaseLayout from "../layouts/BaseLayout.astro";
import { SITE } from "../config/site";

const piani = [
  {
    nome: "Base",
    prezzo: "Gratis",
    evidenza: false,
    voci: [
      "Scheda del locale nella directory",
      "Foto e descrizione",
      "Collegamento ai film in cui appari",
      "Presenza sulla mappa",
    ],
  },
  {
    nome: "In evidenza",
    prezzo: "su richiesta",
    evidenza: true,
    voci: [
      "Tutto quello del piano Base",
      "Badge “⭐ In evidenza”",
      "Posizione prioritaria in home e negli elenchi",
      "Link diretto alla prenotazione",
    ],
  },
  {
    nome: "Partner",
    prezzo: "su richiesta",
    evidenza: false,
    voci: [
      "Tutto quello del piano In evidenza",
      "Articolo dedicato sul blog",
      "Condivisione sui nostri canali social",
      "Report periodico delle visite",
    ],
  },
];
---

<BaseLayout
  title="Inserzioni e pubblicità"
  description="Metti in evidenza il tuo ristorante su CineFood Italia. Scopri i piani per i ristoratori."
>
  <section class="mx-auto max-w-5xl px-4 py-12">
    <div class="text-center">
      <h1 class="text-3xl font-extrabold text-ink-900">Fai brillare il tuo locale</h1>
      <p class="mx-auto mt-3 max-w-2xl text-lg text-ink-800">
        Sei un ristoratore? Raggiungi migliaia di appassionati di cinema e buona
        cucina. Ecco come possiamo mettere in luce il tuo locale su {SITE.name}.
      </p>
    </div>

    <div class="mt-10 grid gap-6 md:grid-cols-3">
      {
        piani.map((p) => (
          <div
            class:list={[
              "flex flex-col rounded-2xl border bg-white p-6 shadow-sm",
              p.evidenza ? "border-brand-400 ring-2 ring-brand-200" : "border-ink-100",
            ]}
          >
            {p.evidenza && (
              <span class="mb-2 inline-block w-fit rounded-full bg-brand-600 px-3 py-0.5 text-xs font-semibold text-white">
                Più richiesto
              </span>
            )}
            <h2 class="text-xl font-bold text-ink-900">{p.nome}</h2>
            <p class="mt-1 text-2xl font-extrabold text-brand-600">{p.prezzo}</p>
            <ul class="mt-4 flex-1 space-y-2 text-sm text-ink-800">
              {p.voci.map((v) => (
                <li class="flex gap-2">
                  <span class="text-brand-600">✓</span>
                  <span>{v}</span>
                </li>
              ))}
            </ul>
            <a
              href={`mailto:${SITE.email}?subject=Inserzione%20${encodeURIComponent(p.nome)}`}
              class:list={[
                "mt-6 rounded-full px-5 py-2.5 text-center text-sm font-semibold",
                p.evidenza
                  ? "bg-brand-600 text-white hover:bg-brand-700"
                  : "border border-ink-100 text-ink-800 hover:bg-ink-50",
              ]}
            >
              Richiedi informazioni
            </a>
          </div>
        ))
      }
    </div>

    <div class="mt-10 rounded-2xl border border-ink-100 bg-white p-6 text-center">
      <h2 class="text-xl font-bold text-ink-900">Hai domande?</h2>
      <p class="mt-2 text-ink-800">
        Scrivici a
        <a class="font-semibold text-brand-600 hover:underline" href={`mailto:${SITE.email}`}>{SITE.email}</a>
        e costruiamo insieme la soluzione più adatta al tuo locale.
      </p>
    </div>

    <p class="mt-6 text-center text-xs text-ink-700">
      I prezzi e i piani mostrati sono di esempio e vanno personalizzati.
    </p>
  </section>
</BaseLayout>
