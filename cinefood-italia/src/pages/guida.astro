---
/** Pagina prodotto: "La Guida CineFood Italia" (PDF a pagamento, monetizzazione). */
import { Image } from "astro:assets";
import BaseLayout from "../layouts/BaseLayout.astro";
import { SITE } from "../config/site";
import copertina from "../assets/placeholder/guida-cover-preview.jpg";

const inclusi = [
  "39 locali reali con indirizzo, prezzo e scena del film",
  "Nessun esempio inventato: solo indirizzi verificati uno per uno",
  "4 itinerari pronti (Roma, Napoli e la costa, Sicilia, Nord Italia)",
  "Indice per film per trovare subito il tuo preferito",
  "PDF leggibile su telefono, tablet o stampabile",
];

const faq = [
  { d: "Come ricevo la guida dopo l'acquisto?", r: "Il download parte subito dopo il pagamento, direttamente dalla pagina di checkout, e ricevi anche un'email con il link per riscaricarla quando vuoi." },
  { d: "Su quali dispositivi posso leggerla?", r: "È un PDF standard: si apre su telefono, tablet, computer o si può stampare. Nessuna app richiesta." },
  { d: "Gli indirizzi sono aggiornati?", r: "Sì, sono gli stessi 39 locali che trovi nella directory del sito, con indirizzi e siti ricontrollati a settembre 2026. Orari e disponibilità possono comunque cambiare (due locali, il Café de Paris e La Veranda dell'Hotel Columbus, sono chiusi e indicati come tali): verifica sempre prima di partire." },
];
---

<BaseLayout
  title="La Guida CineFood Italia (PDF)"
  description="Scarica la guida PDF con i 39 locali reali legati ai film e alle serie TV italiane, più 4 itinerari pronti tra Roma, Napoli, Sicilia e Nord Italia."
>
  <section class="mx-auto max-w-5xl px-4 py-12">
    <div class="grid gap-10 md:grid-cols-2 md:items-center">
      <div>
        <span class="inline-block rounded-full bg-gold-400/15 px-3 py-1 text-xs font-semibold text-gold-600 dark:text-gold-400">PDF scaricabile</span>
        <h1 class="mt-3 font-display text-4xl font-extrabold leading-tight sm:text-5xl">La Guida CineFood Italia</h1>
        <p class="mt-4 text-lg text-ink-700 dark:text-cream-200">
          I 39 ristoranti, bar e caffè <strong>realmente esistenti</strong> legati ai film e alle serie TV (31 location di riprese, 8 segnalati come non girati nel film), organizzati per regione, con 4 itinerari pronti per partire. Zero finzione: solo indirizzi veri.
        </p>
        <p class="mt-4 font-display text-3xl font-extrabold text-gold-600 dark:text-gold-400">{SITE.guida.prezzo}</p>
        {
          SITE.guida.checkoutUrl ? (
            <a href={SITE.guida.checkoutUrl} target="_blank" rel="sponsored noopener" class="mt-4 inline-flex items-center gap-2 rounded-full bg-gold-500 px-6 py-3 text-base font-semibold text-noir-950 hover:bg-gold-400">
              Acquista e scarica ora →
            </a>
          ) : (
            <p class="mt-4 inline-flex items-center gap-2 rounded-full border border-ink-500/25 px-6 py-3 text-base font-semibold text-ink-500 dark:border-noir-600 dark:text-ink-400">
              🔜 Disponibile a breve
            </p>
          )
        }
        <p class="mt-3 text-xs text-ink-500 dark:text-ink-400">Pagamento sicuro, download immediato.</p>
      </div>
      <Image src={copertina} alt="Copertina de La Guida CineFood Italia" width={600} height={848} class="mx-auto w-full max-w-xs rounded-2xl shadow-2xl" />
    </div>

    <div class="mt-14 grid gap-6 sm:grid-cols-3">
      <div class="rounded-2xl bg-cream-100 p-5 text-center dark:bg-noir-900">
        <p class="font-display text-3xl font-extrabold text-gold-600 dark:text-gold-400">39</p>
        <p class="text-sm text-ink-600 dark:text-ink-400">Locali reali</p>
      </div>
      <div class="rounded-2xl bg-cream-100 p-5 text-center dark:bg-noir-900">
        <p class="font-display text-3xl font-extrabold text-gold-600 dark:text-gold-400">34</p>
        <p class="text-sm text-ink-600 dark:text-ink-400">Film &amp; serie</p>
      </div>
      <div class="rounded-2xl bg-cream-100 p-5 text-center dark:bg-noir-900">
        <p class="font-display text-3xl font-extrabold text-gold-600 dark:text-gold-400">12</p>
        <p class="text-sm text-ink-600 dark:text-ink-400">Regioni</p>
      </div>
    </div>

    <div class="mt-14">
      <h2 class="font-display text-2xl font-bold">Cosa trovi dentro</h2>
      <ul class="mt-4 space-y-3">
        {inclusi.map((v) => (
          <li class="flex gap-3 text-ink-700 dark:text-cream-200">
            <span class="mt-0.5 text-gold-500">✓</span>
            <span>{v}</span>
          </li>
        ))}
      </ul>
    </div>

    <div class="mt-14">
      <h2 class="font-display text-2xl font-bold">Domande frequenti</h2>
      <div class="mt-4 divide-y divide-ink-500/10 dark:divide-noir-700">
        {faq.map((f) => (
          <details class="group py-3">
            <summary class="cursor-pointer list-none font-semibold marker:content-none">
              <span class="text-gold-600 dark:text-gold-400">▸ </span>{f.d}
            </summary>
            <p class="mt-2 text-ink-600 dark:text-ink-300">{f.r}</p>
          </details>
        ))}
      </div>
    </div>

    <p class="mt-10 text-center text-xs text-ink-500 dark:text-ink-400">
      Guida a scopo informativo e turistico, non sponsorizzata dai locali citati. Orari e disponibilità possono variare: verifica sempre prima di partire.
    </p>
  </section>
</BaseLayout>
