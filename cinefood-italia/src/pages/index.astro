---
/** Homepage-landing: hero, in evidenza, film, città, come funziona, mappa, blog, CTA. */
import { getCollection } from "astro:content";
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import Hero from "../components/Hero.astro";
import LocaleCard from "../components/LocaleCard.astro";
import Carousel from "../components/Carousel.astro";
import FilmChip from "../components/FilmChip.astro";
import CityCard from "../components/CityCard.astro";
import StepCard from "../components/StepCard.astro";
import Reveal from "../components/Reveal.astro";
import Icon from "../components/Icon.astro";
import { SITE } from "../config/site";
import { ordinaLocali, cittaUniche, localiPerCitta, contaLocaliPerFilm, formatData, slugify } from "../lib/utils";
import { websiteJsonLd, faqPageJsonLd } from "../lib/schema-org";
import HomeFaq from "../components/HomeFaq.astro";
import { faqHome } from "../lib/home-faq";

const locali = await getCollection("restaurants");
const films = await getCollection("films");
const blog = (await getCollection("blog"))
  .filter((a) => !a.data.bozza && a.data.lang === "it")
  .sort((a, b) => b.data.dataPubblicazione.getTime() - a.data.dataPubblicazione.getTime())
  .slice(0, 3);

// In evidenza (fallback ai primi se nessuno è in evidenza).
const evidenza = ordinaLocali(locali.filter((l) => l.data.inEvidenza)).slice(0, 6);
const vetrina = evidenza.length > 0 ? evidenza : ordinaLocali(locali).slice(0, 6);

// Film con conteggio locali, ordinati per popolarità.
const conteggi = contaLocaliPerFilm(locali);
const filmOrdinati = [...films].sort(
  (a, b) => (conteggi.get(b.id) ?? 0) - (conteggi.get(a.id) ?? 0)
);

// Città con immagine e conteggio.
const cityImages = import.meta.glob<{ default: ImageMetadata }>("../assets/cities/*.jpg", { eager: true });
const cityImg = (slug: string) => {
  const k = Object.keys(cityImages).find((p) => p.endsWith(`/${slug}.jpg`));
  return k ? cityImages[k].default : undefined;
};
const citta = cittaUniche(locali)
  .map((nome) => ({ nome, slug: slugify(nome), img: cityImg(slugify(nome)), count: localiPerCitta(locali, nome).length }))
  .filter((c) => c.img);

const stats = [
  { valore: locali.length, label: "locali" },
  { valore: citta.length || cittaUniche(locali).length, label: "città" },
  { valore: films.length, label: "film e serie" },
];

// Indice per i suggerimenti istantanei della ricerca (locali + film + città).
const statFaq = { locali: locali.length, film: films.length, citta: cittaUniche(locali).length };
const suggestItems = [
  ...locali.map((l) => ({ label: l.data.nome, sub: `${l.data.citta} · ${l.data.tipo}`, url: `/locale/${l.id}` })),
  ...films.map((f) => ({ label: f.data.titolo, sub: "Film", url: `/film/${f.id}` })),
  ...citta.map((c) => ({ label: c.nome, sub: "Città", url: `/${c.slug}` })),
];
---

<BaseLayout
  title="Ristoranti e location dei film in Italia"
  description={`I ristoranti, bar e caffè italiani veri visti nei film e nelle serie TV: ${locali.length} locali verificati, con indirizzo, scena e mappa. Da Eat Pray Love a Montalbano.`}
  jsonLd={[websiteJsonLd(), faqPageJsonLd(faqHome("it", statFaq).map((f) => ({ domanda: f.domanda, risposta: f.risposta.replace(/<[^>]+>/g, "") })))]}
>
  <Hero
    titolo="Mangia dove nascono i film"
    sottotitolo="La guida ai ristoranti, bar e caffè italiani apparsi al cinema e in TV. Scopri le location reali e prenota il tuo tavolo tra le stelle."
    stats={stats}
    suggestItems={suggestItems}
  />

  <!-- IN EVIDENZA -->
  <section class="mx-auto max-w-6xl px-4 py-14">
    <div class="mb-6 flex items-end justify-between gap-4">
      <div>
        <h2 class="font-display text-3xl font-bold">Locali in evidenza</h2>
        <p class="mt-1 text-ink-600 dark:text-ink-400">Una selezione dei set più iconici da scoprire.</p>
      </div>
      <a href="/locali" class="shrink-0 text-sm font-semibold text-gold-600 hover:text-gold-500 dark:text-gold-400">Vedi tutti →</a>
    </div>
    <Carousel>
      {vetrina.map((l) => (
        <div class="w-[280px] shrink-0 snap-start sm:w-[320px]"><LocaleCard locale={l} /></div>
      ))}
    </Carousel>
  </section>

  <!-- SFOGLIA PER FILM -->
  <section class="border-y border-ink-500/10 bg-cream-100 dark:border-noir-800 dark:bg-noir-900">
    <div class="mx-auto max-w-6xl px-4 py-14">
      <h2 class="font-display text-3xl font-bold">Sfoglia per film</h2>
      <p class="mt-1 text-ink-600 dark:text-ink-400">Dove mangiano i tuoi personaggi preferiti?</p>
      <Reveal class="mt-6 flex flex-wrap gap-3">
        {filmOrdinati.map((f) => <FilmChip slug={f.id} titolo={f.data.titolo} anno={f.data.anno} count={conteggi.get(f.id) ?? 0} />)}
      </Reveal>
    </div>
  </section>

  <!-- SFOGLIA PER CITTÀ -->
  <section class="mx-auto max-w-6xl px-4 py-14">
    <h2 class="font-display text-3xl font-bold">Sfoglia per città</h2>
    <p class="mt-1 text-ink-600 dark:text-ink-400">Roma, Milano, Napoli, Crema, Venezia e altre.</p>
    <div class="mt-6 grid grid-cols-2 gap-5 sm:grid-cols-3 lg:grid-cols-4">
      {citta.map((c, i) => <Reveal delay={i * 60}><CityCard nome={c.nome} slug={c.slug} immagine={c.img!} count={c.count} /></Reveal>)}
    </div>
  </section>

  <!-- COME FUNZIONA -->
  <section class="border-y border-ink-500/10 bg-cream-100 dark:border-noir-800 dark:bg-noir-900">
    <div class="mx-auto max-w-6xl px-4 py-14">
      <h2 class="font-display text-3xl font-bold">Come funziona</h2>
      <div class="mt-8 grid gap-6 md:grid-cols-3">
        <Reveal delay={0}><StepCard numero={1} icona="film" titolo="Scopri il film" testo="Cerca il film o la serie che ami e trova le location gastronomiche reali." /></Reveal>
        <Reveal delay={80}><StepCard numero={2} icona="pin" titolo="Trova il locale" testo="Ristoranti, bar e caffè con indirizzo, mappa e descrizione della scena." /></Reveal>
        <Reveal delay={160}><StepCard numero={3} icona="utensils" titolo="Prenota e vai" testo="Vai sul posto e mangia dove è nato il cinema. Buon appetito!" /></Reveal>
      </div>
    </div>
  </section>

  <!-- CTA MAPPA (link leggero: niente Leaflet in home, la mappa vera vive su /mappa) -->
  <section class="mx-auto max-w-6xl px-4 py-14">
    <a
      href="/mappa"
      class="group flex flex-col items-center gap-6 overflow-hidden rounded-[2rem] border border-ink-500/10 bg-cream-100 px-6 py-12 text-center transition-colors hover:bg-cream-50 dark:border-noir-800 dark:bg-noir-900 dark:hover:bg-noir-800 sm:flex-row sm:justify-between sm:text-left"
    >
      <div>
        <h2 class="inline-flex items-center gap-2 font-display text-3xl font-bold">
          <Icon name="map" class="h-7 w-7 text-gold-500" /> Esplora sulla mappa
        </h2>
        <p class="mt-2 text-ink-600 dark:text-ink-400">
          {locali.length} locali in {citta.length || cittaUniche(locali).length} città, tutti i set del cinema in un colpo d'occhio.
        </p>
      </div>
      <span class="inline-flex shrink-0 items-center gap-2 rounded-full bg-gold-500 px-6 py-3 text-sm font-semibold text-noir-950 transition-transform group-hover:translate-x-1">
        Apri la mappa <Icon name="arrow-right" class="h-4 w-4" />
      </span>
    </a>
  </section>

  <!-- DAL BLOG -->
  {
    blog.length > 0 && (
      <section class="border-t border-ink-500/10 bg-cream-100 dark:border-noir-800 dark:bg-noir-900">
        <div class="mx-auto max-w-6xl px-4 py-14">
          <div class="mb-6 flex items-end justify-between gap-4">
            <h2 class="font-display text-3xl font-bold">Dal blog</h2>
            <a href="/blog" class="shrink-0 text-sm font-semibold text-gold-600 hover:text-gold-500 dark:text-gold-400">Tutti gli articoli →</a>
          </div>
          <div class="grid gap-6 lg:grid-cols-2">
            {/* Articolo in evidenza: immagine grande interattiva */}
            {blog[0] && (
              <a href={`/blog/${blog[0].id}`} class="group relative flex min-h-[340px] items-end overflow-hidden rounded-3xl">
                {blog[0].data.immagine && (
                  <Image src={blog[0].data.immagine} alt={blog[0].data.immagineAlt || blog[0].data.titolo} width={800} height={600} loading="lazy" class="absolute inset-0 h-full w-full object-cover transition-transform duration-700 group-hover:scale-105" />
                )}
                <div class="absolute inset-0 overlay-bottom"></div>
                <div class="relative p-6">
                  <span class="inline-block rounded-full bg-gold-500 px-3 py-0.5 text-xs font-semibold text-noir-950">In primo piano</span>
                  <p class="mt-3 text-xs text-cream-200">{formatData(blog[0].data.dataPubblicazione)}</p>
                  <h3 class="mt-1 font-display text-2xl font-bold text-white transition-colors group-hover:text-gold-300">{blog[0].data.titolo}</h3>
                  <p class="mt-2 line-clamp-2 max-w-xl text-sm text-cream-200">{blog[0].data.descrizione}</p>
                </div>
              </a>
            )}
            {/* Altri due articoli compatti */}
            <div class="grid gap-6">
              {blog.slice(1, 3).map((a) => (
                <a href={`/blog/${a.id}`} class="group flex items-center gap-4 overflow-hidden rounded-3xl border border-ink-500/10 bg-white p-3 dark:border-noir-700 dark:bg-noir-950">
                  {a.data.immagine && (
                    <Image src={a.data.immagine} alt={a.data.immagineAlt || a.data.titolo} width={220} height={220} loading="lazy" class="h-24 w-24 shrink-0 rounded-2xl object-cover transition-transform duration-500 group-hover:scale-105 sm:h-28 sm:w-40" />
                  )}
                  <div class="min-w-0">
                    <p class="text-xs text-ink-500 dark:text-ink-400">{formatData(a.data.dataPubblicazione)}</p>
                    <h3 class="mt-1 font-display text-base font-bold leading-tight group-hover:text-gold-600 dark:group-hover:text-gold-400">{a.data.titolo}</h3>
                    <p class="mt-1 line-clamp-2 text-sm text-ink-600 dark:text-ink-400">{a.data.descrizione}</p>
                  </div>
                </a>
              ))}
            </div>
          </div>
        </div>
      </section>
    )
  }

  <HomeFaq stat={statFaq} />

  <!-- CTA RISTORATORI -->
  <section class="mx-auto max-w-6xl px-4 py-16">
    <div class="relative overflow-hidden rounded-[2rem] bg-noir-900 px-6 py-14 text-center">
      <div class="absolute inset-0 bg-gradient-to-br from-gold-600/25 to-transparent" aria-hidden="true"></div>
      <div class="relative">
        <h2 class="font-display text-3xl font-bold text-white sm:text-4xl">Il tuo locale è stato in un film?</h2>
        <p class="mx-auto mt-3 max-w-xl text-cream-200">Inseriscilo su {SITE.name} e raggiungi migliaia di appassionati di cinema e buona cucina.</p>
        <div class="mt-7 flex flex-wrap justify-center gap-3">
          <a href="/aggiungi-locale" class="rounded-full bg-gold-500 px-6 py-3 text-sm font-semibold text-noir-950 hover:bg-gold-400">Aggiungi il tuo locale</a>
          <a href="/inserzioni" class="rounded-full border border-white/25 px-6 py-3 text-sm font-semibold text-white hover:bg-white/10">Scopri le inserzioni</a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
