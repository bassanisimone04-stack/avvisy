---
/** Homepage: hero con ricerca, locali in evidenza e statistiche. */
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import RestaurantCard from "../components/RestaurantCard.astro";
import { SITE } from "../config/site";
import { ordinaLocali, cittaUniche, filmUnici } from "../lib/utils";
import { websiteJsonLd } from "../lib/schema-org";

const tutti = await getCollection("restaurants");
const inEvidenza = ordinaLocali(tutti.filter((l) => l.data.inEvidenza)).slice(0, 6);
// Se non ci sono locali in evidenza, mostra comunque i primi disponibili.
const vetrina = inEvidenza.length > 0 ? inEvidenza : ordinaLocali(tutti).slice(0, 6);

const nCitta = cittaUniche(tutti).length;
const nFilm = filmUnici(tutti).length;
---

<BaseLayout jsonLd={websiteJsonLd()}>
  <!-- HERO -->
  <section class="relative overflow-hidden bg-ink-900 text-white">
    <div class="absolute inset-0 opacity-20" aria-hidden="true">
      <div class="h-full w-full bg-gradient-to-br from-brand-500 to-ink-900"></div>
    </div>
    <div class="relative mx-auto max-w-4xl px-4 py-16 text-center sm:py-24">
      <p class="mb-3 text-sm font-semibold uppercase tracking-widest text-brand-300">
        🎬 Cinema &amp; buona tavola
      </p>
      <h1 class="text-4xl font-extrabold leading-tight sm:text-5xl">
        {SITE.tagline}
      </h1>
      <p class="mx-auto mt-4 max-w-2xl text-lg text-ink-100">
        Scopri dove hanno mangiato i tuoi personaggi preferiti e prenota il tuo
        tavolo tra le stelle del cinema italiano.
      </p>

      <!-- Ricerca rapida: rimanda a /locali con il testo cercato -->
      <form action="/locali" method="get" class="mx-auto mt-8 flex max-w-xl gap-2">
        <label for="hero-cerca" class="sr-only">Cerca un locale</label>
        <input
          id="hero-cerca"
          type="search"
          name="cerca"
          placeholder="Cerca un locale, una città o un film…"
          class="w-full rounded-full border-0 px-5 py-3 text-ink-900 focus:ring-2 focus:ring-brand-400"
        />
        <button
          type="submit"
          class="shrink-0 rounded-full bg-brand-600 px-6 py-3 font-semibold text-white transition-colors hover:bg-brand-700"
        >
          Cerca
        </button>
      </form>

      <div class="mt-8 flex flex-wrap justify-center gap-x-8 gap-y-2 text-sm text-ink-100">
        <span><strong class="text-white">{tutti.length}</strong> locali</span>
        <span><strong class="text-white">{nCitta}</strong> città</span>
        <span><strong class="text-white">{nFilm}</strong> film e serie</span>
      </div>
    </div>
  </section>

  <!-- LOCALI IN EVIDENZA -->
  <section class="mx-auto max-w-6xl px-4 py-14">
    <div class="mb-6 flex items-end justify-between gap-4">
      <div>
        <h2 class="text-2xl font-bold text-ink-900">Locali in evidenza</h2>
        <p class="mt-1 text-sm text-ink-700">Una selezione dei set più iconici da scoprire.</p>
      </div>
      <a href="/locali" class="shrink-0 text-sm font-semibold text-brand-600 hover:text-brand-700">
        Vedi tutti →
      </a>
    </div>

    <div class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {vetrina.map((locale) => <RestaurantCard locale={locale} />)}
    </div>
  </section>

  <!-- CALL TO ACTION -->
  <section class="mx-auto max-w-6xl px-4 pb-16">
    <div class="grid gap-6 md:grid-cols-3">
      <a href="/mappa" class="rounded-2xl border border-ink-100 bg-white p-6 shadow-sm transition-shadow hover:shadow-md">
        <span class="text-3xl">🗺️</span>
        <h3 class="mt-3 text-lg font-bold">Esplora la mappa</h3>
        <p class="mt-1 text-sm text-ink-700">Trova i locali vicino a te su una mappa interattiva.</p>
      </a>
      <a href="/blog" class="rounded-2xl border border-ink-100 bg-white p-6 shadow-sm transition-shadow hover:shadow-md">
        <span class="text-3xl">📖</span>
        <h3 class="mt-3 text-lg font-bold">Leggi il blog</h3>
        <p class="mt-1 text-sm text-ink-700">Itinerari e curiosità sul cinema e la buona tavola.</p>
      </a>
      <a href="/inserzioni" class="rounded-2xl border border-brand-200 bg-brand-50 p-6 shadow-sm transition-shadow hover:shadow-md">
        <span class="text-3xl">⭐</span>
        <h3 class="mt-3 text-lg font-bold">Sei un ristoratore?</h3>
        <p class="mt-1 text-sm text-ink-700">Metti in evidenza il tuo locale. Scopri le inserzioni.</p>
      </a>
    </div>
  </section>
</BaseLayout>
