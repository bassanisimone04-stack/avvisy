---
/**
 * Pagina "Aggiungi il tuo locale" con form di contatto.
 * Invio gestito da FormHandler (Web3Forms; chiave in src/config/site.ts).
 */
import BaseLayout from "../layouts/BaseLayout.astro";
import { SITE } from "../config/site";

const inputClass =
  "w-full rounded-xl border border-ink-500/20 bg-white px-4 py-2.5 text-sm text-ink-900 dark:border-noir-600 dark:bg-noir-800 dark:text-cream-100";
const labelClass = "mb-1 block text-sm font-medium text-ink-700 dark:text-cream-200";
---

<BaseLayout title="Aggiungi il tuo locale" description="Segnala un ristorante, bar o caffè apparso in un film o serie TV, o richiedi l'inserimento del tuo locale.">
  <section class="mx-auto max-w-2xl px-4 py-12">
    <h1 class="font-display text-4xl font-extrabold">Aggiungi il tuo locale</h1>
    <p class="mt-3 text-lg text-ink-700 dark:text-cream-200">Hai un locale apparso in un film o in una serie TV? Conosci un posto da includere? Compila il form: ti risponderemo al più presto.</p>

    <form data-cf-form name="aggiungi-locale" method="POST" action="/grazie"
      class="mt-8 space-y-4 rounded-3xl border border-ink-500/10 bg-white p-6 dark:border-noir-700 dark:bg-noir-900">
      <input type="hidden" name="form-name" value="aggiungi-locale" />
      <p class="hidden"><label>Non compilare: <input name="bot-field" /></label></p>

      <div class="grid gap-4 sm:grid-cols-2">
        <div><label for="nome" class={labelClass}>Il tuo nome *</label><input id="nome" name="nome" type="text" required class={inputClass} /></div>
        <div><label for="email" class={labelClass}>Email *</label><input id="email" name="email" type="email" required class={inputClass} /></div>
      </div>
      <div class="grid gap-4 sm:grid-cols-2">
        <div><label for="locale" class={labelClass}>Nome del locale *</label><input id="locale" name="locale" type="text" required class={inputClass} /></div>
        <div><label for="citta" class={labelClass}>Città</label><input id="citta" name="citta" type="text" class={inputClass} /></div>
      </div>
      <div><label for="film" class={labelClass}>In quale film / serie appare?</label><input id="film" name="film" type="text" class={inputClass} /></div>
      <div><label for="messaggio" class={labelClass}>Messaggio</label><textarea id="messaggio" name="messaggio" rows="4" class={inputClass}></textarea></div>

      <button type="submit" class="w-full rounded-full bg-gold-500 px-5 py-3 text-sm font-semibold text-noir-950 hover:bg-gold-400 sm:w-auto">Invia la segnalazione</button>
    </form>

    <p class="mt-4 text-sm text-ink-500 dark:text-ink-400">Preferisci scrivere una email? Contattaci a <a class="font-semibold text-gold-600 hover:underline dark:text-gold-400" href={`mailto:${SITE.email}`}>{SITE.email}</a>.</p>
  </section>
</BaseLayout>
