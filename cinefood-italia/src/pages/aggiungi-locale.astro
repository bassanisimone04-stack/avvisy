---
/**
 * Pagina "Aggiungi il tuo locale" con form di contatto.
 *
 * Il form è pronto per NETLIFY FORMS (attributo `data-netlify="true"`):
 * se pubblichi il sito su Netlify, le richieste arrivano automaticamente
 * nella dashboard di Netlify senza scrivere codice.
 * Se usi Vercel o un altro host, puoi sostituirlo con un servizio come
 * Formspree cambiando l'attributo `action` (vedi commento nel README).
 */
import BaseLayout from "../layouts/BaseLayout.astro";
import { SITE } from "../config/site";
---

<BaseLayout
  title="Aggiungi il tuo locale"
  description="Segnala un ristorante, bar o caffè apparso in un film o in una serie TV, oppure richiedi l'inserimento del tuo locale."
>
  <section class="mx-auto max-w-2xl px-4 py-12">
    <h1 class="text-3xl font-extrabold text-ink-900">Aggiungi il tuo locale</h1>
    <p class="mt-3 text-lg text-ink-800">
      Hai un locale apparso in un film o in una serie TV? Conosci un posto che
      dovremmo includere? Compila il form: ti risponderemo al più presto.
    </p>

    <form
      name="aggiungi-locale"
      method="POST"
      data-netlify="true"
      netlify-honeypot="bot-field"
      action="/grazie"
      class="mt-8 space-y-4 rounded-2xl border border-ink-100 bg-white p-6 shadow-sm"
    >
      <!-- Campo nascosto necessario a Netlify Forms -->
      <input type="hidden" name="form-name" value="aggiungi-locale" />
      <!-- Trappola anti-spam (deve restare vuoto) -->
      <p class="hidden">
        <label>Non compilare: <input name="bot-field" /></label>
      </p>

      <div class="grid gap-4 sm:grid-cols-2">
        <div>
          <label for="nome" class="mb-1 block text-sm font-medium text-ink-800">Il tuo nome *</label>
          <input id="nome" name="nome" type="text" required
            class="w-full rounded-xl border border-ink-100 px-4 py-2.5 text-sm" />
        </div>
        <div>
          <label for="email" class="mb-1 block text-sm font-medium text-ink-800">Email *</label>
          <input id="email" name="email" type="email" required
            class="w-full rounded-xl border border-ink-100 px-4 py-2.5 text-sm" />
        </div>
      </div>

      <div class="grid gap-4 sm:grid-cols-2">
        <div>
          <label for="locale" class="mb-1 block text-sm font-medium text-ink-800">Nome del locale *</label>
          <input id="locale" name="locale" type="text" required
            class="w-full rounded-xl border border-ink-100 px-4 py-2.5 text-sm" />
        </div>
        <div>
          <label for="citta" class="mb-1 block text-sm font-medium text-ink-800">Città</label>
          <input id="citta" name="citta" type="text"
            class="w-full rounded-xl border border-ink-100 px-4 py-2.5 text-sm" />
        </div>
      </div>

      <div>
        <label for="film" class="mb-1 block text-sm font-medium text-ink-800">In quale film / serie appare?</label>
        <input id="film" name="film" type="text"
          class="w-full rounded-xl border border-ink-100 px-4 py-2.5 text-sm" />
      </div>

      <div>
        <label for="messaggio" class="mb-1 block text-sm font-medium text-ink-800">Messaggio</label>
        <textarea id="messaggio" name="messaggio" rows="4"
          class="w-full rounded-xl border border-ink-100 px-4 py-2.5 text-sm"></textarea>
      </div>

      <button type="submit"
        class="w-full rounded-full bg-brand-600 px-5 py-3 text-sm font-semibold text-white hover:bg-brand-700 sm:w-auto">
        Invia la segnalazione
      </button>
    </form>

    <p class="mt-4 text-sm text-ink-700">
      Preferisci scrivere una email? Contattaci a
      <a class="font-semibold text-brand-600 hover:underline" href={`mailto:${SITE.email}`}>{SITE.email}</a>.
    </p>
  </section>
</BaseLayout>
