---
/** Pagina di conferma mostrata dopo l'invio di un form. */
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Grazie!" description="Messaggio inviato con successo.">
  <section class="mx-auto max-w-xl px-4 py-20 text-center">
    <p class="text-5xl">✅</p>
    <h1 class="mt-4 text-3xl font-extrabold text-ink-900">Grazie!</h1>
    <p class="mt-3 text-lg text-ink-800">
      Abbiamo ricevuto il tuo messaggio. Ti risponderemo il prima possibile.
    </p>
    <a href="/" class="mt-8 inline-block rounded-full bg-brand-600 px-6 py-3 text-sm font-semibold text-white hover:bg-brand-700">
      Torna alla home
    </a>
  </section>
</BaseLayout>
