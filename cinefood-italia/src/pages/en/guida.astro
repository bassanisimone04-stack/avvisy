---
/** Product page: "The CineFood Italia Guide" (paid PDF, monetization). */
import { Image } from "astro:assets";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { SITE } from "../../config/site";
import copertina from "../../assets/placeholder/guida-cover-preview-en.jpg";

const lang = "en" as const;

const inclusi = [
  "51 real venues with address, price and film scene",
  "No invented examples: only addresses verified one by one",
  "4 ready-made itineraries (Rome, Naples & the coast, Sicily, Northern Italy)",
  "Index by film to find your favourite right away",
  "PDF readable on phone, tablet, or printable",
];

const faq = [
  { d: "How do I get the guide after purchase?", r: "The download starts right after payment, directly from the checkout page, and you also get an email with a link to re-download it anytime." },
  { d: "What devices can I read it on?", r: "It's a standard PDF: opens on phone, tablet, computer, or can be printed. No app required." },
  { d: "Are the addresses up to date?", r: "Yes, they're the same 51 venues you'll find in the site's directory, with addresses and websites rechecked in September 2026. Hours and availability may still change (two venues, Café de Paris and La Veranda dell'Hotel Columbus, are closed and marked as such): always check before you travel." },
];
---

<BaseLayout
  lang={lang}
  title="The CineFood Italia Guide (PDF)"
  description="Download the PDF guide with the 51 real venues linked to Italian films and TV shows, plus 4 ready-made itineraries across Rome, Naples, Sicily and Northern Italy."
>
  <section class="mx-auto max-w-5xl px-4 py-12">
    <div class="grid gap-10 md:grid-cols-2 md:items-center">
      <div>
        <span class="inline-block rounded-full bg-gold-400/15 px-3 py-1 text-xs font-semibold text-gold-600 dark:text-gold-400">Downloadable PDF</span>
        <h1 class="mt-3 font-display text-4xl font-extrabold leading-tight sm:text-5xl">The CineFood Italia Guide</h1>
        <p class="mt-4 text-lg text-ink-700 dark:text-cream-200">
          The 51 <strong>real</strong> restaurants, bars and cafés linked to Italian films and TV shows (43 filming locations, 8 marked as not filmed in the movie), organised by region, with 4 ready-made itineraries. No fiction: only real addresses.
        </p>
        <p class="mt-4 font-display text-3xl font-extrabold text-gold-600 dark:text-gold-400">{SITE.guida.prezzo}</p>
        {
          SITE.guida.checkoutUrl ? (
            <a href={SITE.guida.checkoutUrl} target="_blank" rel="sponsored noopener" class="mt-4 inline-flex items-center gap-2 rounded-full bg-gold-500 px-6 py-3 text-base font-semibold text-noir-950 hover:bg-gold-400">
              Buy and download now →
            </a>
          ) : (
            <p class="mt-4 inline-flex items-center gap-2 rounded-full border border-ink-500/25 px-6 py-3 text-base font-semibold text-ink-500 dark:border-noir-600 dark:text-ink-400">
              🔜 Coming soon
            </p>
          )
        }
        <p class="mt-3 text-xs text-ink-500 dark:text-ink-400">Secure payment, instant download.</p>
      </div>
      <Image src={copertina} alt="Cover of The CineFood Italia Guide" width={600} height={848} class="mx-auto w-full max-w-xs rounded-2xl shadow-2xl" />
    </div>

    <div class="mt-14 grid gap-6 sm:grid-cols-3">
      <div class="rounded-2xl bg-cream-100 p-5 text-center dark:bg-noir-900">
        <p class="font-display text-3xl font-extrabold text-gold-600 dark:text-gold-400">39</p>
        <p class="text-sm text-ink-600 dark:text-ink-400">Real venues</p>
      </div>
      <div class="rounded-2xl bg-cream-100 p-5 text-center dark:bg-noir-900">
        <p class="font-display text-3xl font-extrabold text-gold-600 dark:text-gold-400">37</p>
        <p class="text-sm text-ink-600 dark:text-ink-400">Films &amp; shows</p>
      </div>
      <div class="rounded-2xl bg-cream-100 p-5 text-center dark:bg-noir-900">
        <p class="font-display text-3xl font-extrabold text-gold-600 dark:text-gold-400">12</p>
        <p class="text-sm text-ink-600 dark:text-ink-400">Regions</p>
      </div>
    </div>

    <div class="mt-14">
      <h2 class="font-display text-2xl font-bold">What's inside</h2>
      <ul class="mt-4 space-y-3">
        {inclusi.map((v) => (
          <li class="flex gap-3 text-ink-700 dark:text-cream-200">
            <span class="mt-0.5 text-gold-500">✓</span>
            <span>{v}</span>
          </li>
        ))}
      </ul>
    </div>

    <div class="mt-14">
      <h2 class="font-display text-2xl font-bold">Frequently asked questions</h2>
      <div class="mt-4 divide-y divide-ink-500/10 dark:divide-noir-700">
        {faq.map((f) => (
          <details class="group py-3">
            <summary class="cursor-pointer list-none font-semibold marker:content-none">
              <span class="text-gold-600 dark:text-gold-400">▸ </span>{f.d}
            </summary>
            <p class="mt-2 text-ink-600 dark:text-ink-300">{f.r}</p>
          </details>
        ))}
      </div>
    </div>

    <p class="mt-10 text-center text-xs text-ink-500 dark:text-ink-400">
      Guide for informational and touristic purposes, not sponsored by the venues mentioned. Hours and availability may vary: always check before you travel.
    </p>
  </section>
</BaseLayout>
