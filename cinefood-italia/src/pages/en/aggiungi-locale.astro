---
/** English "Add your venue" page with contact form (Netlify Forms). */
import BaseLayout from "../../layouts/BaseLayout.astro";
import { SITE } from "../../config/site";
import { path } from "../../i18n/ui";
const lang = "en" as const;
const inputClass = "w-full rounded-xl border border-ink-500/20 bg-white px-4 py-2.5 text-sm text-ink-900 dark:border-noir-600 dark:bg-noir-800 dark:text-cream-100";
const labelClass = "mb-1 block text-sm font-medium text-ink-700 dark:text-cream-200";
---

<BaseLayout lang={lang} title="Add your venue" description="Suggest a restaurant, bar or café that appeared in a film or TV series, or request to add your own venue.">
  <section class="mx-auto max-w-2xl px-4 py-12">
    <h1 class="font-display text-4xl font-extrabold">Add your venue</h1>
    <p class="mt-3 text-lg text-ink-700 dark:text-cream-200">Do you own a venue that appeared in a film or TV series? Know a place we should include? Fill in the form: we'll get back to you soon.</p>

    <form name="add-venue" method="POST" data-netlify="true" netlify-honeypot="bot-field" action={path("/grazie", lang)}
      class="mt-8 space-y-4 rounded-3xl border border-ink-500/10 bg-white p-6 dark:border-noir-700 dark:bg-noir-900">
      <input type="hidden" name="form-name" value="add-venue" />
      <p class="hidden"><label>Don't fill this in: <input name="bot-field" /></label></p>

      <div class="grid gap-4 sm:grid-cols-2">
        <div><label for="name" class={labelClass}>Your name *</label><input id="name" name="name" type="text" required class={inputClass} /></div>
        <div><label for="email" class={labelClass}>Email *</label><input id="email" name="email" type="email" required class={inputClass} /></div>
      </div>
      <div class="grid gap-4 sm:grid-cols-2">
        <div><label for="venue" class={labelClass}>Venue name *</label><input id="venue" name="venue" type="text" required class={inputClass} /></div>
        <div><label for="city" class={labelClass}>City</label><input id="city" name="city" type="text" class={inputClass} /></div>
      </div>
      <div><label for="film" class={labelClass}>In which film / series does it appear?</label><input id="film" name="film" type="text" class={inputClass} /></div>
      <div><label for="message" class={labelClass}>Message</label><textarea id="message" name="message" rows="4" class={inputClass}></textarea></div>

      <button type="submit" class="w-full rounded-full bg-gold-500 px-5 py-3 text-sm font-semibold text-noir-950 hover:bg-gold-400 sm:w-auto">Send suggestion</button>
    </form>

    <p class="mt-4 text-sm text-ink-500 dark:text-ink-400">Prefer email? Contact us at <a class="font-semibold text-gold-600 hover:underline dark:text-gold-400" href={`mailto:${SITE.email}`}>{SITE.email}</a>.</p>
  </section>
</BaseLayout>
