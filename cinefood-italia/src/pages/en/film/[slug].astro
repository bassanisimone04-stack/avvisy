---
/** English film detail page with FAQ. */
import { getCollection } from "astro:content";
import { Image } from "astro:assets";
import BaseLayout from "../../../layouts/BaseLayout.astro";
import LocaleCard from "../../../components/LocaleCard.astro";
import Breadcrumb from "../../../components/Breadcrumb.astro";
import Reveal from "../../../components/Reveal.astro";
import Icon from "../../../components/Icon.astro";
import Prosegui from "../../../components/Prosegui.astro";
import { filmCorrelati } from "../../../lib/correlati.ts";
import { SITE } from "../../../config/site";
import { ordinaLocali, localiPerFilm, slugify } from "../../../lib/utils";
import { faqPageJsonLd, breadcrumbJsonLd } from "../../../lib/schema-org";
import { fitTitle, clampDesc } from "../../../lib/seo";
import { ITINERARIO_PER_FILM } from "../../../lib/itinerari";
import { useT, path } from "../../../i18n/ui";
import { tFilmTitolo, tFilmSinossi, tFilmFaq, tCitta, tFilmAlt, tFilmTitoloSeo } from "../../../i18n/content-en";

const lang = "en" as const;
const t = useT(lang);

export async function getStaticPaths() {
  const films = await getCollection("films");
  const locali = await getCollection("restaurants");
  return films.map((film) => ({ params: { slug: film.id }, props: { film, locali: ordinaLocali(localiPerFilm(locali, film.id)) } }));
}

const { film, locali } = Astro.props;
const d = film.data;
const titolo = tFilmTitolo(film, lang);
const sinossi = tFilmSinossi(film, lang);
const faq = tFilmFaq(film, lang);
const cittaFilm = d.citta[0];
const cittaFilmEn = cittaFilm ? tCitta(cittaFilm, lang) : undefined;
const itinerario = ITINERARIO_PER_FILM[film.id];
const tuttiFilm = await getCollection("films");
const tuttiLocali = await getCollection("restaurants");
const correlati = filmCorrelati(film, tuttiFilm, tuttiLocali, 4);

// SEO (Search Console): people search "where was X filmed" / "X filming locations".
const title = fitTitle([
  tFilmTitoloSeo(film, lang),
  `${titolo}: filming locations & where to eat`,
  `${titolo}: real filming locations`,
  `${titolo}: filming locations`,
  titolo,
]);
const description = clampDesc(`Where was ${titolo} (${d.anno}) filmed? Real locations and the restaurants, bars and cafés linked to the film${cittaFilmEn ? ` in ${cittaFilmEn}` : ""}.`);

const crumbs = [
  { name: t("loc.home"), href: path("/", lang) },
  { name: t("nav.film"), href: path("/film", lang) },
  { name: titolo },
];
const jsonLd: Record<string, unknown>[] = [
  breadcrumbJsonLd(crumbs.map((c) => ({ name: c.name, url: new URL(c.href ?? "/", SITE.url).href }))),
];
if (faq.length > 0) jsonLd.push(faqPageJsonLd(faq));
---

<BaseLayout lang={lang} title={title} description={description} image={d.locandina.src} imageWidth={d.locandina.width} imageHeight={d.locandina.height} type="article" jsonLd={jsonLd}>
  <section class="border-b border-ink-500/10 bg-cream-100 dark:border-noir-800 dark:bg-noir-900">
    <div class="mx-auto grid max-w-5xl gap-8 px-4 py-10 md:grid-cols-[240px_1fr]">
      <figure class="mx-auto w-40 md:w-full">
        <Image src={d.locandina} alt={tFilmAlt(film, lang) || titolo} width={480} height={720} loading="eager" fetchpriority="high" class="w-full rounded-2xl object-cover shadow-lg" />
        {d.locandinaTipo === "luogo" && (
          <figcaption class="mt-2 text-center text-xs text-ink-500 dark:text-ink-400">Photo of a filming location</figcaption>
        )}
        {d.locandinaTipo === "illustrativa" && (
          <figcaption class="mt-2 text-center text-xs text-ink-500 dark:text-ink-400">Illustrative photo: not a poster or a still from the film</figcaption>
        )}
        {d.locandinaTipo === "ai" && (
          <figcaption class="mt-2 text-center text-xs text-ink-500 dark:text-ink-400">AI-generated illustration: not a photo or a still from the film</figcaption>
        )}
      </figure>
      <div>
        <Breadcrumb items={crumbs} />
        <p class="mt-3 text-sm font-semibold uppercase tracking-wide text-gold-600 dark:text-gold-400">{d.serieTv ? t("film.serie") : t("film.film")} · {d.anno}</p>
        <h1 class="mt-1 font-display text-4xl font-extrabold sm:text-5xl">{titolo}</h1>
        <p class="mt-2 text-ink-500 dark:text-ink-400">{t("film.regia")} {d.regista}</p>
        <p class="mt-4 text-lg text-ink-700 dark:text-cream-200">{sinossi}</p>
        {cittaFilm && (<a href={path(`/${slugify(cittaFilm)}`, lang)} class="mt-4 inline-flex items-center gap-1.5 text-sm font-semibold text-gold-600 hover:text-gold-500 dark:text-gold-400"><Icon name="pin" class="h-4 w-4" /> {t("film.altriLocali")} {cittaFilmEn} →</a>)}
        {itinerario && (
          <a href={path(`/blog/${itinerario}`, lang)} class="mt-5 flex items-center gap-3 rounded-2xl border border-gold-500/30 bg-gold-500/10 p-4 transition-colors hover:bg-gold-500/15">
            <Icon name="film" class="h-6 w-6 shrink-0 text-gold-500" />
            <span class="text-sm"><strong class="font-semibold">Read the itinerary</strong> — the film's locations and where to eat →</span>
          </a>
        )}
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-4 py-12">
    <h2 class="font-display text-2xl font-bold">{locali.length > 0 ? t("film.legati") : t("film.arrivo")}</h2>
    {
      locali.length > 0 ? (
        <div class="mt-6 grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3">
          {locali.map((locale, i) => (<Reveal delay={i * 60}><LocaleCard locale={locale} lang={lang} /></Reveal>))}
        </div>
      ) : (
        <p class="mt-3 text-ink-500 dark:text-ink-400">{t("film.nessuno")}{" "}<a href={path("/aggiungi-locale", lang)} class="font-semibold text-gold-600 dark:text-gold-400">{t("film.segnala")}</a></p>
      )
    }
  </section>

  {
    faq.length > 0 && (
      <section class="mx-auto max-w-3xl px-4 pb-16">
        <h2 class="font-display text-2xl font-bold">{t("film.faq")}</h2>
        <div class="mt-6 space-y-3">
          {faq.map((f) => (
            <details class="group rounded-2xl border border-ink-500/10 bg-white p-5 dark:border-noir-700 dark:bg-noir-900">
              <summary class="cursor-pointer list-none font-semibold marker:hidden">
                <span class="flex items-center justify-between gap-3">{f.domanda}<span class="text-gold-500 transition-transform group-open:rotate-45" aria-hidden="true">+</span></span>
              </summary>
              <p class="mt-3 text-ink-700 dark:text-cream-200">{f.risposta}</p>
            </details>
          ))}
        </div>
      </section>
    )
  }
  <Prosegui
    lang={lang}
    films={correlati}
    mappaHref={locali[0] ? path(`/mappa#${locali[0].id}`, lang) : path("/mappa", lang)}
    mappaLabel="See the venues on the map"
    cittaHref={cittaFilm ? path(`/${slugify(cittaFilm)}`, lang) : undefined}
    cittaLabel={cittaFilmEn ? `All venues in ${cittaFilmEn}` : undefined}
  />
</BaseLayout>
