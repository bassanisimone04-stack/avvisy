---
/** English "Thank you" page (form confirmation). */
import BaseLayout from "../../layouts/BaseLayout.astro";
import Icon from "../../components/Icon.astro";
import { path } from "../../i18n/ui";
const lang = "en" as const;
---

<BaseLayout lang={lang} title="Thank you!" description="Message sent successfully.">
  <section class="mx-auto max-w-xl px-4 py-24 text-center">
    <span class="mx-auto flex h-16 w-16 items-center justify-center rounded-full bg-green-500/15 text-green-600 dark:text-green-400"><Icon name="check" class="h-8 w-8" /></span>
    <h1 class="mt-4 font-display text-4xl font-extrabold">Thank you!</h1>
    <p class="mt-3 text-lg text-ink-700 dark:text-cream-200">We've received your message. We'll get back to you as soon as possible.</p>
    <a href={path("/", lang)} class="mt-8 inline-block rounded-full bg-gold-500 px-6 py-3 text-sm font-semibold text-noir-950 hover:bg-gold-400">Back to home</a>
  </section>
</BaseLayout>
