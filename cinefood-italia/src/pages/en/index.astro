---
/** English homepage (mirror of the Italian one). */
import { getCollection } from "astro:content";
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import Hero from "../../components/Hero.astro";
import LocaleCard from "../../components/LocaleCard.astro";
import Carousel from "../../components/Carousel.astro";
import FilmChip from "../../components/FilmChip.astro";
import CityCard from "../../components/CityCard.astro";
import StepCard from "../../components/StepCard.astro";
import Reveal from "../../components/Reveal.astro";
import Map from "../../components/Map.astro";
import type { MapMarker } from "../../components/Map.astro";
import { ordinaLocali, cittaUniche, localiPerCitta, contaLocaliPerFilm, formatData, slugify } from "../../lib/utils";
import { websiteJsonLd } from "../../lib/schema-org";
import { useT, path } from "../../i18n/ui";
import { tFilmTitolo, tCitta } from "../../i18n/content-en";

const lang = "en" as const;
const t = useT(lang);

const locali = await getCollection("restaurants");
const films = await getCollection("films");
const blog = (await getCollection("blog"))
  .filter((a) => !a.data.bozza && a.data.lang === "en")
  .sort((a, b) => b.data.dataPubblicazione.getTime() - a.data.dataPubblicazione.getTime())
  .slice(0, 3);

const evidenza = ordinaLocali(locali.filter((l) => l.data.inEvidenza)).slice(0, 6);
const vetrina = evidenza.length > 0 ? evidenza : ordinaLocali(locali).slice(0, 6);

const conteggi = contaLocaliPerFilm(locali);
const filmOrdinati = [...films].sort((a, b) => (conteggi.get(b.id) ?? 0) - (conteggi.get(a.id) ?? 0));

const cityImages = import.meta.glob<{ default: ImageMetadata }>("../../assets/cities/*.jpg", { eager: true });
const cityImg = (slug: string) => {
  const k = Object.keys(cityImages).find((p) => p.endsWith(`/${slug}.jpg`));
  return k ? cityImages[k].default : undefined;
};
const citta = cittaUniche(locali)
  .map((nome) => ({ nome: tCitta(nome, lang), slug: slugify(nome), img: cityImg(slugify(nome)), count: localiPerCitta(locali, nome).length }))
  .filter((c) => c.img);

const markers: MapMarker[] = locali.map((l) => ({
  lat: l.data.coordinate.lat, lng: l.data.coordinate.lng,
  nome: l.data.nome, citta: l.data.citta, tipo: l.data.tipo, url: path(`/locale/${l.id}`, lang),
}));

const stats = [
  { valore: locali.length, label: t("stats.locali") },
  { valore: citta.length || cittaUniche(locali).length, label: t("stats.citta") },
  { valore: films.length, label: t("stats.film") },
];

const suggestItems = [
  ...locali.map((l) => ({ label: l.data.nome, sub: `${tCitta(l.data.citta, lang)} · ${l.data.tipo}`, url: path(`/locale/${l.id}`, lang) })),
  ...films.map((f) => ({ label: tFilmTitolo(f, lang), sub: t("film.film"), url: path(`/film/${f.id}`, lang) })),
  ...citta.map((c) => ({ label: c.nome, sub: t("stats.citta"), url: path(`/${c.slug}`, lang) })),
];
---

<BaseLayout lang={lang} jsonLd={websiteJsonLd()}>
  <Hero titolo={t("hero.titolo")} sottotitolo={t("hero.sottotitolo")} stats={stats} lang={lang} suggestItems={suggestItems} />

  <section class="mx-auto max-w-6xl px-4 py-14">
    <div class="mb-6 flex items-end justify-between gap-4">
      <div>
        <h2 class="font-display text-3xl font-bold">{t("home.evidenzaTitolo")}</h2>
        <p class="mt-1 text-ink-600 dark:text-ink-400">{t("home.evidenzaSub")}</p>
      </div>
      <a href={path("/locali", lang)} class="shrink-0 text-sm font-semibold text-gold-600 hover:text-gold-500 dark:text-gold-400">{t("home.vediTutti")} →</a>
    </div>
    <Carousel>
      {vetrina.map((l) => (
        <div class="w-[280px] shrink-0 snap-start sm:w-[320px]"><LocaleCard locale={l} lang={lang} /></div>
      ))}
    </Carousel>
  </section>

  <section class="border-y border-ink-500/10 bg-cream-100 dark:border-noir-800 dark:bg-noir-900">
    <div class="mx-auto max-w-6xl px-4 py-14">
      <h2 class="font-display text-3xl font-bold">{t("home.perFilmTitolo")}</h2>
      <p class="mt-1 text-ink-600 dark:text-ink-400">{t("home.perFilmSub")}</p>
      <Reveal class="mt-6 flex flex-wrap gap-3">
        {filmOrdinati.map((f) => <FilmChip slug={f.id} titolo={tFilmTitolo(f, lang)} anno={f.data.anno} count={conteggi.get(f.id) ?? 0} lang={lang} />)}
      </Reveal>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-4 py-14">
    <h2 class="font-display text-3xl font-bold">{t("home.perCittaTitolo")}</h2>
    <p class="mt-1 text-ink-600 dark:text-ink-400">{t("home.perCittaSub")}</p>
    <div class="mt-6 grid grid-cols-2 gap-5 sm:grid-cols-3 lg:grid-cols-4">
      {citta.map((c, i) => <Reveal delay={i * 60}><CityCard nome={c.nome} slug={c.slug} immagine={c.img!} count={c.count} lang={lang} /></Reveal>)}
    </div>
  </section>

  <section class="border-y border-ink-500/10 bg-cream-100 dark:border-noir-800 dark:bg-noir-900">
    <div class="mx-auto max-w-6xl px-4 py-14">
      <h2 class="font-display text-3xl font-bold">{t("home.comeTitolo")}</h2>
      <div class="mt-8 grid gap-6 md:grid-cols-3">
        <Reveal delay={0}><StepCard numero={1} icona="film" titolo={t("home.step1t")} testo={t("home.step1d")} /></Reveal>
        <Reveal delay={80}><StepCard numero={2} icona="pin" titolo={t("home.step2t")} testo={t("home.step2d")} /></Reveal>
        <Reveal delay={160}><StepCard numero={3} icona="utensils" titolo={t("home.step3t")} testo={t("home.step3d")} /></Reveal>
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-4 py-14">
    <div class="mb-6 flex items-end justify-between gap-4">
      <div>
        <h2 class="font-display text-3xl font-bold">{t("home.mappaTitolo")}</h2>
        <p class="mt-1 text-ink-600 dark:text-ink-400">{t("home.mappaSub")}</p>
      </div>
      <a href={path("/mappa", lang)} class="shrink-0 text-sm font-semibold text-gold-600 hover:text-gold-500 dark:text-gold-400">{t("home.apriMappa")} →</a>
    </div>
    <Map markers={markers} height="440px" zoom={6} lang={lang} />
  </section>

  {
    blog.length > 0 && (
      <section class="border-t border-ink-500/10 bg-cream-100 dark:border-noir-800 dark:bg-noir-900">
        <div class="mx-auto max-w-6xl px-4 py-14">
          <div class="mb-6 flex items-end justify-between gap-4">
            <h2 class="font-display text-3xl font-bold">{t("home.blogTitolo")}</h2>
            <a href={path("/blog", lang)} class="shrink-0 text-sm font-semibold text-gold-600 hover:text-gold-500 dark:text-gold-400">{t("home.tuttiArticoli")} →</a>
          </div>
          <div class="grid gap-6 lg:grid-cols-2">
            {blog[0] && (
              <a href={path(`/blog/${blog[0].id.replace(/-en$/, "")}`, lang)} class="group relative flex min-h-[340px] items-end overflow-hidden rounded-3xl">
                {blog[0].data.immagine && (
                  <Image src={blog[0].data.immagine} alt={blog[0].data.immagineAlt || blog[0].data.titolo} width={800} height={600} loading="lazy" class="absolute inset-0 h-full w-full object-cover transition-transform duration-700 group-hover:scale-105" />
                )}
                <div class="absolute inset-0 overlay-bottom"></div>
                <div class="relative p-6">
                  <span class="inline-block rounded-full bg-gold-500 px-3 py-0.5 text-xs font-semibold text-noir-950">Featured</span>
                  <p class="mt-3 text-xs text-cream-200">{formatData(blog[0].data.dataPubblicazione, lang)}</p>
                  <h3 class="mt-1 font-display text-2xl font-bold text-white transition-colors group-hover:text-gold-300">{blog[0].data.titolo}</h3>
                  <p class="mt-2 line-clamp-2 max-w-xl text-sm text-cream-200">{blog[0].data.descrizione}</p>
                </div>
              </a>
            )}
            <div class="grid gap-6">
              {blog.slice(1, 3).map((a) => (
                <a href={path(`/blog/${a.id.replace(/-en$/, "")}`, lang)} class="group flex items-center gap-4 overflow-hidden rounded-3xl border border-ink-500/10 bg-white p-3 dark:border-noir-700 dark:bg-noir-950">
                  {a.data.immagine && (
                    <Image src={a.data.immagine} alt={a.data.immagineAlt || a.data.titolo} width={220} height={220} loading="lazy" class="h-24 w-24 shrink-0 rounded-2xl object-cover transition-transform duration-500 group-hover:scale-105 sm:h-28 sm:w-40" />
                  )}
                  <div class="min-w-0">
                    <p class="text-xs text-ink-500 dark:text-ink-400">{formatData(a.data.dataPubblicazione, lang)}</p>
                    <h3 class="mt-1 font-display text-base font-bold leading-tight group-hover:text-gold-600 dark:group-hover:text-gold-400">{a.data.titolo}</h3>
                    <p class="mt-1 line-clamp-2 text-sm text-ink-600 dark:text-ink-400">{a.data.descrizione}</p>
                  </div>
                </a>
              ))}
            </div>
          </div>
        </div>
      </section>
    )
  }

  <section class="mx-auto max-w-6xl px-4 py-16">
    <div class="relative overflow-hidden rounded-[2rem] bg-noir-900 px-6 py-14 text-center">
      <div class="absolute inset-0 bg-gradient-to-br from-gold-600/25 to-transparent" aria-hidden="true"></div>
      <div class="relative">
        <h2 class="font-display text-3xl font-bold text-white sm:text-4xl">{t("home.ctaTitolo")}</h2>
        <p class="mx-auto mt-3 max-w-xl text-cream-200">{t("home.ctaSub")}</p>
        <div class="mt-7 flex flex-wrap justify-center gap-3">
          <a href={path("/aggiungi-locale", lang)} class="rounded-full bg-gold-500 px-6 py-3 text-sm font-semibold text-noir-950 hover:bg-gold-400">{t("home.ctaAggiungi")}</a>
          <a href={path("/inserzioni", lang)} class="rounded-full border border-white/25 px-6 py-3 text-sm font-semibold text-white hover:bg-white/10">{t("home.ctaInserzioni")}</a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
