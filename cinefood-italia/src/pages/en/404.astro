---
/** Pagina di errore 404 (non trovata) — versione inglese. */
import BaseLayout from "../../layouts/BaseLayout.astro";
import Icon from "../../components/Icon.astro";
---

<BaseLayout title="Page not found" description="The page you're looking for doesn't exist." lang="en">
  <section class="mx-auto max-w-xl px-4 py-24 text-center">
    <Icon name="film" class="mx-auto h-16 w-16 text-gold-500" />
    <h1 class="mt-4 font-display text-4xl font-extrabold">Cut! That's a wrap.</h1>
    <p class="mt-3 text-lg text-ink-700 dark:text-cream-200">The page you're looking for doesn't exist or has been moved.</p>
    <div class="mt-8 flex flex-wrap justify-center gap-3">
      <a href="/en" class="rounded-full bg-gold-500 px-6 py-3 text-sm font-semibold text-noir-950 hover:bg-gold-400">Back to home</a>
      <a href="/en/locali" class="rounded-full border border-ink-500/25 px-6 py-3 text-sm font-semibold hover:bg-cream-100 dark:border-noir-600 dark:hover:bg-noir-800">Browse venues</a>
    </div>
  </section>
</BaseLayout>
