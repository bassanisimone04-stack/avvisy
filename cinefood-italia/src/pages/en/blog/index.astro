---
/** English blog index. */
import { getCollection } from "astro:content";
import { Image } from "astro:assets";
import BaseLayout from "../../../layouts/BaseLayout.astro";
import Reveal from "../../../components/Reveal.astro";
import { formatData } from "../../../lib/utils";
import { useT, path } from "../../../i18n/ui";

const lang = "en" as const;
const t = useT(lang);
const articoli = (await getCollection("blog"))
  .filter((a) => !a.data.bozza && a.data.lang === "en")
  .sort((a, b) => b.data.dataPubblicazione.getTime() - a.data.dataPubblicazione.getTime());
const slugOf = (id: string) => id.replace(/-en$/, "");
---

<BaseLayout lang={lang} title={t("blog.titolo")} description={t("blog.sub")}>
  <section class="mx-auto max-w-4xl px-4 py-12">
    <h1 class="font-display text-4xl font-extrabold">{t("blog.titolo")}</h1>
    <p class="mt-2 text-ink-600 dark:text-ink-400">{t("blog.sub")}</p>

    <a href={path("/guida", lang)} class="mt-6 flex flex-col gap-3 rounded-3xl border border-gold-400/30 bg-gold-400/5 p-5 sm:flex-row sm:items-center sm:justify-between">
      <div>
        <p class="font-display text-lg font-bold">📖 The CineFood Italia Guide (PDF)</p>
        <p class="mt-1 text-sm text-ink-600 dark:text-ink-400">17 real venues with 3 ready-made itineraries, to take on your trip.</p>
      </div>
      <span class="inline-block shrink-0 rounded-full bg-gold-500 px-5 py-2 text-sm font-semibold text-noir-950">Discover it →</span>
    </a>

    <div class="mt-8 grid gap-8 sm:grid-cols-2">
      {
        articoli.map((a, i) => (
          <Reveal delay={i * 60}>
            <article class="overflow-hidden rounded-3xl border border-ink-500/10 bg-white dark:border-noir-700 dark:bg-noir-900">
              {a.data.immagine && (
                <a href={path(`/blog/${slugOf(a.id)}`, lang)}>
                  <Image src={a.data.immagine} alt={a.data.immagineAlt || a.data.titolo} width={640} height={360} loading="lazy" class="aspect-video w-full object-cover" />
                </a>
              )}
              <div class="p-5">
                <p class="text-xs text-ink-500 dark:text-ink-400">{formatData(a.data.dataPubblicazione, lang)}</p>
                <h2 class="mt-1 font-display text-lg font-bold"><a href={path(`/blog/${slugOf(a.id)}`, lang)} class="hover:text-gold-600 dark:hover:text-gold-400">{a.data.titolo}</a></h2>
                <p class="mt-2 line-clamp-3 text-sm text-ink-600 dark:text-ink-400">{a.data.descrizione}</p>
                <a href={path(`/blog/${slugOf(a.id)}`, lang)} class="mt-3 inline-block text-sm font-semibold text-gold-600 hover:text-gold-500 dark:text-gold-400">{t("blog.leggi")} →</a>
              </div>
            </article>
          </Reveal>
        ))
      }
    </div>
    {articoli.length === 0 && <p class="mt-8 text-ink-500 dark:text-ink-400">{t("blog.vuoto")}</p>}
  </section>
</BaseLayout>
