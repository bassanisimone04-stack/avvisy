---
/** English venue detail page. */
import { getCollection, getEntries, render } from "astro:content";
import { Image } from "astro:assets";
import BaseLayout from "../../../layouts/BaseLayout.astro";
import Badges from "../../../components/Badges.astro";
import Breadcrumb from "../../../components/Breadcrumb.astro";
import Map from "../../../components/Map.astro";
import { SITE } from "../../../config/site";
import { slugify, formatData } from "../../../lib/utils";
import { restaurantJsonLd, breadcrumbJsonLd } from "../../../lib/schema-org";
import { useT, path } from "../../../i18n/ui";
import { tLocaleDesc, tFilmTitolo, tScena } from "../../../i18n/content-en";

const lang = "en" as const;
const t = useT(lang);

export async function getStaticPaths() {
  const locali = await getCollection("restaurants");
  return locali.map((locale) => ({ params: { slug: locale.id }, props: { locale } }));
}

const { locale } = Astro.props;
const d = locale.data;
const { Content } = await render(locale);
const filmEntries = await getEntries(d.film.map((f) => f.film));

const canonical = new URL(path(`/locale/${locale.id}`, lang), Astro.site ?? SITE.url).href;
const immagineUrl = new URL(d.immagine.src, Astro.site ?? SITE.url).href;

const crumbs = [
  { name: t("loc.home"), href: path("/", lang) },
  { name: t("loc.locali"), href: path("/locali", lang) },
  { name: d.citta, href: path(`/${slugify(d.citta)}`, lang) },
  { name: d.nome },
];
const jsonLd = [
  restaurantJsonLd(locale, filmEntries, canonical, immagineUrl),
  breadcrumbJsonLd(crumbs.map((c) => ({ name: c.name, url: new URL(c.href ?? canonical, Astro.site ?? SITE.url).href }))),
];
const desc = tLocaleDesc(locale, lang);
---

<BaseLayout lang={lang} title={`${d.nome} — ${d.citta}`} description={`${d.nome} in ${d.citta}: ${desc}`} image={d.immagine.src} type="article" jsonLd={jsonLd}>
  <article class="mx-auto max-w-4xl px-4 py-8">
    <Breadcrumb items={crumbs} />

    <Image src={d.immagine} alt={d.immagineAlt || d.nome} width={1200} height={800} loading="eager" class="mt-4 aspect-[3/2] w-full rounded-3xl object-cover shadow-lg" />

    <div class="mt-6 flex flex-wrap items-center gap-2">
      <Badges evidenza={d.inEvidenza} lang={lang} />
      <Badges categoria={d.categoria} lang={lang} />
      <Badges tipo={d.tipo} lang={lang} />
      <Badges prezzo={d.prezzo} lang={lang} />
      <Badges stato={d.stato} lang={lang} />
    </div>
    <h1 class="mt-3 font-display text-4xl font-extrabold sm:text-5xl">{d.nome}</h1>
    <p class="mt-2 text-ink-500 dark:text-ink-400">📍 {d.indirizzo}</p>
    <p class="mt-4 text-lg text-ink-700 dark:text-cream-200">{desc}</p>

    <div class="mt-6 flex flex-wrap gap-3">
      {d.prenotazione && (<a href={d.prenotazione} target="_blank" rel="noopener" class="rounded-full bg-gold-500 px-5 py-2.5 text-sm font-semibold text-noir-950 hover:bg-gold-400">{t("loc.prenota")}</a>)}
      {d.sitoWeb && (<a href={d.sitoWeb} target="_blank" rel="noopener" class="rounded-full border border-ink-500/25 px-5 py-2.5 text-sm font-semibold hover:bg-cream-100 dark:border-noir-600 dark:hover:bg-noir-800">{t("loc.sito")}</a>)}
      <a href={`https://www.openstreetmap.org/?mlat=${d.coordinate.lat}&mlon=${d.coordinate.lng}#map=17/${d.coordinate.lat}/${d.coordinate.lng}`} target="_blank" rel="noopener" class="rounded-full border border-ink-500/25 px-5 py-2.5 text-sm font-semibold hover:bg-cream-100 dark:border-noir-600 dark:hover:bg-noir-800">{t("loc.indicazioni")}</a>
    </div>

    {
      d.galleria.length > 0 && (
        <div class="mt-8 grid grid-cols-2 gap-3 sm:grid-cols-3">
          {d.galleria.map((img) => (<Image src={img} alt={`${d.nome} — photo`} width={400} height={300} loading="lazy" class="aspect-[4/3] w-full rounded-2xl object-cover" />))}
        </div>
      )
    }

    <section class="mt-10">
      <h2 class="font-display text-2xl font-bold">🎬 {t("loc.schermo")}</h2>
      <ul class="mt-4 space-y-4">
        {
          d.film.map((rel) => {
            const film = filmEntries.find((f) => f.id === rel.film.id);
            if (!film) return null;
            return (
              <li class="rounded-3xl border border-ink-500/10 bg-white p-5 dark:border-noir-700 dark:bg-noir-900">
                <div class="flex flex-wrap items-baseline justify-between gap-2">
                  <h3 class="font-display text-lg font-bold">
                    <a href={path(`/film/${film.id}`, lang)} class="hover:text-gold-600 dark:hover:text-gold-400">{tFilmTitolo(film, lang)}</a>
                    <span class="ml-1 text-sm font-normal text-ink-500 dark:text-ink-400">({film.data.anno})</span>
                  </h3>
                  <span class="rounded-full bg-ink-500/15 px-2 py-0.5 text-xs">{film.data.serieTv ? t("film.serie") : t("film.film")}</span>
                </div>
                <p class="mt-1 text-sm text-ink-500 dark:text-ink-400">{t("film.regia")} {film.data.regista}</p>
                <p class="mt-2 text-ink-700 dark:text-cream-200">{tScena(locale.id, rel.film.id, rel.descrizioneScena, lang)}</p>
              </li>
            );
          })
        }
      </ul>
    </section>

    <div class="prose-cinefood mt-8 max-w-none text-ink-700 dark:text-cream-200 [&_h2]:mt-6 [&_h2]:font-display [&_h2]:text-xl [&_h2]:font-bold [&_p]:mt-3">
      <Content />
    </div>

    <section class="mt-10">
      <h2 class="font-display text-2xl font-bold">{t("loc.dove")}</h2>
      <p class="mt-1 text-sm text-ink-500 dark:text-ink-400">{d.indirizzo} — {d.citta}, {d.regione}</p>
      <div class="mt-4">
        <Map markers={[{ lat: d.coordinate.lat, lng: d.coordinate.lng, nome: d.nome, citta: d.citta, tipo: d.tipo }]} height="380px" zoom={15} lang={lang} />
      </div>
    </section>

    <p class="mt-8 text-xs text-ink-500 dark:text-ink-400">{t("loc.aggiornato")}: {formatData(d.ultimoAggiornamento, lang)}. {t("loc.nota")}</p>
  </article>
</BaseLayout>
