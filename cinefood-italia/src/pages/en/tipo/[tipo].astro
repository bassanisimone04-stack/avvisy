---
/** English "by type" archive. */
import { getCollection } from "astro:content";
import BaseLayout from "../../../layouts/BaseLayout.astro";
import LocaleCard from "../../../components/LocaleCard.astro";
import Breadcrumb from "../../../components/Breadcrumb.astro";
import Reveal from "../../../components/Reveal.astro";
import { ordinaLocali, tipiUnici, slugify } from "../../../lib/utils";
import { useT, path } from "../../../i18n/ui";

const lang = "en" as const;
const t = useT(lang);

export async function getStaticPaths() {
  const locali = await getCollection("restaurants");
  return tipiUnici(locali).map((tipo) => ({
    params: { tipo: slugify(tipo) },
    props: { tipo, locali: ordinaLocali(locali.filter((l) => l.data.tipo === tipo)) },
  }));
}

const { tipo, locali } = Astro.props;
const plurale: Record<string, string> = {
  ristorante: "Restaurants", trattoria: "Trattorias", bar: "Bars", caffè: "Cafés", pasticceria: "Pastry shops",
};
const titolo = plurale[tipo] ?? tipo;
const crumbs = [{ name: t("loc.home"), href: path("/", lang) }, { name: t("loc.locali"), href: path("/locali", lang) }, { name: titolo }];
---

<BaseLayout lang={lang} title={`${titolo} ${t("tipo.alCinema")}`} description={`${titolo} in Italy seen in films and TV series. ${locali.length} venues to discover.`}>
  <section class="mx-auto max-w-6xl px-4 py-10">
    <Breadcrumb items={crumbs} />
    <h1 class="mt-3 font-display text-4xl font-extrabold capitalize">{titolo} {t("tipo.alCinema")}</h1>
    <p class="mt-2 text-ink-600 dark:text-ink-400">{locali.length} {t("tipo.diQuesto")}</p>
    <div class="mt-8 grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {locali.map((locale, i) => <Reveal delay={i * 60}><LocaleCard locale={locale} lang={lang} /></Reveal>)}
    </div>
  </section>
</BaseLayout>
