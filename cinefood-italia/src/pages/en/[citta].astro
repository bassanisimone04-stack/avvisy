---
/** English city page (e.g. /en/roma). */
import { getCollection, getEntries } from "astro:content";
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import LocaleCard from "../../components/LocaleCard.astro";
import FilmChip from "../../components/FilmChip.astro";
import Breadcrumb from "../../components/Breadcrumb.astro";
import Reveal from "../../components/Reveal.astro";
import { SITE } from "../../config/site";
import { ordinaLocali, cittaUniche, localiPerCitta, slugify, filmIdsDiLocale } from "../../lib/utils";
import { breadcrumbJsonLd } from "../../lib/schema-org";
import { useT, path } from "../../i18n/ui";
import { tFilmTitolo } from "../../i18n/content-en";

const lang = "en" as const;
const t = useT(lang);

export async function getStaticPaths() {
  const locali = await getCollection("restaurants");
  return cittaUniche(locali).map((citta) => ({
    params: { citta: slugify(citta) },
    props: { citta, locali: ordinaLocali(localiPerCitta(locali, citta)) },
  }));
}

const { citta, locali } = Astro.props;
const regione = locali[0]?.data.regione ?? "";

const cityImages = import.meta.glob<{ default: ImageMetadata }>("../../assets/cities/*.jpg", { eager: true });
const imgKey = Object.keys(cityImages).find((k) => k.endsWith(`/${slugify(citta)}.jpg`));
const cityImg = imgKey ? cityImages[imgKey].default : undefined;

const filmIds = [...new Set(locali.flatMap(filmIdsDiLocale))];
const filmEntries = await getEntries(filmIds.map((id) => ({ collection: "films" as const, id })));

const title = t("citta.titoloSeo").replace("{c}", citta);
const description = `Restaurants, trattorias, bars and cafés in ${citta} seen in films and TV series. ${locali.length} film venues to discover${regione ? ` in ${regione}` : ""}.`;

const crumbs = [
  { name: t("loc.home"), href: path("/", lang) },
  { name: t("loc.locali"), href: path("/locali", lang) },
  { name: citta },
];
const jsonLd = breadcrumbJsonLd(crumbs.map((c) => ({ name: c.name, url: new URL(c.href ?? "/", SITE.url).href })));
---

<BaseLayout lang={lang} title={title} description={description} image={cityImg?.src} jsonLd={jsonLd}>
  <section class="relative isolate overflow-hidden">
    {cityImg && (<Image src={cityImg} alt={citta} width={1600} height={600} loading="eager" class="absolute inset-0 -z-10 h-full w-full object-cover" />)}
    <div class="absolute inset-0 -z-10 bg-gradient-to-t from-noir-950 via-noir-950/70 to-noir-950/40"></div>
    <div class="mx-auto max-w-6xl px-4 py-20">
      <div class="[&_*]:text-cream-200"><Breadcrumb items={crumbs} /></div>
      <h1 class="mt-3 font-display text-5xl font-extrabold text-white sm:text-6xl">{citta}</h1>
      <p class="mt-2 text-lg text-cream-200">{locali.length} {t("citta.conteggio")}{regione ? ` · ${regione}` : ""}</p>
    </div>
  </section>

  {
    filmEntries.length > 0 && (
      <section class="mx-auto max-w-6xl px-4 pt-10">
        <h2 class="font-display text-2xl font-bold">{t("citta.filmDi")} {citta}</h2>
        <div class="mt-4 flex flex-wrap gap-2">
          {filmEntries.map((f) => (<FilmChip slug={f.id} titolo={tFilmTitolo(f, lang)} anno={f.data.anno} lang={lang} />))}
        </div>
      </section>
    )
  }

  <section class="mx-auto max-w-6xl px-4 py-10">
    <h2 class="font-display text-2xl font-bold">{t("citta.localiDi")} {citta}</h2>
    <div class="mt-6 grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {locali.map((locale, i) => (<Reveal delay={i * 60}><LocaleCard locale={locale} lang={lang} /></Reveal>))}
    </div>
  </section>
</BaseLayout>
