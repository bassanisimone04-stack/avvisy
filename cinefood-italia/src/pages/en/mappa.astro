---
/** English map page with filters, venues by region and FAQ. */
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import MapView from "../../components/Map.astro";
import MappaFiltri from "../../components/MappaFiltri.astro";
import MappaInfo from "../../components/MappaInfo.astro";
import type { MapMarker } from "../../components/Map.astro";
import { ordinaLocali } from "../../lib/utils";
import { faqPageJsonLd } from "../../lib/schema-org";
import { faqMappa, statistiche } from "../../lib/mappa-content";
import { useT, path } from "../../i18n/ui";
import { tFilmTitolo } from "../../i18n/content-en";

const lang = "en" as const;
const t = useT(lang);
const locali = ordinaLocali(await getCollection("restaurants"));
const films = new Map((await getCollection("films")).map((f) => [f.id, f]));
const markers: MapMarker[] = locali.map((l) => ({
  lat: l.data.coordinate.lat, lng: l.data.coordinate.lng,
  nome: l.data.nome, citta: l.data.citta, tipo: l.data.tipo, url: path(`/locale/${l.id}`, lang),
  categoria: l.data.categoria, regione: l.data.regione, chiuso: l.data.stato !== "aperto",
  film: l.data.film.map((f) => films.get(f.film.id)).filter(Boolean).map((f) => tFilmTitolo(f!, lang)),
}));
const regioni = [...new Set(locali.map((l) => l.data.regione))].sort((a, b) => a.localeCompare(b, "it"));
const jsonLd = faqPageJsonLd(faqMappa(lang, statistiche(locali)));
---

<BaseLayout
  lang={lang}
  title="Map of Italy's Film & TV Restaurants and Cafés"
  description="Interactive map of the Italian restaurants, bars and cafés seen in films and TV shows: filter by region and category, and see the linked films."
  jsonLd={jsonLd}
>
  <section class="mx-auto max-w-6xl px-4 py-10">
    <h1 class="font-display text-4xl font-extrabold">{t("mappa.titolo")}</h1>
    <p class="mt-2 text-ink-600 dark:text-ink-400">Click a marker for the venue details and linked films. Map based on OpenStreetMap.</p>
    <div class="mt-6"><MappaFiltri lang={lang} regioni={regioni} totale={locali.length} /></div>
    <div class="mt-4"><MapView markers={markers} height="72vh" zoom={6} lang={lang} /></div>
    <MappaInfo lang={lang} locali={locali} />
  </section>
</BaseLayout>
