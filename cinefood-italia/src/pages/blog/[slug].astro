---
/** Pagina di un singolo articolo del blog. */
import { getCollection, render } from "astro:content";
import { Image } from "astro:assets";
import BaseLayout from "../../layouts/BaseLayout.astro";
import Breadcrumb from "../../components/Breadcrumb.astro";
import { SITE } from "../../config/site";
import { formatData } from "../../lib/utils";
import { blogPostingJsonLd, breadcrumbJsonLd, faqPageJsonLd } from "../../lib/schema-org";
import { bookingUrl, getyourguideUrl } from "../../lib/affiliate";

export async function getStaticPaths() {
  const articoli = (await getCollection("blog")).filter((a) => !a.data.bozza && a.data.lang === "it");
  return articoli.map((articolo) => ({ params: { slug: articolo.id }, props: { articolo } }));
}

const { articolo } = Astro.props;
const d = articolo.data;
const { Content } = await render(articolo);

// Articoli correlati: stessa lingua, esclude il corrente, ordina per tag in
// comune poi per data. Migliora link interni e pagine viste.
const correlati = (await getCollection("blog"))
  .filter((a) => !a.data.bozza && a.data.lang === "it" && a.id !== articolo.id)
  .map((a) => ({
    a,
    score: a.data.tags.filter((t) => d.tags.includes(t)).length,
  }))
  .sort((x, y) => y.score - x.score || y.a.data.dataPubblicazione.getTime() - x.a.data.dataPubblicazione.getTime())
  .slice(0, 3)
  .map((x) => x.a);

const canonical = new URL(`/blog/${articolo.id}`, Astro.site ?? SITE.url).href;
const immagineUrl = d.immagine ? new URL(d.immagine.src, Astro.site ?? SITE.url).href : undefined;
const crumbs = [{ name: "Home", href: "/" }, { name: "Blog", href: "/blog" }, { name: d.titolo }];
const jsonLd = [
  blogPostingJsonLd(d.titolo, d.descrizione, d.autore, d.dataPubblicazione, canonical, immagineUrl),
  breadcrumbJsonLd(crumbs.map((c) => ({ name: c.name, url: new URL(c.href ?? "/", SITE.url).href }))),
];
if (d.faq.length > 0) jsonLd.push(faqPageJsonLd(d.faq));
---

<BaseLayout title={d.titolo} description={d.descrizione} image={d.immagine?.src} type="article" jsonLd={jsonLd}>
  <article class="mx-auto max-w-3xl px-4 py-10">
    <Breadcrumb items={crumbs} />
    <p class="mt-4 text-sm text-ink-500 dark:text-ink-400">{formatData(d.dataPubblicazione)} · {d.autore}</p>
    <h1 class="mt-2 font-display text-4xl font-extrabold leading-tight sm:text-5xl">{d.titolo}</h1>
    <p class="mt-3 text-lg text-ink-600 dark:text-ink-400">{d.descrizione}</p>

    {
      d.immagine && (
        <Image src={d.immagine} alt={d.immagineAlt || d.titolo} width={1200} height={675} loading="eager" class="mt-6 aspect-video w-full rounded-3xl object-cover" />
      )
    }

    <div class="mt-8 max-w-none text-lg leading-relaxed text-ink-700 dark:text-cream-200 [&_a]:text-gold-600 [&_a]:underline dark:[&_a]:text-gold-400 [&_blockquote]:border-l-4 [&_blockquote]:border-gold-400 [&_blockquote]:pl-4 [&_blockquote]:text-ink-500 dark:[&_blockquote]:text-ink-400 [&_h2]:mt-8 [&_h2]:font-display [&_h2]:text-2xl [&_h2]:font-bold [&_li]:mt-1 [&_p]:mt-4 [&_ul]:mt-4 [&_ul]:list-disc [&_ul]:pl-6">
      <Content />
    </div>

    {
      d.prenotazioni.length > 0 && (
        <section class="mt-8 rounded-3xl border border-gold-400/30 bg-gold-400/5 p-6 dark:border-gold-400/20">
          <h2 class="font-display text-lg font-bold">📍 Prenota dove hai letto</h2>
          <div class="mt-3 flex flex-wrap gap-3">
            {d.prenotazioni.map((p) => (
              <a
                href={bookingUrl(p.nome, p.citta)}
                target="_blank"
                rel="sponsored noopener"
                class="inline-flex items-center gap-2 rounded-full bg-gold-500 px-4 py-2 text-sm font-semibold text-noir-950 hover:bg-gold-400"
              >
                Prenota {p.nome} su Booking.com →
              </a>
            ))}
          </div>
          <p class="mt-3 text-xs text-ink-500 dark:text-ink-400">
            Link di affiliazione: se prenoti tramite questo link potremmo ricevere una piccola commissione, senza costi aggiuntivi per te.
          </p>
        </section>
      )
    }
    {
      d.esperienze.length > 0 && (
        <section class="mt-8 rounded-3xl border border-gold-400/30 bg-gold-400/5 p-6 dark:border-gold-400/20">
          <h2 class="font-display text-lg font-bold">🎟️ Vivi l'esperienza</h2>
          <div class="mt-3 flex flex-wrap gap-3">
            {d.esperienze.map((e) => (
              <a
                href={getyourguideUrl(e.query)}
                target="_blank"
                rel="sponsored noopener"
                class="inline-flex items-center gap-2 rounded-full bg-gold-500 px-4 py-2 text-sm font-semibold text-noir-950 hover:bg-gold-400"
              >
                {e.nome} su GetYourGuide →
              </a>
            ))}
          </div>
          <p class="mt-3 text-xs text-ink-500 dark:text-ink-400">
            Link di affiliazione: se prenoti tramite questo link potremmo ricevere una piccola commissione, senza costi aggiuntivi per te.
          </p>
        </section>
      )
    }
    {
      d.tags.length > 0 && (
        <div class="mt-8 flex flex-wrap gap-2">
          {d.tags.map((t) => <span class="rounded-full bg-ink-500/15 px-3 py-1 text-xs">#{t}</span>)}
        </div>
      )
    }
    {
      d.faq.length > 0 && (
        <section class="mt-12">
          <h2 class="font-display text-2xl font-bold">Domande frequenti</h2>
          <div class="mt-4 divide-y divide-ink-500/10 dark:divide-noir-700">
            {d.faq.map((f) => (
              <details class="group py-3">
                <summary class="cursor-pointer list-none font-semibold marker:content-none">
                  <span class="text-gold-600 dark:text-gold-400">▸ </span>{f.domanda}
                </summary>
                <p class="mt-2 text-ink-600 dark:text-ink-300">{f.risposta}</p>
              </details>
            ))}
          </div>
        </section>
      )
    }
    <a href="/guida" class="mt-10 flex flex-col gap-4 rounded-3xl border border-gold-400/30 bg-gold-400/5 p-6 sm:flex-row sm:items-center sm:justify-between">
      <div>
        <p class="font-display text-lg font-bold">📖 Ti serve un itinerario pronto?</p>
        <p class="mt-1 text-sm text-ink-600 dark:text-ink-400">
          La Guida CineFood Italia in PDF: tutti i locali reali con indirizzo, prezzo e 3 itinerari già pronti, {SITE.guida.prezzo}.
        </p>
      </div>
      <span class="inline-block shrink-0 rounded-full bg-gold-500 px-5 py-2 text-sm font-semibold text-noir-950">Scoprila →</span>
    </a>

    <a href="/blog" class="mt-6 inline-block text-sm font-semibold text-gold-600 hover:text-gold-500 dark:text-gold-400">← Torna al blog</a>
  </article>

  {
    correlati.length > 0 && (
      <section class="border-t border-ink-500/10 bg-cream-100 dark:border-noir-800 dark:bg-noir-900">
        <div class="mx-auto max-w-5xl px-4 py-12">
          <h2 class="font-display text-2xl font-bold">Continua a leggere</h2>
          <div class="mt-6 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
            {correlati.map((a) => (
              <a href={`/blog/${a.id}`} class="group flex flex-col overflow-hidden rounded-3xl border border-ink-500/10 bg-white dark:border-noir-700 dark:bg-noir-950">
                {a.data.immagine && (
                  <Image src={a.data.immagine} alt={a.data.immagineAlt || a.data.titolo} width={400} height={225} densities={[1, 2]} loading="lazy" class="aspect-video w-full object-cover transition-transform duration-500 group-hover:scale-105" />
                )}
                <div class="flex flex-1 flex-col p-4">
                  <p class="text-xs text-ink-500 dark:text-ink-400">{formatData(a.data.dataPubblicazione)}</p>
                  <h3 class="mt-1 font-display text-base font-bold leading-tight group-hover:text-gold-600 dark:group-hover:text-gold-400">{a.data.titolo}</h3>
                  <p class="mt-1 line-clamp-2 text-sm text-ink-600 dark:text-ink-400">{a.data.descrizione}</p>
                </div>
              </a>
            ))}
          </div>
        </div>
      </section>
    )
  }
</BaseLayout>
