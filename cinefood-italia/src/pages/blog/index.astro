---
/** Elenco degli articoli del blog. */
import { getCollection } from "astro:content";
import { Image } from "astro:assets";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { formatData } from "../../lib/utils";

// Esclude le bozze e ordina dal più recente.
const articoli = (await getCollection("blog"))
  .filter((a) => !a.data.bozza)
  .sort(
    (a, b) =>
      b.data.dataPubblicazione.getTime() - a.data.dataPubblicazione.getTime()
  );
---

<BaseLayout
  title="Blog"
  description="Articoli, itinerari e curiosità sul cinema e la buona tavola in Italia."
>
  <section class="mx-auto max-w-4xl px-4 py-12">
    <h1 class="text-3xl font-extrabold text-ink-900">Blog</h1>
    <p class="mt-2 text-ink-700">Itinerari, curiosità e storie di cinema e cucina.</p>

    <div class="mt-8 grid gap-8 sm:grid-cols-2">
      {
        articoli.map((a) => (
          <article class="overflow-hidden rounded-2xl border border-ink-100 bg-white shadow-sm">
            {a.data.immagine && (
              <a href={`/blog/${a.id}`}>
                <Image
                  src={a.data.immagine}
                  alt={a.data.immagineAlt || a.data.titolo}
                  width={640}
                  height={360}
                  loading="lazy"
                  class="aspect-video w-full object-cover"
                />
              </a>
            )}
            <div class="p-5">
              <p class="text-xs text-ink-700">{formatData(a.data.dataPubblicazione)}</p>
              <h2 class="mt-1 text-lg font-bold text-ink-900">
                <a href={`/blog/${a.id}`} class="hover:text-brand-600">
                  {a.data.titolo}
                </a>
              </h2>
              <p class="mt-2 line-clamp-3 text-sm text-ink-700">{a.data.descrizione}</p>
              <a href={`/blog/${a.id}`} class="mt-3 inline-block text-sm font-semibold text-brand-600 hover:text-brand-700">
                Leggi l'articolo →
              </a>
            </div>
          </article>
        ))
      }
    </div>

    {articoli.length === 0 && <p class="mt-8 text-ink-700">Nessun articolo pubblicato al momento.</p>}
  </section>
</BaseLayout>
