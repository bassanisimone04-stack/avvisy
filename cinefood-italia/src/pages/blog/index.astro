---
/** Elenco degli articoli del blog. */
import { getCollection } from "astro:content";
import { Image } from "astro:assets";
import BaseLayout from "../../layouts/BaseLayout.astro";
import Reveal from "../../components/Reveal.astro";
import { formatData } from "../../lib/utils";

const articoli = (await getCollection("blog"))
  .filter((a) => !a.data.bozza)
  .sort((a, b) => b.data.dataPubblicazione.getTime() - a.data.dataPubblicazione.getTime());
---

<BaseLayout title="Blog" description="Articoli, itinerari e curiosità sul cinema e la buona tavola in Italia.">
  <section class="mx-auto max-w-4xl px-4 py-12">
    <h1 class="font-display text-4xl font-extrabold">Blog</h1>
    <p class="mt-2 text-ink-600 dark:text-ink-400">Itinerari, curiosità e storie di cinema e cucina.</p>

    <div class="mt-8 grid gap-8 sm:grid-cols-2">
      {
        articoli.map((a, i) => (
          <Reveal delay={i * 60}>
            <article class="overflow-hidden rounded-3xl border border-ink-500/10 bg-white dark:border-noir-700 dark:bg-noir-900">
              {a.data.immagine && (
                <a href={`/blog/${a.id}`}>
                  <Image src={a.data.immagine} alt={a.data.immagineAlt || a.data.titolo} width={640} height={360} loading="lazy" class="aspect-video w-full object-cover" />
                </a>
              )}
              <div class="p-5">
                <p class="text-xs text-ink-500 dark:text-ink-400">{formatData(a.data.dataPubblicazione)}</p>
                <h2 class="mt-1 font-display text-lg font-bold"><a href={`/blog/${a.id}`} class="hover:text-gold-600 dark:hover:text-gold-400">{a.data.titolo}</a></h2>
                <p class="mt-2 line-clamp-3 text-sm text-ink-600 dark:text-ink-400">{a.data.descrizione}</p>
                <a href={`/blog/${a.id}`} class="mt-3 inline-block text-sm font-semibold text-gold-600 hover:text-gold-500 dark:text-gold-400">Leggi l'articolo →</a>
              </div>
            </article>
          </Reveal>
        ))
      }
    </div>
    {articoli.length === 0 && <p class="mt-8 text-ink-500 dark:text-ink-400">Nessun articolo pubblicato al momento.</p>}
  </section>
</BaseLayout>
