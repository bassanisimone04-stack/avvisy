---
/** Pagina di errore 404 (non trovata). */
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Pagina non trovata" description="La pagina che cerchi non esiste.">
  <section class="mx-auto max-w-xl px-4 py-20 text-center">
    <p class="text-6xl">🎬</p>
    <h1 class="mt-4 text-3xl font-extrabold text-ink-900">Ciak, si taglia!</h1>
    <p class="mt-3 text-lg text-ink-800">
      La pagina che stai cercando non esiste o è stata spostata.
    </p>
    <div class="mt-8 flex flex-wrap justify-center gap-3">
      <a href="/" class="rounded-full bg-brand-600 px-6 py-3 text-sm font-semibold text-white hover:bg-brand-700">
        Torna alla home
      </a>
      <a href="/locali" class="rounded-full border border-ink-100 px-6 py-3 text-sm font-semibold text-ink-800 hover:bg-ink-50">
        Sfoglia i locali
      </a>
    </div>
  </section>
</BaseLayout>
