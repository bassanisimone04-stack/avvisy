---
/** Pagina di errore 404 (non trovata). */
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Pagina non trovata" description="La pagina che cerchi non esiste.">
  <section class="mx-auto max-w-xl px-4 py-24 text-center">
    <p class="text-6xl">🎬</p>
    <h1 class="mt-4 font-display text-4xl font-extrabold">Ciak, si taglia!</h1>
    <p class="mt-3 text-lg text-ink-700 dark:text-cream-200">La pagina che cerchi non esiste o è stata spostata.</p>
    <div class="mt-8 flex flex-wrap justify-center gap-3">
      <a href="/" class="rounded-full bg-gold-500 px-6 py-3 text-sm font-semibold text-noir-950 hover:bg-gold-400">Torna alla home</a>
      <a href="/locali" class="rounded-full border border-ink-500/25 px-6 py-3 text-sm font-semibold hover:bg-cream-100 dark:border-noir-600 dark:hover:bg-noir-800">Sfoglia i locali</a>
    </div>
  </section>
</BaseLayout>
