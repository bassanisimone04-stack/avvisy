---
/** Elenco completo dei locali con ricerca e filtri lato client. */
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import LocaleCard from "../../components/LocaleCard.astro";
import FilterBar from "../../components/FilterBar.astro";
import { ordinaLocali, cittaUniche, tipiUnici, filmIdsDiLocale, slugify } from "../../lib/utils";
import { itemListJsonLd } from "../../lib/schema-org";
import { SITE } from "../../config/site";

const locali = ordinaLocali(await getCollection("restaurants"));
const films = await getCollection("films");
const citta = cittaUniche(locali);
const tipi = tipiUnici(locali);
// Solo i film effettivamente collegati ad almeno un locale, per il filtro.
const filmUsati = new Set(locali.flatMap(filmIdsDiLocale));
const filmOpzioni = films
  .filter((f) => filmUsati.has(f.id))
  .map((f) => ({ titolo: f.data.titolo, slug: f.id }))
  .sort((a, b) => a.titolo.localeCompare(b.titolo, "it"));

/** Attributi data-* per il filtro lato client. */
function datiFiltro(locale: (typeof locali)[number]) {
  const testo = [
    locale.data.nome, locale.data.citta, locale.data.regione, locale.data.descrizione,
  ].join(" ").toLowerCase();
  return {
    "data-citta": locale.data.citta,
    "data-tipo": locale.data.tipo,
    "data-categoria": locale.data.categoria,
    "data-prezzo": locale.data.prezzo,
    "data-film": filmIdsDiLocale(locale).join("|"),
    "data-testo": testo,
  };
}
const jsonLd = itemListJsonLd(
  "Tutti i locali",
  locali.map((l) => new URL(`/locale/${l.id}`, SITE.url).href)
);
---

<BaseLayout
  title="Ristoranti e locali dei film in Italia: elenco e mappa"
  description="Cerca e filtra tutti i ristoranti, bar, caffè e trattorie italiani apparsi al cinema e in TV, per città, film, tipo, prezzo e categoria."
  jsonLd={jsonLd}
>
  <section class="mx-auto max-w-6xl px-4 py-10">
    <h1 class="font-display text-4xl font-extrabold">Tutti i locali</h1>
    <p class="mt-2 text-ink-600 dark:text-ink-400">
      Filtra per città, film, tipo, prezzo o categoria (set reale / legato al film / a tema cinema).
    </p>

    <nav class="mt-4 flex flex-wrap items-center gap-2 text-sm" aria-label="Locali per tipo">
      <span class="text-ink-600 dark:text-ink-400">Per tipo:</span>
      {tipi.map((tp) => <a href={`/tipo/${slugify(tp)}`} class="rounded-full border border-ink-200 px-3 py-1 capitalize hover:underline dark:border-ink-700">{tp}</a>)}
    </nav>

    <div class="mt-6">
      <FilterBar citta={citta} tipi={tipi} film={filmOpzioni} />
    </div>

    <div id="griglia-locali" class="mt-8 grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {
        locali.map((locale) => (
          <div class="locale-card" {...datiFiltro(locale)}>
            <LocaleCard locale={locale} heading="h2" />
          </div>
        ))
      }
    </div>

    <p id="nessun-risultato" hidden class="mt-10 text-center text-ink-500 dark:text-ink-400">
      Nessun locale corrisponde ai filtri.
      <button type="button" onclick="document.getElementById('f-reset')?.click()" class="font-semibold text-gold-600 underline dark:text-gold-400">Azzera i filtri</button>
    </p>
  </section>
</BaseLayout>
