---
/** Elenco di tutti i film/serie con locandina e numero di locali. */
import { getCollection } from "astro:content";
import { Image } from "astro:assets";
import BaseLayout from "../../layouts/BaseLayout.astro";
import Reveal from "../../components/Reveal.astro";
import { contaLocaliPerFilm } from "../../lib/utils";
import { itemListJsonLd } from "../../lib/schema-org";
import { SITE } from "../../config/site";

const films = (await getCollection("films")).sort((a, b) =>
  a.data.titolo.localeCompare(b.data.titolo, "it")
);
const locali = await getCollection("restaurants");
const conteggi = contaLocaliPerFilm(locali);
const jsonLd = itemListJsonLd(
  "Film e serie TV",
  films.map((f) => new URL(`/film/${f.id}`, SITE.url).href)
);
---

<BaseLayout
  title="Film e serie TV"
  description="Sfoglia i film e le serie TV girati in Italia e scopri i ristoranti, bar e caffè legati a ciascuna opera, con indirizzo, scena e fonte. Dove mangiare come nei film."
  jsonLd={jsonLd}
>
  <section class="mx-auto max-w-6xl px-4 py-12">
    <h1 class="font-display text-4xl font-extrabold">Film e serie TV</h1>
    <p class="mt-2 text-ink-600 dark:text-ink-400">
      Scegli un titolo e scopri dove mangiare come nel film.
    </p>

    <div class="mt-8 grid grid-cols-2 gap-6 sm:grid-cols-3 lg:grid-cols-4">
      {
        films.map((film, i) => (
          <Reveal delay={i * 50}>
            <a href={`/film/${film.id}`} class="group block">
              <div class="relative flex aspect-[2/3] items-end overflow-hidden rounded-2xl shadow-sm transition-all duration-300 group-hover:-translate-y-1 group-hover:shadow-xl">
                <Image
                  src={film.data.locandina}
                  alt={film.data.locandinaAlt || `Locandina di ${film.data.titolo}`}
                  width={400}
                  height={600}
                  loading="lazy"
                  class="absolute inset-0 h-full w-full object-cover transition-transform duration-500 group-hover:scale-105"
                />
                {film.data.locandinaTipo === "luogo" && (
                  <span class="absolute left-2 top-2 rounded-full bg-black/60 px-2 py-0.5 text-[10px] font-semibold text-white backdrop-blur">Foto del luogo</span>
                )}
                {film.data.locandinaTipo === "illustrativa" && (
                  <span class="absolute left-2 top-2 rounded-full bg-black/60 px-2 py-0.5 text-[10px] font-semibold text-white backdrop-blur">Foto illustrativa</span>
                )}
                {film.data.locandinaTipo === "ai" && (
                  <span class="absolute left-2 top-2 rounded-full bg-black/60 px-2 py-0.5 text-[10px] font-semibold text-white backdrop-blur">Illustrazione AI</span>
                )}
                <div class="absolute inset-0 overlay-bottom"></div>
                <div class="relative w-full p-3">
                  <span class="text-[11px] font-semibold uppercase tracking-wide text-gold-400">
                    {film.data.serieTv ? "Serie TV" : "Film"} · {film.data.anno}
                  </span>
                  <h2 class="font-display text-lg font-bold leading-tight text-white">{film.data.titolo}</h2>
                </div>
              </div>
              <p class="mt-2 text-sm text-ink-600 dark:text-ink-300">
                {conteggi.get(film.id) ?? 0} locali
              </p>
            </a>
          </Reveal>
        ))
      }
    </div>
  </section>
</BaseLayout>
