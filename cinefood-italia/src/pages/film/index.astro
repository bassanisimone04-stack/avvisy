---
/** Elenco di tutti i film/serie con locandina e numero di locali. */
import { getCollection } from "astro:content";
import { Image } from "astro:assets";
import BaseLayout from "../../layouts/BaseLayout.astro";
import Reveal from "../../components/Reveal.astro";
import { contaLocaliPerFilm } from "../../lib/utils";

const films = (await getCollection("films")).sort((a, b) =>
  a.data.titolo.localeCompare(b.data.titolo, "it")
);
const locali = await getCollection("restaurants");
const conteggi = contaLocaliPerFilm(locali);
---

<BaseLayout
  title="Film e serie TV"
  description="Sfoglia i film e le serie TV e scopri i ristoranti, bar e caffè italiani legati a ciascuna opera. Dove mangiare come nei film."
>
  <section class="mx-auto max-w-6xl px-4 py-12">
    <h1 class="font-display text-4xl font-extrabold">Film e serie TV</h1>
    <p class="mt-2 text-ink-600 dark:text-ink-400">
      Scegli un titolo e scopri dove mangiare come nel film.
    </p>

    <div class="mt-8 grid grid-cols-2 gap-6 sm:grid-cols-3 lg:grid-cols-4">
      {
        films.map((film, i) => (
          <Reveal delay={i * 50}>
            <a href={`/film/${film.id}`} class="group block">
              <div class="overflow-hidden rounded-2xl shadow-sm transition-all duration-300 group-hover:-translate-y-1 group-hover:shadow-xl">
                <Image
                  src={film.data.locandina}
                  alt={film.data.locandinaAlt || `Locandina di ${film.data.titolo}`}
                  width={400}
                  height={600}
                  loading="lazy"
                  class="aspect-[2/3] w-full object-cover transition-transform duration-500 group-hover:scale-105"
                />
              </div>
              <h2 class="mt-3 font-display text-lg font-bold leading-tight group-hover:text-gold-600 dark:group-hover:text-gold-400">
                {film.data.titolo}
              </h2>
              <p class="text-sm text-ink-500 dark:text-ink-400">
                {film.data.anno} · {conteggi.get(film.id) ?? 0} locali
              </p>
            </a>
          </Reveal>
        ))
      }
    </div>
  </section>
</BaseLayout>
