---
/** Archivio dei locali apparsi in un singolo film o serie TV. */
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import RestaurantCard from "../../components/RestaurantCard.astro";
import { ordinaLocali, filmUnici, localiPerFilm, slugify } from "../../lib/utils";

export async function getStaticPaths() {
  const locali = await getCollection("restaurants");
  return filmUnici(locali).map((film) => {
    const relativi = ordinaLocali(localiPerFilm(locali, film.slug));
    // Recupera i dati completi del film dalla prima occorrenza.
    const info = relativi[0].data.film.find(
      (f) => slugify(f.titolo) === film.slug
    )!;
    return {
      params: { film: film.slug },
      props: { titolo: film.titolo, info, locali: relativi },
    };
  });
}

const { titolo, info, locali } = Astro.props;
---

<BaseLayout
  title={titolo}
  description={`Tutti i locali italiani apparsi in "${titolo}" (${info.anno}) di ${info.regista}.`}
>
  <section class="mx-auto max-w-6xl px-4 py-10">
    <nav class="mb-3 text-sm text-ink-700">
      <a href="/locali" class="hover:text-brand-600">Locali</a>
      <span aria-hidden="true"> / </span>
      <span class="text-ink-900">{titolo}</span>
    </nav>
    <p class="text-sm font-semibold uppercase tracking-wide text-brand-600">
      {info.serieTv ? "Serie TV" : "Film"} · {info.anno}
    </p>
    <h1 class="mt-1 text-3xl font-extrabold text-ink-900">{titolo}</h1>
    <p class="mt-2 text-ink-700">Regia di {info.regista}</p>
    <p class="mt-4 max-w-2xl text-ink-800">
      {locali.length} {locali.length === 1 ? "locale" : "locali"} nella nostra directory
      {locali.length === 1 ? "appare" : "appaiono"} in quest'opera.
    </p>

    <div class="mt-8 grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {locali.map((locale) => <RestaurantCard locale={locale} />)}
    </div>
  </section>
</BaseLayout>
