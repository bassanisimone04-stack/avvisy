---
/** Pagina di un film/serie: locandina, sinossi, locali collegati, FAQ. */
import { getCollection } from "astro:content";
import { Image } from "astro:assets";
import BaseLayout from "../../layouts/BaseLayout.astro";
import LocaleCard from "../../components/LocaleCard.astro";
import Breadcrumb from "../../components/Breadcrumb.astro";
import Reveal from "../../components/Reveal.astro";
import Icon from "../../components/Icon.astro";
import { SITE } from "../../config/site";
import { ordinaLocali, localiPerFilm, slugify } from "../../lib/utils";
import { faqPageJsonLd, breadcrumbJsonLd } from "../../lib/schema-org";
import { fitTitle, clampDesc } from "../../lib/seo";
import { ITINERARIO_PER_FILM } from "../../lib/itinerari";

export async function getStaticPaths() {
  const films = await getCollection("films");
  const locali = await getCollection("restaurants");
  return films.map((film) => ({
    params: { slug: film.id },
    props: { film, locali: ordinaLocali(localiPerFilm(locali, film.id)) },
  }));
}

const { film, locali } = Astro.props;
const d = film.data;
const cittaFilm = d.citta[0];
const itinerario = ITINERARIO_PER_FILM[film.id];

// SEO (Search Console): "dove è stato girato X" / "X location" + "dove mangiano ne [film]".
const title = fitTitle([
  d.titoloSeo,
  `${d.titolo}: location e dove mangiare`,
  `${d.titolo}: le location vere`,
  `${d.titolo}: le location`,
  d.titolo,
]);
const description = clampDesc(`Dove è stato girato ${d.titolo} (${d.anno})? Le location reali e i ristoranti, bar e caffè legati al film${cittaFilm ? ` a ${cittaFilm}` : ""}.`);

const crumbs = [
  { name: "Home", href: "/" },
  { name: "Film", href: "/film" },
  { name: d.titolo },
];
const jsonLd: Record<string, unknown>[] = [
  breadcrumbJsonLd(
    crumbs.map((c) => ({ name: c.name, url: new URL(c.href ?? "/", SITE.url).href }))
  ),
];
if (d.faq.length > 0) jsonLd.push(faqPageJsonLd(d.faq));
---

<BaseLayout title={title} description={description} image={d.locandina.src} type="article" jsonLd={jsonLd}>
  <!-- Intestazione film -->
  <section class="border-b border-ink-500/10 bg-cream-100 dark:border-noir-800 dark:bg-noir-900">
    <div class="mx-auto grid max-w-5xl gap-8 px-4 py-10 md:grid-cols-[240px_1fr]">
      <figure class="mx-auto w-40 md:w-full">
        <Image
          src={d.locandina}
          alt={d.locandinaAlt || `Locandina di ${d.titolo}`}
          width={480}
          height={720}
          loading="eager"
          class="w-full rounded-2xl object-cover shadow-lg"
        />
        {d.locandinaTipo === "luogo" && (
          <figcaption class="mt-2 text-center text-xs text-ink-500 dark:text-ink-400">Foto di un luogo delle riprese</figcaption>
        )}
      </figure>
      <div>
        <Breadcrumb items={crumbs} />
        <p class="mt-3 text-sm font-semibold uppercase tracking-wide text-gold-600 dark:text-gold-400">
          {d.serieTv ? "Serie TV" : "Film"} · {d.anno}
        </p>
        <h1 class="mt-1 font-display text-4xl font-extrabold sm:text-5xl">{d.titolo}</h1>
        <p class="mt-2 text-ink-500 dark:text-ink-400">Regia di {d.regista}</p>
        <p class="mt-4 text-lg text-ink-700 dark:text-cream-200">{d.sinossi}</p>
        {
          cittaFilm && (
            <a href={`/${slugify(cittaFilm)}`} class="mt-4 inline-flex items-center gap-1.5 text-sm font-semibold text-gold-600 hover:text-gold-500 dark:text-gold-400">
              <Icon name="pin" class="h-4 w-4" /> Altri locali a {cittaFilm} →
            </a>
          )
        }
        {
          itinerario && (
            <a href={`/blog/${itinerario}`} class="mt-5 flex items-center gap-3 rounded-2xl border border-gold-500/30 bg-gold-500/10 p-4 transition-colors hover:bg-gold-500/15">
              <Icon name="film" class="h-6 w-6 shrink-0 text-gold-500" />
              <span class="text-sm">
                <strong class="font-semibold">Leggi l'itinerario</strong> — i luoghi del film e dove mangiare →
              </span>
            </a>
          )
        }
      </div>
    </div>
  </section>

  <!-- Locali collegati -->
  <section class="mx-auto max-w-6xl px-4 py-12">
    <h2 class="font-display text-2xl font-bold">
      {locali.length > 0 ? "Locali legati al film" : "Locali in arrivo"}
    </h2>
    {
      locali.length > 0 ? (
        <div class="mt-6 grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3">
          {locali.map((locale, i) => (
            <Reveal delay={i * 60}>
              <LocaleCard locale={locale} />
            </Reveal>
          ))}
        </div>
      ) : (
        <p class="mt-3 text-ink-500 dark:text-ink-400">
          Non abbiamo ancora schede per questo film.{" "}
          <a href="/aggiungi-locale" class="font-semibold text-gold-600 dark:text-gold-400">Conosci un locale? Segnalalo →</a>
        </p>
      )
    }
  </section>

  <!-- FAQ -->
  {
    d.faq.length > 0 && (
      <section class="mx-auto max-w-3xl px-4 pb-16">
        <h2 class="font-display text-2xl font-bold">Domande frequenti</h2>
        <div class="mt-6 space-y-3">
          {d.faq.map((f) => (
            <details class="group rounded-2xl border border-ink-500/10 bg-white p-5 dark:border-noir-700 dark:bg-noir-900">
              <summary class="cursor-pointer list-none font-semibold marker:hidden">
                <span class="flex items-center justify-between gap-3">
                  {f.domanda}
                  <span class="text-gold-500 transition-transform group-open:rotate-45" aria-hidden="true">+</span>
                </span>
              </summary>
              <p class="mt-3 text-ink-700 dark:text-cream-200">{f.risposta}</p>
            </details>
          ))}
        </div>
      </section>
    )
  }
</BaseLayout>
