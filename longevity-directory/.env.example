# Copia questo file in .env e compila i valori che vuoi attivare.
# Nessuna di queste variabili è obbligatoria: senza, il sito funziona
# comunque (form, autenticazione e dashboard sono già operativi con SQLite),
# semplicemente restano spenti il pannello admin e i pagamenti.

# Percorso del database SQLite. Di default ./data/app.db (creato al primo avvio).
# DATABASE_PATH=./data/app.db

# Password del pannello interno (/admin). Senza questa variabile /admin
# resta disabilitato e lo dichiara esplicitamente, invece di finger di
# funzionare con una password di default insicura.
# ADMIN_PASSWORD=

# Stripe — servono le tue chiavi, non posso fornirtene di funzionanti:
# 1) crea un account su https://dashboard.stripe.com (anche solo in test mode)
# 2) Developers → API keys → copia la chiave segreta (sk_test_...)
# 3) Product catalog → crea un prodotto ricorrente per ciascun piano
#    (Verificato, Premium, Esclusiva) e copia il Price ID di ciascuno (price_...)
# Senza queste variabili i pulsanti dei piani a pagamento mostrano
# onestamente "pagamenti in fase di configurazione", non un checkout finto.
# STRIPE_SECRET_KEY=
# STRIPE_PRICE_VERIFICATO=
# STRIPE_PRICE_PREMIUM=
# STRIPE_PRICE_ESCLUSIVA=
