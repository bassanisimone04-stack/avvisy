---
// Pagina dinamica (SSR): legge il cookie di sessione a ogni richiesta.
import { actions } from "astro:actions";
import BaseLayout from "../layouts/BaseLayout.astro";
import { SESSION_COOKIE, getUserFromSession } from "../lib/auth";

// Già loggato? Vai direttamente alla dashboard.
const existing = getUserFromSession(Astro.cookies.get(SESSION_COOKIE)?.value);
if (existing) return Astro.redirect("/account");

const result = Astro.getActionResult(actions.login);
if (result && !result.error) return Astro.redirect("/account");
---

<BaseLayout title="Accedi" description="Accedi all'area riservata della tua struttura." noindex bareTop>
  <div class="mx-auto flex min-h-[80vh] max-w-[420px] flex-col justify-center px-6 pt-[100px]">
    <span class="text-[10.5px] font-bold uppercase tracking-[.18em]" style="color:var(--muted)">Per le strutture</span>
    <h1 class="font-display mt-2.5 mb-7 text-[2.2rem]">Accedi</h1>

    {result?.error && (
      <p class="mb-4 rounded-[var(--r)] border px-4 py-3 text-[13.5px]" style="border-color:#e2685c;background:color-mix(in srgb,#e2685c 10%,transparent);color:#e2685c">
        {result.error.message}
      </p>
    )}

    <form method="POST" action={actions.login} class="space-y-4 rounded-[var(--r-lg)] border p-6" style="border-color:var(--line);background:var(--surface)">
      <div>
        <label for="email" class="mb-1.5 block text-[12.5px] font-semibold">Email</label>
        <input id="email" name="email" type="email" required class="w-full rounded-[var(--r)] border px-3.5 py-2.5 text-[14px]" style="border-color:var(--line);background:var(--surface-2)" />
      </div>
      <div>
        <label for="password" class="mb-1.5 block text-[12.5px] font-semibold">Password</label>
        <input id="password" name="password" type="password" required class="w-full rounded-[var(--r)] border px-3.5 py-2.5 text-[14px]" style="border-color:var(--line);background:var(--surface-2)" />
      </div>
      <button type="submit" class="w-full rounded-full py-3 text-[14px] font-semibold" style="background:var(--ink);color:var(--bg)">
        Accedi
      </button>
    </form>

    <p class="mt-5 text-center text-[13px]" style="color:var(--muted)">
      Non hai ancora una scheda? <a href="/per-i-centri/registrazione" class="underline" style="color:var(--color-iris)">Registra la tua struttura</a>
    </p>
  </div>
</BaseLayout>
