---
import { SITE } from "../lib/site";
import { CATEGORIES } from "../lib/taxonomy";
---

<footer class="border-t" style="border-color:var(--line);background:var(--surface-2)">
  <div class="mx-auto max-w-[1200px] px-6 py-16">
    <div class="grid gap-10 sm:grid-cols-2 lg:grid-cols-4">
      <div>
        <p class="font-display text-xl">{SITE.name}</p>
        <p class="mt-3 max-w-[32ch] text-[13.5px]" style="color:var(--muted)">{SITE.tagline}.</p>
      </div>
      <div>
        <p class="text-[11px] font-bold tracking-[.14em]" style="color:var(--muted)">DIRECTORY</p>
        <ul class="mt-3 space-y-2 text-[13.5px]">
          {
            CATEGORIES.slice(0, 6).map((c) => (
              <li>
                <a href={`/directory/${c.slug}`} class="hover:underline" style="color:var(--ink-soft)">
                  {c.shortLabel}
                </a>
              </li>
            ))
          }
          <li>
            <a href="/directory" class="font-semibold hover:underline" style="color:var(--ink)">
              Tutte le discipline →
            </a>
          </li>
        </ul>
      </div>
      <div>
        <p class="text-[11px] font-bold tracking-[.14em]" style="color:var(--muted)">PROGETTO</p>
        <ul class="mt-3 space-y-2 text-[13.5px]" style="color:var(--ink-soft)">
          <li><a href="/chi-siamo" class="hover:underline">Chi siamo</a></li>
          <li><a href="/blog" class="hover:underline">Blog</a></li>
          <li><a href="/contatti" class="hover:underline">Contatti</a></li>
          <li><a href="/disclaimer-medico" class="hover:underline">Disclaimer medico</a></li>
        </ul>
      </div>
      <div>
        <p class="text-[11px] font-bold tracking-[.14em]" style="color:var(--muted)">PER LE STRUTTURE</p>
        <ul class="mt-3 space-y-2 text-[13.5px]" style="color:var(--ink-soft)">
          <li><a href="/per-i-centri" class="hover:underline">Aggiungi struttura</a></li>
          <li><a href="/per-i-centri#piani" class="hover:underline">Piani e prezzi</a></li>
          <li><a href="/contatti" class="hover:underline">Rivendica scheda</a></li>
        </ul>
      </div>
    </div>

    <div
      class="mt-14 flex flex-col gap-3 border-t pt-6 text-[12px] sm:flex-row sm:items-center sm:justify-between"
      style="border-color:var(--line);color:var(--muted)"
    >
      <p>© {new Date().getFullYear()} {SITE.name} · Prototipo dimostrativo, dati fittizi.</p>
      <div class="flex gap-5">
        <a href="/privacy" class="hover:underline">Privacy</a>
        <a href="/cookie" class="hover:underline">Cookie</a>
        <a href="/termini" class="hover:underline">Termini</a>
      </div>
    </div>
  </div>
</footer>
