---
/**
 * Box "In sintesi" a inizio articolo — doc 02 §4.1: "Key takeaways: 3–5 punti
 * in box a inizio articolo (componente KeyTakeaways)".
 */
interface Props {
  items: string[];
}
const { items } = Astro.props;
---

<div class="my-8 rounded-[var(--r-lg)] border p-5" style="border-color:var(--line);background:var(--surface-2)">
  <span class="text-[10.5px] font-bold uppercase tracking-[.16em]" style="color:var(--color-iris)">In sintesi</span>
  <ul class="mt-3 space-y-2 text-[14.5px]" style="color:var(--ink-soft)">
    {items.map((it) => (
      <li class="flex gap-2.5">
        <span class="mt-[7px] h-[5px] w-[5px] shrink-0 rounded-full" style="background:var(--color-iris)"></span>
        <span>{it}</span>
      </li>
    ))}
  </ul>
</div>
