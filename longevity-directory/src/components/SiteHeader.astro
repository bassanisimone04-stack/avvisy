---
import Logo from "./Logo.astro";
import ThemeToggle from "./ThemeToggle.astro";

const path = Astro.url.pathname;
const isOn = (p: string) => (p === "/" ? path === "/" : path.startsWith(p));

const links = [
  { href: "/", label: "Home" },
  { href: "/directory", label: "Directory" },
  { href: "/blog", label: "Blog" },
  { href: "/guide", label: "Guide" },
  { href: "/chi-siamo", label: "Chi siamo" },
  { href: "/contatti", label: "Contatti" },
];
---

<nav class="fixed inset-x-0 top-3.5 z-50 flex justify-center px-4">
  <div
    class="flex w-full max-w-[1200px] items-center gap-2.5 rounded-full border py-2 pl-5 pr-2 backdrop-blur-2xl backdrop-saturate-150"
    style={`background:var(--glass-2);border-color:var(--brd);box-shadow:var(--sh-s)`}
  >
    <Logo />

    <div class="ml-2 hidden gap-0.5 overflow-x-auto md:flex" style="scrollbar-width:none">
      {
        links.map((l) => (
          <a
            href={l.href}
            class="rounded-full px-3.5 py-2 text-[13.5px] font-medium transition-colors"
            style={isOn(l.href) ? "color:var(--ink);background:var(--surface);box-shadow:var(--sh-s);font-weight:600" : "color:var(--muted)"}
          >
            {l.label}
          </a>
        ))
      }
    </div>

    <div class="ml-auto flex items-center gap-2">
      <ThemeToggle />
      <a
        href="/per-i-centri"
        class="hidden rounded-full px-4 py-2.5 text-[13px] font-semibold transition-transform hover:-translate-y-0.5 sm:inline-flex"
        style="background:var(--glass);border:1px solid var(--brd)"
      >
        Sei una struttura?
      </a>
      <a
        href="/per-i-centri/registrazione"
        class="inline-flex items-center gap-2 rounded-full px-4 py-2.5 text-[13px] font-semibold text-white transition-transform hover:-translate-y-0.5"
        style="background:var(--ink);color:var(--bg);box-shadow:0 12px 26px -14px rgba(11,16,32,.8)"
      >
        Aggiungi struttura
      </a>
    </div>
  </div>
</nav>

<!-- barra mobile delle voci (sotto la pillola principale, solo <768px) -->
<div class="fixed inset-x-0 top-[74px] z-40 flex justify-center px-4 md:hidden">
  <div
    class="flex w-full max-w-[1200px] gap-1 overflow-x-auto rounded-full border px-2 py-1.5 backdrop-blur-xl"
    style="background:var(--glass-2);border-color:var(--brd);scrollbar-width:none"
  >
    {
      links.map((l) => (
        <a
          href={l.href}
          class="shrink-0 rounded-full px-3.5 py-2 text-[12.5px] font-medium"
          style={isOn(l.href) ? "color:var(--ink);background:var(--surface);font-weight:600" : "color:var(--muted)"}
        >
          {l.label}
        </a>
      ))
    }
  </div>
</div>
