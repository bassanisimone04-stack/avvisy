---
/**
 * Griglia delle 9 discipline. Deliberatamente uniforme (non un bento con
 * riquadri di dimensioni miste): una prima versione con `col-span`/`row-span`
 * misti produceva un bug di auto-placement in CSS Grid — alcuni riquadri si
 * sovrapponevano e altri non venivano mai posizionati nel flusso visibile
 * (verificato con screenshot reali, non solo a occhio). Una griglia regolare
 * è più robusta e resta fedele al design system.
 */
import { CATEGORIES } from "../lib/taxonomy";
---

<div class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3">
  {
    CATEGORIES.map((c) => (
      <a
        href={`/directory/${c.slug}`}
        class="group relative flex min-h-[190px] flex-col justify-end overflow-hidden rounded-[var(--r-lg)] border p-[18px] text-left transition-transform hover:-translate-y-1"
        style="border-color:var(--line);background:var(--surface);box-shadow:var(--sh-s)"
      >
        <span class={`cv ${c.cover} absolute inset-0 z-0 block transition-transform duration-700 group-hover:scale-105`} />
        <span
          class="absolute inset-0 z-[1]"
          style="background:linear-gradient(180deg,transparent 20%,color-mix(in srgb,var(--surface) 86%,transparent) 68%,var(--surface) 100%)"
        />
        <span
          class="absolute left-[15px] top-[15px] z-[2] rounded-full border px-2.5 py-1 text-[9.5px] font-bold uppercase tracking-[.14em] backdrop-blur-md"
          style="background:var(--glass-2);border-color:var(--brd);color:var(--ink-soft)"
        >
          Disciplina
        </span>
        <span
          class="absolute right-3.5 top-3.5 z-[2] text-[15px] opacity-0 transition-all duration-300 group-hover:opacity-100"
          style="color:var(--color-iris)"
          aria-hidden="true"
        >
          ↗
        </span>
        <span class="font-display relative z-[2] text-[1.3rem]">{c.shortLabel}</span>
        <span class="relative z-[2] mt-1.5 text-[12.5px]" style="color:var(--ink-soft)">
          {c.description}
        </span>
      </a>
    ))
  }
</div>
