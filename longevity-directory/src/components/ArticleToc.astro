---
/**
 * Indice laterale con scrollspy: evidenzia la sezione attiva mentre si
 * scorre l'articolo. Usato sia da blog/[slug] sia da guide/[slug].
 */
interface Props {
  toc: { slug: string; text: string }[];
  label?: string;
}
const { toc, label = "In questo articolo" } = Astro.props;
---

{toc.length > 0 && (
  <div class="sticky top-[96px]">
    <span class="text-[10.5px] font-bold uppercase tracking-[.16em]" style="color:var(--muted)">{label}</span>
    <nav class="mt-3 space-y-0.5 text-[13px]" style="color:var(--ink-soft)">
      {toc.map((h) => (
        <a href={`#${h.slug}`} data-toc-target={h.slug} class="toc-link block rounded-r-md py-1.5 pl-3">{h.text}</a>
      ))}
    </nav>
  </div>
)}

<style>
  .toc-link {
    border-left: 2px solid transparent;
    transition:
      color 0.15s ease,
      border-color 0.15s ease,
      background-color 0.15s ease;
  }
  .toc-link:hover {
    color: var(--ink);
    background: var(--surface-2);
  }
  .toc-link.active {
    color: var(--color-iris);
    border-left-color: var(--color-iris);
    font-weight: 600;
  }
</style>

<script>
  const links = document.querySelectorAll<HTMLAnchorElement>("[data-toc-target]");
  if (links.length && "IntersectionObserver" in window) {
    const byId = new Map<string, HTMLAnchorElement>();
    links.forEach((l) => {
      const id = l.dataset.tocTarget;
      if (id) byId.set(id, l);
    });
    const headings = [...byId.keys()].map((id) => document.getElementById(id)).filter((n): n is HTMLElement => !!n);
    const setActive = (id: string) => {
      links.forEach((l) => l.classList.toggle("active", l.dataset.tocTarget === id));
    };
    const io = new IntersectionObserver(
      (entries) => {
        const visible = entries.filter((e) => e.isIntersecting);
        if (visible.length) setActive(visible[0].target.id);
      },
      { rootMargin: "-110px 0px -75% 0px", threshold: 0 },
    );
    headings.forEach((h) => io.observe(h));
  }
</script>
