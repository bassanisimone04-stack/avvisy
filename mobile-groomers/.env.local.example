# ---------------------------------------------------------------------------
# FindMobileGrooming — configuration
# ---------------------------------------------------------------------------
# Copy this file to ".env.local" and fill in your own keys.
# Without these variables the app runs in DEMO MODE: listings come from
# src/data/groomers.json, and accounts, leads and billing are disabled.
# Nothing breaks — the whole public site still works.
# ---------------------------------------------------------------------------

# --- Supabase (database + auth) --------------------------------------------
# Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...your-anon-key...

# Server-only. Used by the Stripe webhook, which has no user session and so
# cannot pass RLS. Never expose this in the browser.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...your-service-role-key...

# --- Stripe (subscriptions) ------------------------------------------------
# Dashboard → Developers → API keys
STRIPE_SECRET_KEY=sk_test_...
# Dashboard → Developers → Webhooks → your endpoint → Signing secret
STRIPE_WEBHOOK_SECRET=whsec_...
# Price IDs for the recurring plans (Products → your product → Pricing)
STRIPE_PRICE_PRO=price_...
STRIPE_PRICE_FLEET=price_...

# --- Resend (lead forwarding by email) -------------------------------------
# https://resend.com → API Keys. Without these, leads are still stored, they
# just are not emailed to the groomer.
RESEND_API_KEY=re_...
# Must be an address on a domain you verified in Resend.
LEAD_FROM_EMAIL=leads@findmobilegrooming.com

# --- Misc ------------------------------------------------------------------
# Salt for hashing submitter IPs on lead rate-limiting. Any long random string.
LEAD_HASH_SALT=change-me-to-a-long-random-string
