{
  "$comment": [
    "READY-TO-USE TEMPLATE — WebSite (with sitelinks search box) + Organization.",
    "Put both on the homepage only; every other page references them by @id.",
    "Delete this $comment key before shipping."
  ],

  "@graph": [
    {
      "@context": "https://schema.org",
      "@type": "WebSite",
      "@id": "https://www.example.com/#website",
      "url": "https://www.example.com/",
      "name": "SITE NAME",
      "description": "Directory of greenhouse, glasshouse and conservatory wedding venues.",
      "inLanguage": "en-US",
      "publisher": { "@id": "https://www.example.com/#organization" },
      "potentialAction": {
        "@type": "SearchAction",
        "target": {
          "@type": "EntryPoint",
          "urlTemplate": "https://www.example.com/venues/?q={search_term_string}"
        },
        "query-input": "required name=search_term_string"
      }
    },
    {
      "@context": "https://schema.org",
      "@type": "Organization",
      "@id": "https://www.example.com/#organization",
      "name": "SITE NAME",
      "url": "https://www.example.com/",
      "logo": {
        "@type": "ImageObject",
        "url": "https://www.example.com/assets/img/brand/logo.png",
        "width": 512,
        "height": 512
      },
      "description": "Independent editorial directory of greenhouse and conservatory wedding venues.",
      "areaServed": [
        { "@type": "Country", "name": "United States" },
        { "@type": "Country", "name": "Italy" }
      ],
      "sameAs": [
        "https://www.instagram.com/YOUR_HANDLE",
        "https://www.pinterest.com/YOUR_HANDLE"
      ]
    }
  ]
}
