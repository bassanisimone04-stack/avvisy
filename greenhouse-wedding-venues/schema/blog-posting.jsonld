{
  "$comment": [
    "READY-TO-USE TEMPLATE — BlogPosting for a long-form guide.",
    "Replace every ALL_CAPS placeholder and delete this $comment key before shipping.",
    "Pair it with the BreadcrumbList and (where the page has a visible FAQ) FAQPage",
    "templates in this folder. Google requires dateModified to be truthful — update it",
    "only when the content materially changes.",
    "Validate at https://search.google.com/test/rich-results"
  ],

  "@context": "https://schema.org",
  "@type": "BlogPosting",
  "@id": "https://www.example.com/blog/POST_SLUG/#article",
  "isPartOf": { "@id": "https://www.example.com/#website" },
  "mainEntityOfPage": { "@type": "WebPage", "@id": "https://www.example.com/blog/POST_SLUG/" },
  "url": "https://www.example.com/blog/POST_SLUG/",

  "headline": "HEADLINE — keep under 110 characters",
  "alternativeHeadline": "Secondary framing of the same promise",
  "description": "The meta description, verbatim. 140–160 characters.",

  "image": {
    "@type": "ImageObject",
    "url": "https://www.example.com/assets/img/blog/POST_SLUG-hero.jpg",
    "width": 1600,
    "height": 900,
    "caption": "Descriptive caption that repeats the primary keyword naturally"
  },

  "datePublished": "2026-01-14T08:00:00-05:00",
  "dateModified": "2026-09-02T11:20:00-04:00",

  "author": {
    "@type": "Person",
    "name": "AUTHOR NAME",
    "jobTitle": "Editor",
    "url": "https://www.example.com/authors/AUTHOR_SLUG/",
    "knowsAbout": ["wedding venues", "glasshouse architecture", "event budgeting"]
  },

  "publisher": { "@id": "https://www.example.com/#organization" },

  "inLanguage": "en-US",
  "articleSection": "Costs",
  "keywords": [
    "greenhouse wedding cost",
    "glasshouse wedding venue prices",
    "conservatory wedding venues"
  ],
  "wordCount": 2180,
  "timeRequired": "PT14M",

  "about": [
    { "@type": "Thing", "name": "Greenhouse wedding venues" },
    { "@type": "Thing", "name": "Wedding budgeting" }
  ],

  "mentions": [
    {
      "@type": "EventVenue",
      "name": "VENUE NAME MENTIONED IN THE ARTICLE",
      "url": "https://www.example.com/venues/STATE_SLUG/VENUE_SLUG/"
    }
  ],

  "speakable": {
    "@type": "SpeakableSpecification",
    "cssSelector": ["#headline-number", "[data-key-takeaways]"]
  }
}
