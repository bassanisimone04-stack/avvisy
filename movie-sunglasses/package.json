{
  "name": "movie-sunglasses",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "admin:hash": "node scripts/hash-password.mjs",
    "admin:secret": "node -e \"console.log(require('crypto').randomBytes(32).toString('hex'))\"",
