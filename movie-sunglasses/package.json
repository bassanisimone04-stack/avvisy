    "e2e": "node tests/e2e/site-and-admin.cjs && node tests/e2e/interactions.cjs && node tests/e2e/lazy-extras.cjs"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.1.0",
    "@fontsource/cormorant-garamond": "^5.1.0",
