# --- Sito -------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Mostra l'avviso "in attesa di revisione editoriale" sui contenuti non revisionati (metti false in produzione dopo la revisione)
NEXT_PUBLIC_SHOW_UNREVIEWED_NOTICE=true

# --- Admin (obbligatorio per usare /admin) -----------------------------
# Genera con: npm run admin:secret
SESSION_SECRET=
ADMIN_EMAIL=admin@example.com
# Genera con: npm run admin:hash -- "la-tua-password"
ADMIN_PASSWORD_HASH=
# SOLO sviluppo locale (ignorato in produzione):
ADMIN_PASSWORD=

# --- Database (opzionale: senza queste variabili si usa .data/store.json) ---
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- AI per le bozze (opzionale) ---------------------------------------
# AI_PROVIDER = anthropic | openai  (openai = qualsiasi API compatibile /v1/chat/completions)
AI_PROVIDER=anthropic
AI_API_KEY=
AI_MODEL=claude-sonnet-5-5
AI_BASE_URL=

# --- Analytics / consenso (opzionale) ---------------------------------
# Se impostato, lo script GA4 viene caricato SOLO dopo il consenso
NEXT_PUBLIC_GA_ID=
