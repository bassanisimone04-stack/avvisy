# ─────────────────────────────────────────────────────────────────────────────
# Environment variables — PLACEHOLDERS ONLY. Never commit real values.
# Copy to .env.local for local development. On Vercel, set them per
# environment (Development / Preview / Production).
# ─────────────────────────────────────────────────────────────────────────────

# Brand & site (brand name and domain are not decided yet)
NEXT_PUBLIC_BRAND_NAME=YourBrand
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Indexing: keep "false" everywhere except the approved production domain.
NEXT_PUBLIC_ALLOW_INDEXING=false
# Demo mode shows the demo banner and demo labels. Set "false" only with real data.
NEXT_PUBLIC_DEMO_MODE=true

# Maps (Phase 3) — style URL from a licensed provider, e.g. MapTiler.
# Leave empty to use the offline demo basemap.
NEXT_PUBLIC_MAP_STYLE_URL=

# ─── Not used yet — planned (do not fill until the phase starts) ─────────────
# Phase 2 — Supabase
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=        # server only, never exposed to the browser

# Phase 3 — Geocoding (server only)
# GEOCODING_API_KEY=

# Phase 4 — Stripe (TEST MODE keys only during development)
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...

# Phase 5 — Email & analytics
# RESEND_API_KEY=
# NEXT_PUBLIC_POSTHOG_KEY=
# NEXT_PUBLIC_POSTHOG_HOST=

# Local E2E only: path to a preinstalled Chromium (optional)
# PLAYWRIGHT_CHROMIUM_PATH=
