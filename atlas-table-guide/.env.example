# ─── Atlas Table Guide — environment variables ───────────────────────────────
# Copy to .env.local. Every integration is OPTIONAL: when a value is missing the site shows an
# honest "not configured" state instead of failing. NEVER prefix a secret with NEXT_PUBLIC_.

# Public origin used in canonicals, sitemaps, JSON-LD and emails (no trailing slash)
NEXT_PUBLIC_SITE_URL=https://example-guide.com

# Demo data: bundled fictional records (is_demo=true). Set to false in production to hide them.
ALLOW_DEMO_DATA=true

# Quality thresholds
PRICE_INDEX_MIN_SAMPLE=5        # min verified prices before a Price Index figure is shown
DESTINATION_MIN_VERIFIED=5      # min verified restaurants before a destination hub is indexable
FACET_MIN_RESULTS=3             # min results for whitelisted city+cuisine facets / collections to be indexable
STALE_AFTER_DAYS=180            # verified records older than this show "Needs re-verification"
MIN_REVIEWS_FOR_RATING=10       # first-party reviews needed before aggregateRating is emitted

# Crawl policy for AI crawlers: allow-all | search-only | block-all
AI_CRAWLERS_POLICY=search-only

# ─── Supabase (Postgres + Auth + Storage) ────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=          # server only: form inserts, admin, affiliate click log, GDPR deletion

# ─── Maps (MapLibre style URL; default OpenFreeMap needs no key) ─────────────
NEXT_PUBLIC_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/liberty

# ─── Search (optional Typesense; falls back to built-in search / Postgres FTS) ─
TYPESENSE_HOST=                     # e.g. xyz.a1.typesense.net (no scheme)
TYPESENSE_API_KEY=                  # search-only key for the app; use an admin key for `npm run search:sync`
TYPESENSE_PROTOCOL=                 # optional: http | https (default https; http for localhost)
TYPESENSE_PORT=                     # optional

# ─── FX rates: frankfurter (ECB, no key) | none ──────────────────────────────
FX_PROVIDER=frankfurter

# ─── Payments (Stripe TEST MODE only until merchant agreements exist) ────────
STRIPE_SECRET_KEY=                  # must start with sk_test_
STRIPE_WEBHOOK_SECRET=

# ─── Email (Resend) ──────────────────────────────────────────────────────────
RESEND_API_KEY=
EMAIL_FROM="Atlas Table <hello@example-guide.com>"

# ─── AI concierge (OpenAI-compatible, server side only) ──────────────────────
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# ─── Analytics (loaded ONLY after consent) ───────────────────────────────────
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=

# ─── Scheduled jobs (Vercel Cron sends this as "Authorization: Bearer …") ───
CRON_SECRET=

# ─── Security ────────────────────────────────────────────────────────────────
IP_HASH_SALT=change-me              # salts hashed IPs in affiliate click logs
ADMIN_DEV_TOKEN=                    # DEVELOPMENT ONLY (≥16 chars): enables /admin without Supabase Auth; ignored in production
