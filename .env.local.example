# Avvisy — variabili d'ambiente
# Copia questo file in `.env.local` e incolla i valori del tuo progetto Supabase.
# (Supabase: Project Settings → API)

# URL del progetto, es. https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Chiave "anon public" — è pubblica, può stare nel frontend (protetta dalle RLS).
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Chiave "service_role" — SEGRETA, solo lato server. Usata dal webhook Stripe
# per aggiornare lo stato abbonamento bypassando le RLS. Non esporla mai al client.
SUPABASE_SERVICE_ROLE_KEY=

# ---- Stripe (fatturazione abbonamenti) ----
# Se lasci queste variabili vuote, i pulsanti "Abbonati" restano inattivi
# e il resto dell'app funziona comunque.
# (Stripe: Developers → API keys)

# Chiave segreta, es. sk_test_... (in produzione sk_live_...)
STRIPE_SECRET_KEY=

# Price ID dei due piani. Crea due prodotti ricorrenti in Stripe
# (Products → prezzo mensile) e incolla qui i loro ID price_...
STRIPE_PRICE_PRO=
STRIPE_PRICE_MULTI=

# Segreto di firma del webhook, es. whsec_...
# (Stripe: Developers → Webhooks → endpoint → Signing secret;
#  in locale lo ottieni con `stripe listen`)
STRIPE_WEBHOOK_SECRET=
