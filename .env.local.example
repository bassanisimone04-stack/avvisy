# ---------------------------------------------------------------------------
# Scortvia — configurazione Supabase
# ---------------------------------------------------------------------------
# Copia questo file in ".env.local" e incolla le chiavi del TUO progetto
# Supabase (Dashboard → Project Settings → API).
# Senza queste variabili l'app resta in "modalità demo" (dati finti locali).
# ---------------------------------------------------------------------------

# Obbligatorie (lato client e server)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...la-tua-anon-key...

# Facoltativa: serve SOLO per lo script di seed lato server (non esporla mai
# nel browser). Dashboard → Project Settings → API → service_role.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...la-tua-service-role-key...
